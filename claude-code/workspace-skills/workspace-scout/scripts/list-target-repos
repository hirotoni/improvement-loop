#!/usr/bin/env bash
# workspace-scout が対象とする、improvement-scout に opt-in 済みのリポジトリを列挙する
# 薄いラッパー。実体は bin/lib/list_opted_in_repos.sh の list_opted_in_repos() で、
# ここは skill_marker_name を "improvement-scout" に固定して呼ぶだけである。
#
# 使い方: list-target-repos [ワークスペースディレクトリ]
# 省略時はカレントディレクトリを対象とする。
#
# 出力: opt-in 済みリポジトリの絶対パスを1行1件、ソート済みで標準出力に書く。
# 該当が0件でも exit 0（何も出力しない）。

set -euo pipefail

_bootstrap_resolve_own_path() {
  if command -v realpath >/dev/null 2>&1; then
    realpath "$1"
  elif readlink -f "$1" >/dev/null 2>&1; then
    readlink -f "$1"
  else
    local dir base
    dir="$(cd "$(dirname "$1")" && pwd -P)"
    base="$(basename "$1")"
    printf '%s/%s\n' "$dir" "$base"
  fi
}

SCRIPT_SOURCE="$(_bootstrap_resolve_own_path "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_SOURCE")" && pwd)"
# `.claude/skills/workspace-scout` シンボリックリンク経由で実行されるため、BASH_SOURCE を
# そのまま使えない。上で解決した実パスから配布元リポジトリのルートを求める
# （SCRIPT_DIR は <配布元>/claude-code/workspace-skills/workspace-scout/scripts。4階層上がルート）。
REPO_ROOT="$(cd "$SCRIPT_DIR/../../../.." && pwd)"

# shellcheck source=../../../../bin/lib/list_opted_in_repos.sh
source "$REPO_ROOT/bin/lib/list_opted_in_repos.sh"

WORKSPACE_DIR="${1:-$(pwd)}"

list_opted_in_repos "$WORKSPACE_DIR" "improvement-scout"
