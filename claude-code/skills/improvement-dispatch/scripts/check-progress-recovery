#!/usr/bin/env bash
# claude-code/skills/improvement-dispatch/scripts/check-progress-recovery
#
# improvement-dispatch 手順2-3（In Progress タスクの引き渡し先が失われたと
# 確定した後の復旧診断）を決定論的に行う。以前はこの分岐を SKILL.md の散文
# （notes/plan を読む、git worktree list でワークツリーの有無を確認する、
# 無ければブランチの有無を確認する、到達点から「実装が途中まで進んでいる」
# かどうかを判断する、という一連の手順）として書いており、dispatch（AI）が
# 起動のたびにこれを読み取って git コマンドを組み立てて実行していた。
#
# 使い方:
#   .claude/skills/improvement-dispatch/scripts/check-progress-recovery \
#     <worktree_path> <branch> <base_branch>
#
# 引数:
#   worktree_path  復旧対象のワークツリーの絶対パス（notes に記録されている
#                  WORKTREE_DIR）。ディレクトリが存在しない、または
#                  git worktree として登録されていない場合も許容する
#                  （その事実自体を診断結果に含める）。
#   branch         復旧対象の作業ブランチ名（例: improvement/task-21-...）。
#                  存在しない場合も許容する。
#   base_branch    比較対象のベースブランチ（例: main。デフォルトブランチ）。
#                  このコミットにこのリポジトリで解決できる必要がある。
#
# 呼び出し元のカレントディレクトリ（の属する git リポジトリ）をメインの
# 作業木として扱う。git worktree list・show-ref・rev-list はすべてこの
# リポジトリに対して行う。対象ワークツリーの中には立ち入らない
# （worktree_path はパスの比較にのみ使う）。
#
# 判定するもの（すべて機械的に判定できる分岐のみ）:
#   1. worktree_path が git worktree として実際に登録されているか
#      （git worktree list --porcelain の worktree 行との一致。単なる
#      ディレクトリの残骸は「存在しない」扱いにする）。
#   2. branch が存在するか（refs/heads/<branch>）。
#   3. branch に base_branch から見て新しいコミットがあるか
#      （git rev-list --count <base_branch>..<branch> が 0 より大きいか）。
#   4. （TASK-41）worktree_path が git worktree として登録されている場合、
#      その直下の占有記録（.worktree-occupancy。TASK-40 で create-worktree
#      が書き込む KEY=VALUE 形式のファイル）を読み、鮮度を判定する。
#      ASSIGNED_AT_EPOCH（数値の UNIX 秒。ISO8601 文字列は GNU/BSD date の
#      解釈差があるため使わない）だけを grep+sed で取り出す（ファイル全体を
#      source しない。外部が書いたファイルを任意のシェルコードとして
#      実行しないため）。現在時刻との差が 1800 秒（30分）未満なら「新しい」
#      と判定する。1800秒という値は、この復旧診断を呼び出す
#      improvement-dispatch/SKILL.md 手順2の30分ルール（起動間隔が概ね
#      20〜30分であることを根拠にした閾値）と揃えたものである。
#      ファイルが無い、または ASSIGNED_AT_EPOCH が読めない/数値でない場合は
#      「占有記録なし」として扱い、既存のコミット履歴ベースの判定に
#      フォールバックする（後方互換。TASK-40 導入前に作られたワークツリー
#      など）。worktree_path がワークツリーとして登録されていない場合は
#      占有記録を読まない（ワークツリー自体を「存在しない」扱いにする
#      1. の方針と揃える）。
#
# 推奨アクション（機械的な組み合わせのみで決める）:
#   - ワークツリー有り・ブランチ有り・新しいコミット有り
#       -> REUSE_WORKTREE_REDISPATCH（既存ワークツリーを再利用して再引き渡し）
#   - ワークツリー無し・ブランチ有り・新しいコミット有り
#       -> RECREATE_WORKTREE_REDISPATCH（ワークツリーを作り直して再引き渡し）
#   - ワークツリー有り・ブランチ有り・新しいコミットは無いが、占有記録が
#     新しい（TASK-41）
#       -> REUSE_WORKTREE_REDISPATCH（コミットを伴わない長時間処理が続いて
#          いるだけで、実際は稼働中である可能性が高いとみなす）
#   - ブランチが無い、または（新しいコミットが無く、かつ占有記録も
#     新しくない/存在しない）
#       -> REVERT_TO_TODO（To Do に戻す。ワークツリーが残っていれば
#          呼び出し元が別途 git worktree remove で片付ける）
#
# 責務外: backlog タスクのステータス変更、git worktree add/remove・
# git worktree prune 等の実際の変更操作はこのスクリプトの範囲外。診断結果を
# 出すのみで、それに基づく実際の操作は呼び出し元（improvement-dispatch）が
# 行う。
#
# 出力: 標準出力に次の行を出す（最終行が RESULT）。
#   WORKTREE_EXISTS: true|false
#   BRANCH_EXISTS: true|false
#   NEW_COMMITS: <件数>（branch が存在しない場合は N/A）
#   OCCUPANCY_RECORD_EXISTS: true|false（TASK-41。占有記録を読めたか）
#   OCCUPANCY_AGE_SECONDS: <秒数>|N/A（TASK-41。占有記録の記録時刻からの
#     経過秒数。占有記録が無い場合は N/A）
#   OCCUPANCY_FRESH: true|false|N/A（TASK-41。経過秒数が1800秒未満なら
#     true。占有記録が無い場合は N/A）
#   RESULT: <値>
#
# 終了ステータス:
#   0 = REUSE_WORKTREE_REDISPATCH
#   1 = RECREATE_WORKTREE_REDISPATCH
#   2 = REVERT_TO_TODO
#   3 = ERROR（引数不正、対象リポジトリでない、base_branch が解決できない等。
#             詳細は標準エラーに出す）

set -uo pipefail

err() {
  printf 'エラー: %s\n' "$*" >&2
}

emit_result() {
  printf 'RESULT: %s\n' "$1"
}

if [ "$#" -ne 3 ]; then
  err "使い方: $(basename "$0") <worktree_path> <branch> <base_branch>"
  emit_result "ERROR"
  exit 3
fi

WORKTREE_PATH="$1"
BRANCH="$2"
BASE_BRANCH="$3"

if [ -z "$WORKTREE_PATH" ] || [ -z "$BRANCH" ] || [ -z "$BASE_BRANCH" ]; then
  err "worktree_path・branch・base_branch はいずれも空文字にできない"
  emit_result "ERROR"
  exit 3
fi

if ! REPO_ROOT="$(git rev-parse --show-toplevel 2>&1)"; then
  err "カレントディレクトリが git リポジトリの中ではない: $REPO_ROOT"
  emit_result "ERROR"
  exit 3
fi

# ---- 0. 前提条件: base_branch がこのリポジトリで解決できるか ----
if ! git -C "$REPO_ROOT" rev-parse --quiet --verify "${BASE_BRANCH}^{commit}" >/dev/null; then
  err "base_branch がこのリポジトリで解決できない: $BASE_BRANCH"
  emit_result "ERROR"
  exit 3
fi

# ---- 1. ワークツリーが実際に登録されているか ----
# 単なるディレクトリの有無ではなく、git worktree list に登録された worktree
# であることを確認する（ディレクトリだけ残っていて登録情報が無い/既に
# prune 済みのケースを「無い」として扱うため）。
if ! worktree_list_output="$(git -C "$REPO_ROOT" worktree list --porcelain 2>&1)"; then
  err "git worktree list の実行に失敗した: $worktree_list_output"
  emit_result "ERROR"
  exit 3
fi

# WORKTREE_PATH を正規化してから比較する（末尾スラッシュ・相対パス表記の
# ゆれによる誤判定を避けるため）。実在しないパスは正規化できないため、
# その場合は元の文字列のまま比較する（＝以下で一致せず「存在しない」判定になる）。
normalized_worktree_path="$WORKTREE_PATH"
if [ -d "$WORKTREE_PATH" ]; then
  normalized_worktree_path="$(cd "$WORKTREE_PATH" && pwd -P)"
fi

WORKTREE_EXISTS="false"
if printf '%s\n' "$worktree_list_output" | grep -Fxq "worktree $normalized_worktree_path"; then
  WORKTREE_EXISTS="true"
fi

# ---- 2. ブランチが存在するか ----
BRANCH_EXISTS="false"
if git -C "$REPO_ROOT" show-ref --verify --quiet "refs/heads/$BRANCH"; then
  BRANCH_EXISTS="true"
fi

# ---- 3. base_branch から見て新しいコミットがあるか ----
NEW_COMMITS="N/A"
if [ "$BRANCH_EXISTS" = "true" ]; then
  if ! NEW_COMMITS="$(git -C "$REPO_ROOT" rev-list --count "${BASE_BRANCH}..${BRANCH}" 2>&1)"; then
    err "git rev-list --count \"${BASE_BRANCH}..${BRANCH}\" の実行に失敗した: $NEW_COMMITS"
    emit_result "ERROR"
    exit 3
  fi
fi

# ---- 4. 占有記録（.worktree-occupancy）の鮮度（TASK-40 / TASK-41） ----
# worktree_path が git worktree として登録されている場合のみ読む
# （登録されていないワークツリーは 1. の判定で既に「存在しない」扱いに
# なっており、占有記録を読んでも矛盾した情報になり得るため）。
OCCUPANCY_RECORD_EXISTS="false"
OCCUPANCY_AGE_SECONDS="N/A"
OCCUPANCY_FRESH="N/A"
OCCUPANCY_FRESH_THRESHOLD_SECONDS=1800  # 30分。根拠はヘッダーコメント参照。

if [ "$WORKTREE_EXISTS" = "true" ]; then
  occupancy_file="$WORKTREE_PATH/.worktree-occupancy"
  if [ -f "$occupancy_file" ]; then
    # ファイル全体を source せず、ASSIGNED_AT_EPOCH の値だけを取り出す
    # （占有記録は過去の実行が書いたファイルであり、任意のシェルコードとして
    # 実行しないため）。
    assigned_at_epoch="$(grep -m1 -E '^ASSIGNED_AT_EPOCH=' "$occupancy_file" 2>/dev/null | sed -E 's/^ASSIGNED_AT_EPOCH=//')"
    if [ -n "$assigned_at_epoch" ] && [[ "$assigned_at_epoch" =~ ^[0-9]+$ ]]; then
      OCCUPANCY_RECORD_EXISTS="true"
      now_epoch="$(date -u +%s)"
      OCCUPANCY_AGE_SECONDS=$((now_epoch - assigned_at_epoch))
      if [ "$OCCUPANCY_AGE_SECONDS" -lt 0 ]; then
        OCCUPANCY_AGE_SECONDS=0
      fi
      if [ "$OCCUPANCY_AGE_SECONDS" -lt "$OCCUPANCY_FRESH_THRESHOLD_SECONDS" ]; then
        OCCUPANCY_FRESH="true"
      else
        OCCUPANCY_FRESH="false"
      fi
    fi
    # ASSIGNED_AT_EPOCH が読めない/数値でない場合は OCCUPANCY_RECORD_EXISTS=false
    # のまま（＝占有記録なしとして既存ロジックにフォールバックする）。
  fi
fi

printf 'WORKTREE_EXISTS: %s\n' "$WORKTREE_EXISTS"
printf 'BRANCH_EXISTS: %s\n' "$BRANCH_EXISTS"
printf 'NEW_COMMITS: %s\n' "$NEW_COMMITS"
printf 'OCCUPANCY_RECORD_EXISTS: %s\n' "$OCCUPANCY_RECORD_EXISTS"
printf 'OCCUPANCY_AGE_SECONDS: %s\n' "$OCCUPANCY_AGE_SECONDS"
printf 'OCCUPANCY_FRESH: %s\n' "$OCCUPANCY_FRESH"

# ---- 5. 推奨アクションを決める ----
if [ "$BRANCH_EXISTS" = "true" ] && [ "$NEW_COMMITS" != "0" ]; then
  if [ "$WORKTREE_EXISTS" = "true" ]; then
    emit_result "REUSE_WORKTREE_REDISPATCH"
    exit 0
  else
    emit_result "RECREATE_WORKTREE_REDISPATCH"
    exit 1
  fi
fi

# コミット履歴だけでは「新しい変化なし」と判定される場合でも、占有記録が
# 新しければ稼働中の可能性が高いとみなし REUSE 系に倒す（TASK-41 AC#1）。
# 占有記録が古い、または存在しない場合はこの分岐に入らず、従来通り
# REVERT_TO_TODO になる（TASK-41 AC#2: 後方互換）。
if [ "$WORKTREE_EXISTS" = "true" ] && [ "$BRANCH_EXISTS" = "true" ] && [ "$OCCUPANCY_FRESH" = "true" ]; then
  emit_result "REUSE_WORKTREE_REDISPATCH"
  exit 0
fi

emit_result "REVERT_TO_TODO"
exit 2
