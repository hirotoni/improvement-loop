#!/usr/bin/env bash
# improvement-dispatch 手順2-3（In Progress タスクの引き渡し先が失われたと確定した
# 後の復旧診断）を決定論的に行う。
#
# 使い方: check-progress-recovery <worktree_path> <branch> <base_branch>
#   worktree_path  notes に記録されている WORKTREE_DIR。存在しなくてもよい。
#   branch         作業ブランチ名。存在しなくてもよい。
#   base_branch    比較対象のベースブランチ。このリポジトリで解決できる必要がある。
#
# 呼び出し元のカレントディレクトリが属する git リポジトリをメインの作業木として扱い、
# git の問い合わせはすべてそこへ行う。対象ワークツリーの中には立ち入らない
# （worktree_path はパスの比較と占有記録の読み取りにのみ使う）。
#
# ワークツリーの有無は「ディレクトリがある」ではなく「git worktree list に登録が
# ある」で判定する（登録情報の無い残骸を存在扱いしないため）。
#
# 出力する行（WORKTREE_EXISTS / BRANCH_EXISTS / NEW_COMMITS / OCCUPANCY_RECORD_EXISTS /
# OCCUPANCY_AGE_SECONDS / OCCUPANCY_FRESH / RESULT）の意味、RESULT の各値に対する
# dispatch 側の対応、および 1800 秒（30分）という鮮度の閾値の根拠（手順7の起動間隔）は
# claude-code/skills/improvement-dispatch/SKILL.md 手順2 が正本。RESULT は最終行に出す。
#
# 終了ステータス:
#   0 = REUSE_WORKTREE_REDISPATCH
#   1 = RECREATE_WORKTREE_REDISPATCH
#   2 = REVERT_TO_TODO
#   3 = ERROR（引数不正、対象リポジトリでない、base_branch が解決できない等）
#
# 責務外: backlog タスクのステータス変更と、git worktree add/remove/prune のような
# 実際の変更操作。診断結果を出すだけで、それに基づく操作は呼び出し元が行う。

set -uo pipefail

err() {
  printf 'エラー: %s\n' "$*" >&2
}

emit_result() {
  printf 'RESULT: %s\n' "$1"
}

if [ "$#" -ne 3 ]; then
  err "使い方: $(basename "$0") <worktree_path> <branch> <base_branch>"
  emit_result "ERROR"
  exit 3
fi

WORKTREE_PATH="$1"
BRANCH="$2"
BASE_BRANCH="$3"

if [ -z "$WORKTREE_PATH" ] || [ -z "$BRANCH" ] || [ -z "$BASE_BRANCH" ]; then
  err "worktree_path・branch・base_branch はいずれも空文字にできない"
  emit_result "ERROR"
  exit 3
fi

if ! REPO_ROOT="$(git rev-parse --show-toplevel 2>&1)"; then
  err "カレントディレクトリが git リポジトリの中ではない: $REPO_ROOT"
  emit_result "ERROR"
  exit 3
fi

# ---- 0. 前提条件: base_branch がこのリポジトリで解決できるか ----
if ! git -C "$REPO_ROOT" rev-parse --quiet --verify "${BASE_BRANCH}^{commit}" >/dev/null; then
  err "base_branch がこのリポジトリで解決できない: $BASE_BRANCH"
  emit_result "ERROR"
  exit 3
fi

# ---- 1. ワークツリーが実際に登録されているか ----
if ! worktree_list_output="$(git -C "$REPO_ROOT" worktree list --porcelain 2>&1)"; then
  err "git worktree list の実行に失敗した: $worktree_list_output"
  emit_result "ERROR"
  exit 3
fi

# 末尾スラッシュ・相対パス表記のゆれによる誤判定を避けるため正規化してから比較する。
# 実在しないパスは正規化できないので元の文字列のまま比較する（＝「存在しない」判定）。
normalized_worktree_path="$WORKTREE_PATH"
if [ -d "$WORKTREE_PATH" ]; then
  normalized_worktree_path="$(cd "$WORKTREE_PATH" && pwd -P)"
fi

WORKTREE_EXISTS="false"
if printf '%s\n' "$worktree_list_output" | grep -Fxq "worktree $normalized_worktree_path"; then
  WORKTREE_EXISTS="true"
fi

# ---- 2. ブランチが存在するか ----
BRANCH_EXISTS="false"
if git -C "$REPO_ROOT" show-ref --verify --quiet "refs/heads/$BRANCH"; then
  BRANCH_EXISTS="true"
fi

# ---- 3. base_branch から見て新しいコミットがあるか ----
NEW_COMMITS="N/A"
if [ "$BRANCH_EXISTS" = "true" ]; then
  if ! NEW_COMMITS="$(git -C "$REPO_ROOT" rev-list --count "${BASE_BRANCH}..${BRANCH}" 2>&1)"; then
    err "git rev-list --count \"${BASE_BRANCH}..${BRANCH}\" の実行に失敗した: $NEW_COMMITS"
    emit_result "ERROR"
    exit 3
  fi
fi

# ---- 4. 占有記録（.worktree-occupancy）の鮮度 ----
# ワークツリーとして登録されている場合のみ読む（1. で「存在しない」と判定したものの
# 占有記録を読むと、矛盾した情報を出すことになるため）。
OCCUPANCY_RECORD_EXISTS="false"
OCCUPANCY_AGE_SECONDS="N/A"
OCCUPANCY_FRESH="N/A"
OCCUPANCY_FRESH_THRESHOLD_SECONDS=1800  # 30分。根拠はヘッダーコメント参照。

if [ "$WORKTREE_EXISTS" = "true" ]; then
  occupancy_file="$WORKTREE_PATH/.worktree-occupancy"
  if [ -f "$occupancy_file" ]; then
    # ファイル全体を source せず ASSIGNED_AT_EPOCH の値だけを取り出す（外部が書いた
    # ファイルを任意のシェルコードとして実行しないため）。ISO8601 文字列の方は
    # GNU date と BSD date で解釈が割れるので使わない。
    assigned_at_epoch="$(grep -m1 -E '^ASSIGNED_AT_EPOCH=' "$occupancy_file" 2>/dev/null | sed -E 's/^ASSIGNED_AT_EPOCH=//')"
    if [ -n "$assigned_at_epoch" ] && [[ "$assigned_at_epoch" =~ ^[0-9]+$ ]]; then
      OCCUPANCY_RECORD_EXISTS="true"
      now_epoch="$(date -u +%s)"
      OCCUPANCY_AGE_SECONDS=$((now_epoch - assigned_at_epoch))
      if [ "$OCCUPANCY_AGE_SECONDS" -lt 0 ]; then
        OCCUPANCY_AGE_SECONDS=0
      fi
      if [ "$OCCUPANCY_AGE_SECONDS" -lt "$OCCUPANCY_FRESH_THRESHOLD_SECONDS" ]; then
        OCCUPANCY_FRESH="true"
      else
        OCCUPANCY_FRESH="false"
      fi
    fi
    # 読めない/数値でない場合は OCCUPANCY_RECORD_EXISTS=false のまま
    # （＝占有記録なしとしてコミット履歴ベースの判定にフォールバックする）。
  fi
fi

printf 'WORKTREE_EXISTS: %s\n' "$WORKTREE_EXISTS"
printf 'BRANCH_EXISTS: %s\n' "$BRANCH_EXISTS"
printf 'NEW_COMMITS: %s\n' "$NEW_COMMITS"
printf 'OCCUPANCY_RECORD_EXISTS: %s\n' "$OCCUPANCY_RECORD_EXISTS"
printf 'OCCUPANCY_AGE_SECONDS: %s\n' "$OCCUPANCY_AGE_SECONDS"
printf 'OCCUPANCY_FRESH: %s\n' "$OCCUPANCY_FRESH"

# ---- 5. 推奨アクションを決める ----
if [ "$BRANCH_EXISTS" = "true" ] && [ "$NEW_COMMITS" != "0" ]; then
  if [ "$WORKTREE_EXISTS" = "true" ]; then
    emit_result "REUSE_WORKTREE_REDISPATCH"
    exit 0
  else
    emit_result "RECREATE_WORKTREE_REDISPATCH"
    exit 1
  fi
fi

# コミット履歴だけでは「変化なし」でも、占有記録が新しければ稼働中の可能性が高いと
# みなして REUSE 系に倒す。占有記録が古い/無い場合はここに入らず REVERT_TO_TODO になる。
if [ "$WORKTREE_EXISTS" = "true" ] && [ "$BRANCH_EXISTS" = "true" ] && [ "$OCCUPANCY_FRESH" = "true" ]; then
  emit_result "REUSE_WORKTREE_REDISPATCH"
  exit 0
fi

emit_result "REVERT_TO_TODO"
exit 2
