#!/usr/bin/env bash
# Approved になった improvement-loop の作業ブランチを、決定論的な手順でデフォルト
# ブランチにマージする（improvement-dispatch 手順3の auto_merge_reviewed: true パート）。
#
# 使い方: merge-reviewed-branch <作業ブランチ名>
#
# 呼び出し元のカレントディレクトリが属する git リポジトリをメインの作業木として扱い、
# 切り替えとマージはそこで行う。対象の作業ブランチ用ワークツリーには立ち入らず、
# マージ完了後に git worktree remove で片付けるだけである。
#
# 前提条件（メインの作業木がクリーン、対象ブランチが存在、デフォルトブランチとの
# 差分がある）を確認してから、ff-only → 衝突が無ければ 3-way の順にマージし、
# 完了した場合だけワークツリーと作業ブランチを片付ける。
# 差分が既に無い場合は新規のマージはしないが、片付けが未完了なら再試行する
# （過去の呼び出しでマージだけ成功して片付けが失敗した状態からの回復のため）。
#
# デフォルトブランチ名は create-worktree と同じ核心ロジック（git symbolic-ref --short
# refs/remotes/origin/HEAD、解決できなければ "main"）で判定する。ただし create-worktree
# と違って git fetch origin はしない。決定論性とオフライン動作を優先し、ローカルに
# キャッシュ済みの refs/remotes/origin/HEAD をそのまま使う。
#
# 終了ステータスと、標準出力の最終行 "RESULT: <値>" で結果を判別する。
#   exit 0 / MERGED               マージ完了
#   exit 1 / PRECONDITION_NOT_MET マージ未実施（前提条件を満たさない）
#   exit 2 / CONFLICT             3-way マージが衝突した。abort 済みで git 状態は変更前と同じ
#   exit 3 / ERROR                想定外のエラー。マージ未実施
# 各値に対する dispatch 側の対応は
# claude-code/skills/improvement-dispatch/SKILL.md 手順3 が正本。
#
# 責務外: backlog タスクのステータス変更。
# rebase は使わない（人間がレビューしたコミットの同一性を変えないため）。
# --force を伴う操作もしない。

set -uo pipefail

err() {
  printf 'エラー: %s\n' "$*" >&2
}

emit_result() {
  printf 'RESULT: %s\n' "$1"
}

# git merge --abort を実行し、実際にマージ前のクリーンな状態へ戻ったことまで確認する。
# 復元を保証できない場合は 1 を返す。呼び出し元はそのとき CONFLICT ではなく ERROR を
# 報告すること（「git 状態は変更前と同じ」という保証が崩れているため）。
abort_and_verify_restored() {
  if ! git -C "$REPO_ROOT" merge --abort >/dev/null 2>&1; then
    err "git merge --abort 自体が失敗した"
    return 1
  fi
  if git -C "$REPO_ROOT" rev-parse -q --verify MERGE_HEAD >/dev/null 2>&1; then
    err "git merge --abort 後も MERGE_HEAD が残っている"
    return 1
  fi
  local post_abort_status
  if ! post_abort_status="$(git -C "$REPO_ROOT" status --porcelain)"; then
    err "git merge --abort 後の git status の実行に失敗した（状態を確認できない）"
    return 1
  fi
  if [ -n "$post_abort_status" ]; then
    err "git merge --abort 後もメインの作業木が汚れている"
    return 1
  fi
  return 0
}

# 対応するワークツリー（存在すれば）と作業ブランチ自体を片付ける。
# git worktree remove / git branch -d はいずれも安全側の操作のみで --force/-D はしない。
# 失敗してもエラーを出すだけで、呼び出し元の結果（exit code・RESULT）は変えない。
cleanup_worktree_and_branch() {
  local repo_root="$1"
  local branch="$2"

  # パスに半角スペースが含まれても壊れないよう、porcelain 出力の解析は
  # bin/lib/worktree_porcelain.sh の worktree_porcelain_pairs() に任せる。
  # branch は refs/heads/ を除いた短縮名で出るので、比較対象も短縮名にする。
  local worktree_path
  worktree_path="$(git -C "$repo_root" worktree list --porcelain | worktree_porcelain_pairs | awk -F'\t' -v branch="$branch" '
    $2 == branch { print $1 }
  ')"

  if [ -n "$worktree_path" ]; then
    local worktree_err_file
    worktree_err_file="$(mktemp)"
    if git -C "$repo_root" worktree remove "$worktree_path" 2>"$worktree_err_file"; then
      echo "ワークツリーを片付けた: $worktree_path"
    else
      err "ワークツリーの片付けに失敗した（--force はせず残す）: $worktree_path"
      err "$(cat "$worktree_err_file")"
    fi
    rm -f "$worktree_err_file"
  else
    echo "対応するワークツリーは見つからなかった（既に片付け済みの可能性がある）"
  fi

  local branch_err_file
  branch_err_file="$(mktemp)"
  if git -C "$repo_root" branch -d "$branch" 2>"$branch_err_file"; then
    echo "作業ブランチを削除した: $branch"
  else
    err "作業ブランチの削除に失敗した（-D はせず残す）: $branch"
    err "$(cat "$branch_err_file")"
  fi
  rm -f "$branch_err_file"
}

BRANCH="${1:-}"

if [ -z "$BRANCH" ]; then
  err "使い方: $0 <作業ブランチ名>"
  emit_result "ERROR"
  exit 3
fi

if ! REPO_ROOT="$(git rev-parse --show-toplevel 2>&1)"; then
  err "カレントディレクトリが git リポジトリの中ではない: $REPO_ROOT"
  emit_result "ERROR"
  exit 3
fi

# bin/lib/worktree_porcelain.sh を source するために、まず自分自身の実パスから
# 配布元リポジトリのルートを解決する（`.claude/skills/improvement-dispatch`
# シンボリックリンク経由で実行されうるため、BASH_SOURCE をそのまま使えない）。
# ここで求める DIST_REPO_ROOT（配布元）は REPO_ROOT（操作対象）とは別物である。
#
# この source を上の git rev-parse より前へ移動しないこと。
# _bootstrap_resolve_own_path は realpath/dirname 等を使うため、前に置くと git が
# PATH に無い環境で本来の診断より先に生の "command not found" が出る
# （create-worktree で実際に踏んだ回帰であり、同じ配置をここでも守っている）。
_bootstrap_resolve_own_path() {
  if command -v realpath >/dev/null 2>&1; then
    realpath "$1"
  elif readlink -f "$1" >/dev/null 2>&1; then
    readlink -f "$1"
  else
    local dir base
    dir="$(cd "$(dirname "$1")" && pwd -P)"
    base="$(basename "$1")"
    printf '%s/%s\n' "$dir" "$base"
  fi
}
SCRIPT_SOURCE="$(_bootstrap_resolve_own_path "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_SOURCE")" && pwd)"
# SCRIPT_DIR は <配布元>/claude-code/skills/improvement-dispatch/scripts。4階層上がルート。
DIST_REPO_ROOT="$(cd "$SCRIPT_DIR/../../../.." && pwd)"

# shellcheck source=../../../../bin/lib/worktree_porcelain.sh
source "$DIST_REPO_ROOT/bin/lib/worktree_porcelain.sh"

# ---- 1. 前提条件: メインの作業木がクリーンか ----
# git status 自体の失敗（リポジトリの破損、ロック等）を「クリーン」と取り違えて
# 先に進まないよう、コマンドの終了ステータスも確認する（フェイルクローズ）。
if ! dirty_status="$(git -C "$REPO_ROOT" status --porcelain)"; then
  err "git status の実行に失敗した。マージを行わない: $REPO_ROOT"
  emit_result "ERROR"
  exit 3
fi
if [ -n "$dirty_status" ]; then
  err "メインの作業木が汚れている。マージを行わない: $REPO_ROOT"
  printf '%s\n' "$dirty_status" >&2
  emit_result "PRECONDITION_NOT_MET"
  exit 1
fi

# ---- 2. 前提条件: 対象ブランチが存在するか ----
if ! git -C "$REPO_ROOT" show-ref --verify --quiet "refs/heads/$BRANCH"; then
  err "作業ブランチが存在しない: $BRANCH"
  emit_result "PRECONDITION_NOT_MET"
  exit 1
fi

# ---- 3. 前提条件: デフォルトブランチとの差分があるか ----
# fetch をしない理由はファイル冒頭のコメントを参照。
DEFAULT_BRANCH="$(git -C "$REPO_ROOT" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null | sed 's#^origin/##')"
if [ -z "$DEFAULT_BRANCH" ]; then
  DEFAULT_BRANCH="main"
fi

if ! git -C "$REPO_ROOT" show-ref --verify --quiet "refs/heads/$DEFAULT_BRANCH"; then
  err "デフォルトブランチが存在しない: $DEFAULT_BRANCH"
  emit_result "PRECONDITION_NOT_MET"
  exit 1
fi

commit_count="$(git -C "$REPO_ROOT" rev-list --count "$DEFAULT_BRANCH..$BRANCH" 2>/dev/null || true)"
if [ -z "$commit_count" ] || [ "$commit_count" -eq 0 ]; then
  err "作業ブランチ '$BRANCH' に $DEFAULT_BRANCH との差分が無い"
  # 差分が無い＝既に取り込み済み。過去の呼び出しで片付けだけが失敗して残っている
  # 可能性があるので、片付けだけ再試行する。今回は新規のマージをしていないため、
  # 片付けの成否によらず結果は PRECONDITION_NOT_MET のまま変えない。
  err "対応するワークツリー・作業ブランチの片付けが未完了なら再試行する"
  cleanup_worktree_and_branch "$REPO_ROOT" "$BRANCH"
  emit_result "PRECONDITION_NOT_MET"
  exit 1
fi

# ---- 4. デフォルトブランチに切り替える ----
if ! git -C "$REPO_ROOT" switch "$DEFAULT_BRANCH" >/dev/null 2>&1; then
  err "$DEFAULT_BRANCH への切り替えに失敗した"
  emit_result "ERROR"
  exit 3
fi

# ---- 5. ff-only を試す ----
if git -C "$REPO_ROOT" merge --ff-only "$BRANCH" >/dev/null 2>&1; then
  echo "ff-only でマージした: $BRANCH"
else
  # ---- 6. 3-way ドライラン ----
  merge_output="$(git -C "$REPO_ROOT" merge --no-commit --no-ff "$BRANCH" 2>&1)"
  merge_status=$?
  conflicted_files="$(git -C "$REPO_ROOT" diff --name-only --diff-filter=U)"

  if [ -n "$conflicted_files" ]; then
    if abort_and_verify_restored; then
      err "3-wayマージが衝突した。abort してマージ前の状態に戻した。"
      err "衝突したファイル:"
      printf '%s\n' "$conflicted_files" >&2
      emit_result "CONFLICT"
      exit 2
    else
      err "3-wayマージが衝突し、かつ abort による状態の復元も確認できなかった。"
      err "メインの作業木の状態を手動で確認すること: $REPO_ROOT"
      emit_result "ERROR"
      exit 3
    fi
  fi

  if [ "$merge_status" -ne 0 ]; then
    # 衝突ではないが merge 自体が失敗した（想定外）。安全側に倒して abort する。
    err "3-wayマージが衝突以外の理由で失敗した: $merge_output"
    if ! abort_and_verify_restored; then
      err "abort による状態の復元も確認できなかった。メインの作業木の状態を手動で確認すること: $REPO_ROOT"
    fi
    emit_result "ERROR"
    exit 3
  fi

  if ! git -C "$REPO_ROOT" commit --no-edit >/dev/null 2>&1; then
    # 衝突は無かったがコミットに失敗した（フック等）。安全側に倒して abort する。
    err "衝突は無かったがマージコミットに失敗した。"
    if ! abort_and_verify_restored; then
      err "abort による状態の復元も確認できなかった。メインの作業木の状態を手動で確認すること: $REPO_ROOT"
    fi
    emit_result "ERROR"
    exit 3
  fi

  echo "3-wayマージ（衝突無し）でマージした: $BRANCH"
fi

merged_sha="$(git -C "$REPO_ROOT" rev-parse --short HEAD)"
echo "$DEFAULT_BRANCH の位置: $merged_sha"

# ---- 7-8. 対応するワークツリー・作業ブランチを片付ける ----
cleanup_worktree_and_branch "$REPO_ROOT" "$BRANCH"

emit_result "MERGED"
exit 0
