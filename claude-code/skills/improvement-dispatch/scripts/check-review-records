#!/usr/bin/env bash
# improvement-dispatch 手順 6 の完了検証のうち、improvement-work 手順 6 のレビュー記録の照合で
# 機械的に判定できる部分を行う。
#
# 使い方: check-review-records <タスク ID>
#   カレントディレクトリで `backlog task view <タスク ID> --plain` を実行し、その notes のうち
#   最後の `### 引き渡し` より後にある `### レビュー <巡数> 巡目` の記録を照合する。
#
# 記録の書式、判定の順序、出力する行と RESULT の各値の意味、AI が判断する範囲の正本は
# claude-code/skills/improvement-work/review-record-format.md にある。ここには複製しない。
# RESULT は標準出力の最終行に出し、診断メッセージは標準エラーに出す。
#
# 終了ステータス:
#   0 = OK
#   1 = NOT_CONVERGED
#   2 = ERROR（引数の誤り、backlog task view の失敗など）
#   3 = NO_RECORDS
#   4 = FORMAT_ERROR
#   5 = NEEDS_REVIEW
#
# 責務外: backlog タスクの状態の変更。照合結果を出すだけで、差し戻しなどは呼び出し元が行う。
# improvement-work が手順 3 の差し戻し（blocked:needs-decision）をしたタスクかどうかも見ない。

set -uo pipefail

err() {
  printf 'エラー: %s\n' "$*" >&2
}

result_error() {
  err "$1"
  printf 'RESULT: ERROR\n'
  exit 2
}

# bin/lib/notes_records.sh を source するために、自分自身の実パスから配布元リポジトリの
# ルートを解決する（`.claude/skills/improvement-dispatch` シンボリックリンク経由で実行され
# うるため、BASH_SOURCE をそのまま使えない）。check-forbidden-allowed-paths と同じ形である。
_bootstrap_resolve_own_path() {
  if command -v realpath >/dev/null 2>&1; then
    realpath "$1"
  elif readlink -f "$1" >/dev/null 2>&1; then
    readlink -f "$1"
  else
    local dir base
    dir="$(cd "$(dirname "$1")" && pwd -P)"
    base="$(basename "$1")"
    printf '%s/%s\n' "$dir" "$base"
  fi
}
SCRIPT_SOURCE="$(_bootstrap_resolve_own_path "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_SOURCE")" && pwd)"
# SCRIPT_DIR は <配布元>/claude-code/skills/improvement-dispatch/scripts。4階層上がルート。
DIST_REPO_ROOT="$(cd "$SCRIPT_DIR/../../../.." && pwd)"

# shellcheck source=../../../../bin/lib/notes_records.sh
source "$DIST_REPO_ROOT/bin/lib/notes_records.sh" \
  || { printf 'エラー: %s を読み込めない\n' "$DIST_REPO_ROOT/bin/lib/notes_records.sh" >&2; printf 'RESULT: ERROR\n'; exit 2; }

if [ "$#" -ne 1 ] || [ -z "$1" ]; then
  result_error "使い方: $(basename "$0") <タスク ID>"
fi
TASK_ID="$1"

# 標準エラーは解析する入力に混ぜない（CLI の警告が notes の行として読まれないように）。
# 失敗したときだけメッセージに添える。
VIEW_ERR_FILE="$(mktemp)" || result_error "一時ファイルを作れない"
trap 'rm -f "$VIEW_ERR_FILE"' EXIT
if ! VIEW_OUTPUT="$(backlog task view "$TASK_ID" --plain 2>"$VIEW_ERR_FILE")"; then
  result_error "backlog task view $TASK_ID --plain が失敗した: $(cat "$VIEW_ERR_FILE")"
fi

# 照合本体。記録の区切りは notes_records に任せ、ここでは `### ` 行ごとに 1 記録として読む。
# awk は notes_records.sh と同じ理由（macOS 同梱の awk が UTF-8 ロケールで日本語の文字列を
# 等しいと誤判定する）で LC_ALL=C で動かす。
# notes_records の失敗を記録が無いこと（NO_RECORDS）と取り違えないよう、先に切り出して終了ステータスを見る。
if ! RECORDS="$(printf '%s\n' "$VIEW_OUTPUT" | notes_records --after-last-handoff)"; then
  result_error "notes の記録を取り出せない"
fi
REPORT="$(printf '%s\n' "$RECORDS" | LC_ALL=C awk '
  function starts_with(s, p) { return substr(s, 1, length(p)) == p }
  function ends_with(s, p) { return length(s) >= length(p) && substr(s, length(s) - length(p) + 1) == p }
  # レビュー記録として扱う見出しか（書式に合わないものも含む）。「巡目」で終わる見出しはすべて
  # レビュー記録とみなし、形が崩れていれば書式不備として名指しする（数え漏れで前の巡が最終巡に
  # 繰り上がらないようにするため）。「（レビュー1巡目を受けて）」のように途中に含むだけの見出しは
  # 別の記録なので数えない。
  function is_review_title(t, rest) {
    if (ends_with(t, "巡目")) { return 1 }
    if (!starts_with(t, "レビュー")) { return 0 }
    rest = substr(t, length("レビュー") + 1)
    sub(/^ +/, "", rest)
    return rest ~ /^[0-9]/
  }
  # 値の末尾に付いた全角括弧の注記「（…）」を除く。方法と結果の値にだけ使う。
  function strip_note(s,   i) {
    i = index(s, "（")
    if (i > 0 && ends_with(s, "）")) {
      s = substr(s, 1, i - 1)
      sub(/[ \t]+$/, "", s)
    }
    return s
  }
  function flush(   k, prev, pos, key, missing) {
    if (!in_review) { return }
    rounds++
    last_title = title
    last_method = ""
    last_result_ok = 0
    last_result = ""
    last_p012 = 0
    if (title !~ ("^レビュー [0-9]+ 巡目$")) {
      ferr[++nferr] = title ": 見出しが「レビュー <巡数> 巡目」の形ではない"
    }
    if (stray != "") {
      ferr[++nferr] = title ": 対応より前に項目名で始まらない行がある（" stray "）"
    }
    prev = 0
    for (k = 1; k <= 4; k++) {
      key = keys[k]
      if (cnt[key] == 0 && late[key]) {
        ferr[++nferr] = title ": 「- " key ": 」の行が対応より後にある（4 行の順序が「方法・自己レビューにした理由・結果・対応」ではない）"
        missing = 1
      } else if (cnt[key] == 0) {
        ferr[++nferr] = title ": 「- " key ": 」の行が無い"
        missing = 1
      } else if (cnt[key] > 1) {
        ferr[++nferr] = title ": 「- " key ": 」の行が " cnt[key] " 行ある"
        missing = 1
      } else {
        pos = at[key]
        if (pos < prev) { order_bad = 1 }
        prev = pos
      }
    }
    if (bullet_taiou) {
      ferr[++nferr] = title ": 対応の値が空で、続きの行が「- 」で始まっている"
    }
    if (!missing && order_bad) {
      ferr[++nferr] = title ": 4 行の順序が「方法・自己レビューにした理由・結果・対応」ではない"
    }
    if (cnt["方法"] == 1) {
      v = strip_note(val["方法"])
      if (v == "独立サブエージェント" || v == "自己レビュー") {
        last_method = v
      } else {
        ferr[++nferr] = title ": 方法の値が「独立サブエージェント」「自己レビュー」のどちらでもない（" val["方法"] "）"
      }
    }
    if (last_method == "自己レビュー") {
      need[++nneed] = title ": 自己レビューの巡。自己レビューにした理由が 2 条件のどちらかに当たるか"
    }
    if (cnt["結果"] == 1) {
      v = strip_note(val["結果"])
      if (v == "No findings") {
        last_result_ok = 1; last_p012 = 0
      } else if (v ~ /^P0 [0-9]+ \/ P1 [0-9]+ \/ P2 [0-9]+ \/ P3 [0-9]+$/) {
        split(v, f, " ")
        last_result_ok = 1; last_p012 = f[2] + f[5] + f[8]
      } else {
        ferr[++nferr] = title ": 結果の件数が読めない（" v "）"
      }
      last_result = v
    }
    last_withdrawn = (index(taiou, "取り下げ") > 0)
  }
  BEGIN {
    keys[1] = "方法"; keys[2] = "自己レビューにした理由"; keys[3] = "結果"; keys[4] = "対応"
    rounds = 0; nferr = 0; nneed = 0
  }
  /^### / {
    flush()
    title = substr($0, 5)
    sub(/[ \t]+$/, "", title)
    in_review = is_review_title(title)
    delete cnt; delete at; delete val; delete late; bullet_taiou = 0; is_key = 0
    stray = ""; taiou = ""; in_taiou = 0; taiou_done = 0; lineno = 0; order_bad = 0
    next
  }
  !in_review || taiou_done { next }
  {
    # 対応の続きは、空行か `- ` で始まる行の手前までとする。それより後は、見出し無しで
    # 追記された別の notes（検証の記録など）が同じ記録に連なったものなので読まない。
    if ($0 ~ /^[ \t]*$/) { if (in_taiou) { taiou_done = 1 }; next }
    if (in_taiou) {
      if (starts_with($0, "- ")) {
        # 対応の直後に項目行が来たら、その項目は対応より後に書かれている（順序の誤り）。
        for (k = 1; k <= 3; k++) {
          if (starts_with($0, "- " keys[k] ": ") || $0 == "- " keys[k] ":") { late[keys[k]] = 1; is_key = 1 }
        }
        # 対応の値が空のまま `- ` の箇条書きで続けた（続きを記録の外として捨てずに書式不備にする）。
        if (!is_key && taiou == "") { bullet_taiou = 1 }
        is_key = 0
        taiou_done = 1
        next
      }
      taiou = taiou " " $0
      next
    }
    lineno++
    matched = ""
    for (k = 1; k <= 4; k++) {
      if (starts_with($0, "- " keys[k] ": ") || $0 == "- " keys[k] ":") { matched = keys[k]; break }
    }
    if (matched == "") {
      if (stray == "") { stray = $0 }
      next
    }
    cnt[matched]++
    at[matched] = lineno
    v = substr($0, length("- " matched ": ") + 1)
    sub(/[ \t]+$/, "", v)
    val[matched] = v
    if (matched == "対応") { in_taiou = 1; taiou = v }
  }
  END {
    flush()
    printf "REVIEW_ROUNDS: %d\n", rounds
    if (rounds == 0) { print "RESULT: NO_RECORDS"; exit }
    print "FINAL_ROUND: " last_title
    if (last_result_ok) { print "FINAL_RESULT: " last_result }
    for (k = 1; k <= nferr; k++) { print "FORMAT_ERROR: " ferr[k] }
    not_conv = 0
    if (last_result_ok && last_p012 > 0) {
      if (last_method == "自己レビュー") {
        print "NOT_CONVERGED: " last_title ": 自己レビューの巡で P0/P1/P2 が " last_p012 " 件ある（自己レビューの巡では取り下げを認めない）"
        not_conv = 1
      } else if (!last_withdrawn) {
        print "NOT_CONVERGED: " last_title ": P0/P1/P2 が " last_p012 " 件あり、対応に取り下げの記載が無い"
        not_conv = 1
      } else if (last_method == "独立サブエージェント") {
        need[++nneed] = last_title ": 最終巡の P0/P1/P2 " last_p012 " 件のすべてに、レビュー役が取り下げたと指摘ごとに書かれているか"
      }
    }
    for (k = 1; k <= nneed; k++) { print "NEEDS_REVIEW: " need[k] }
    if (nferr > 0) { print "RESULT: FORMAT_ERROR" }
    else if (not_conv) { print "RESULT: NOT_CONVERGED" }
    else if (nneed > 0) { print "RESULT: NEEDS_REVIEW" }
    else { print "RESULT: OK" }
  }
')"

printf '%s\n' "$REPORT"
case "$(printf '%s\n' "$REPORT" | tail -n 1)" in
  "RESULT: OK") exit 0 ;;
  "RESULT: NOT_CONVERGED") exit 1 ;;
  "RESULT: NO_RECORDS") exit 3 ;;
  "RESULT: FORMAT_ERROR") exit 4 ;;
  "RESULT: NEEDS_REVIEW") exit 5 ;;
  *)
    err "照合の出力を解釈できない"
    printf 'RESULT: ERROR\n'
    exit 2
    ;;
esac
