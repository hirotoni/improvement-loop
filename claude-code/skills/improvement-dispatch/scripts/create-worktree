#!/usr/bin/env bash
# improvement-dispatch 手順5（ワークツリーを作って引き渡す）の実体。
#
# 使い方: create-worktree <task-id>   例: task-14-worktree-script-extraction
#
# worktree_base_dir（.backlog/config.my.yml、既定はリポジトリルート配下の .worktree/）の
# 下の <ベース>/<リポジトリ名>/<task-id> に作業ブランチ improvement/<task-id> の
# ワークツリーを作り、.backlog シンボリックリンクと占有記録 .worktree-occupancy を置き、
# 必要な除外行を .git/info/exclude に足したうえで、起点の鮮度を診断して標準出力へ報告する。
# 同じ <task-id> で何度実行しても既存のブランチ・ワークツリー・除外行を再利用する（冪等）。
#
# 標準出力の契約（RESULT / BASE_REF / BASE_COMMIT / STALE_REASON / MISSING_COMMITS /
# STALE_EXCLUDE / WORKTREE_DIR / BRANCH の各行の意味と、STALE_* を受けた対応）、
# 占有記録の形式、起点の決め方は claude-code/skills/improvement-dispatch/SKILL.md
# 手順5・手順6 が正本。WORKTREE_DIR と BRANCH が出力の最後の2行であることは
# 呼び出し側との契約であり、診断行は必ずそれより前に出す。
#
# 責務外: backlog タスクのステータス変更と、STALE_BASE を受けて引き渡しを止めるかの
# 判断（どちらも呼び出し側 = dispatch）。push・merge・rebase は行わない。
# 診断結果によらず終了ステータスは 0 である。

set -euo pipefail

err() {
  printf 'エラー: %s\n' "$*" >&2
}

# 実行を止めない診断の報告先。標準出力は出力契約専用なので標準エラーへ出す。
# err() と接頭辞を分けるのは、呼び出し側が「失敗した」と読み違えないためである。
warn() {
  printf '警告: %s\n' "$*" >&2
}

if [ "$#" -ne 1 ]; then
  err "使い方: $(basename "$0") <task-id>  (例: task-14-worktree-script-extraction)"
  exit 1
fi

TASK_ID="$1"

if ! [[ "$TASK_ID" =~ ^task-[0-9]+-[a-z0-9]+(-[a-z0-9]+)*$ ]]; then
  err "task-id の形式が不正: $TASK_ID (期待する形式: task-<番号>-<英小文字のスラッグ>)"
  exit 1
fi

if ! REPO_ROOT="$(git rev-parse --show-toplevel 2>&1)"; then
  err "リポジトリルートの取得に失敗した（git コマンドが見つからない、またはカレントディレクトリが git リポジトリの中ではない可能性がある）: $REPO_ROOT"
  exit 1
fi
cd "$REPO_ROOT"
REPO_NAME="$(basename "$REPO_ROOT")"

# bin/lib/worktree_porcelain.sh を source するために、まず自分自身の実パスから
# 配布元リポジトリのルートを解決する（`.claude/skills/improvement-dispatch`
# シンボリックリンク経由で実行されうるため、BASH_SOURCE をそのまま使えない）。
# ここで求める DIST_REPO_ROOT（配布元）は REPO_ROOT（操作対象）とは別物である。
#
# この source を上の git rev-parse より前へ移動しないこと。
# tests/test_create_worktree.sh の 9c は「git 以外の外部コマンドはそれより前に
# 登場しない」ことを前提に、git を含まない最小 PATH で git 不在時の診断メッセージを
# 検証している。_bootstrap_resolve_own_path は realpath/dirname 等を使うため、
# 前に置くとその前提が崩れ、生の "command not found" が先に出る。
_bootstrap_resolve_own_path() {
  if command -v realpath >/dev/null 2>&1; then
    realpath "$1"
  elif readlink -f "$1" >/dev/null 2>&1; then
    readlink -f "$1"
  else
    local dir base
    dir="$(cd "$(dirname "$1")" && pwd -P)"
    base="$(basename "$1")"
    printf '%s/%s\n' "$dir" "$base"
  fi
}
SCRIPT_SOURCE="$(_bootstrap_resolve_own_path "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_SOURCE")" && pwd)"
# SCRIPT_DIR は <配布元>/claude-code/skills/improvement-dispatch/scripts。4階層上がルート。
DIST_REPO_ROOT="$(cd "$SCRIPT_DIR/../../../.." && pwd)"

# shellcheck source=../../../../bin/lib/worktree_porcelain.sh
source "$DIST_REPO_ROOT/bin/lib/worktree_porcelain.sh"

# git-common-dir は cwd 相対のパスを返すことがあるため、絶対パスへ正規化する。
GIT_COMMON_DIR="$(git rev-parse --git-common-dir)"
case "$GIT_COMMON_DIR" in
  /*) : ;;
  *) GIT_COMMON_DIR="$REPO_ROOT/$GIT_COMMON_DIR" ;;
esac

# ---- .backlog/config.my.yml の improvement_loop 配下のスカラー値を読む ----
# ファイルが無い、またはキーが無い場合は空文字（＝既定値扱い）を返す。
# 単一行のスカラー値のみを扱う（配列が要る check-forbidden-allowed-paths は
# 独自の parse_path_list を持つ）。
CONFIG_FILE="$REPO_ROOT/.backlog/config.my.yml"
read_config_scalar() {
  local key="$1"
  if [ ! -f "$CONFIG_FILE" ]; then
    return 0
  fi
  local config_line
  config_line="$(grep -m1 -E "^[[:space:]]*${key}:" "$CONFIG_FILE" || true)"
  if [ -z "$config_line" ]; then
    return 0
  fi
  printf '%s\n' "$config_line" | sed -E \
    -e "s/^[[:space:]]*${key}:[[:space:]]*//" \
    -e 's/[[:space:]]+#.*$//' \
    -e 's/[[:space:]]+$//' \
    -e 's/^"(.*)"$/\1/' \
    -e "s/^'(.*)'\$/\\1/"
}

WORKTREE_BASE_DIR_CONFIG="$(read_config_scalar worktree_base_dir)"

# auto_merge_reviewed: true は push を行わない完全ローカル運用を意味し、起点の
# 決め方が変わる（下の「起点（BASE_REF）の決定」）。既定は false。
case "$(read_config_scalar auto_merge_reviewed)" in
  true|True|TRUE) AUTO_MERGE_REVIEWED=1 ;;
  *) AUTO_MERGE_REVIEWED=0 ;;
esac

# 設定値は絶対パスでもリポジトリルート起点の相対パスでもよい。
if [ -z "$WORKTREE_BASE_DIR_CONFIG" ]; then
  BASE_DIR="$REPO_ROOT/.worktree"
elif [[ "$WORKTREE_BASE_DIR_CONFIG" = /* ]]; then
  BASE_DIR="$WORKTREE_BASE_DIR_CONFIG"
else
  BASE_DIR="$REPO_ROOT/$WORKTREE_BASE_DIR_CONFIG"
fi

# 末尾スラッシュや ".." などの表記ゆれを解決してから使う。解決前の文字列のまま
# 下のリポジトリ内外判定（case 文）を行うと内外を取り違える。
mkdir -p "$BASE_DIR"
BASE_DIR="$(cd "$BASE_DIR" && pwd -P)"
if [ -z "$BASE_DIR" ]; then
  err "worktree_base_dir の解決に失敗した: $WORKTREE_BASE_DIR_CONFIG"
  exit 1
fi

mkdir -p "$BASE_DIR/$REPO_NAME"
WORKTREE_DIR="$BASE_DIR/$REPO_NAME/$TASK_ID"
BRANCH="improvement/$TASK_ID"

# リポジトリ内を指す場合だけ .git/info/exclude に除外パターンを足す。
# リポジトリ外なら追記しない（そもそも追跡対象にならない）。
case "$BASE_DIR" in
  "$REPO_ROOT")
    # "." を除外パターンにするとリポジトリ全体が git status から消えるため、
    # リポジトリ名のディレクトリ単位で除外する。
    REL_BASE_DIR="$REPO_NAME"
    ;;
  "$REPO_ROOT"/*)
    REL_BASE_DIR="${BASE_DIR#"$REPO_ROOT"/}"
    ;;
  *)
    REL_BASE_DIR=""
    ;;
esac

EXCLUDE_FILE="$GIT_COMMON_DIR/info/exclude"
mkdir -p "$(dirname "$EXCLUDE_FILE")"

# ---- 失効した worktree_base_dir 除外行の検知 ----
# .git/info/exclude への追記は追記専用なので、worktree_base_dir を変えて再実行すると
# 古い値の除外行が残り、失効した理由で git の追跡を黙って止め続ける。それを検知する
# ため、管理対象の除外行を次の書式のコメント行1行として exclude 自身に記録する
# （`#` 始まりなので git の除外判定には影響しない）。
#
#   # improvement-loop worktree_base_dir added=<yes|no> path=<リポジトリ相対パス>
#
#   path=  最後に管理対象とした除外行（設定値そのものではなく除外行として書かれた形）。
#   added= その行を improvement-loop 自身が追記したか（yes）、追記しようとした時点で
#          既に存在していたか（no）。no はユーザーや他ツールが書いた可能性がある。
#
# 検知しても報告するだけで、既存行の削除・書き換えはしない。.git/info/exclude は
# 利用者と他ツールの共有物であり、マーカー導入以前の行の所有者を証明できないためである。
# 書き換えるのは固定接頭辞で識別できる自分のマーカー行だけである。
# 既知の限界: マーカーが無い導入先では、既に残っている失効行を検知できない。
EXCLUDE_MARKER_PREFIX="# improvement-loop worktree_base_dir "
# grep と awk の両方で同じ判定を使うため、定義はここ1箇所に置く。
EXCLUDE_MARKER_RE="^${EXCLUDE_MARKER_PREFIX}added=(yes|no) path="
STALE_EXCLUDE_LINES=()

EXCLUDE_MARKER_FOUND=0
PREV_EXCLUDE_ADDED=""
PREV_EXCLUDE_PATH=""
if [ -f "$EXCLUDE_FILE" ]; then
  exclude_marker_line="$(grep -m1 -E "$EXCLUDE_MARKER_RE" "$EXCLUDE_FILE" || true)"
  if [ -n "$exclude_marker_line" ]; then
    EXCLUDE_MARKER_FOUND=1
    exclude_marker_rest="${exclude_marker_line#"${EXCLUDE_MARKER_PREFIX}added="}"
    PREV_EXCLUDE_ADDED="${exclude_marker_rest%% *}"
    # path= の値はパスなので半角スペースを含みうる。行末までを丸ごと値とする。
    PREV_EXCLUDE_PATH="${exclude_marker_line#*" path="}"
  fi
fi

# 記録されている管理対象が現在の値と違い、かつその行が今も残っているなら失効。
# REL_BASE_DIR が空（worktree_base_dir をリポジトリ外へ移した）場合もここを通る。
if [ -n "$PREV_EXCLUDE_PATH" ] && [ "$PREV_EXCLUDE_PATH" != "$REL_BASE_DIR" ] &&
   grep -Fxq "$PREV_EXCLUDE_PATH" "$EXCLUDE_FILE" 2>/dev/null; then
  if [ "$PREV_EXCLUDE_ADDED" = "yes" ]; then
    stale_exclude_origin="added_by_improvement_loop"
  else
    stale_exclude_origin="preexisting"
  fi
  STALE_EXCLUDE_LINES+=("STALE_EXCLUDE=$PREV_EXCLUDE_PATH:$stale_exclude_origin")
  warn "以前の worktree_base_dir に対応する除外行が .git/info/exclude に残っている: $PREV_EXCLUDE_PATH"
  if [ -n "$REL_BASE_DIR" ]; then
    warn "現在の worktree_base_dir から導かれる除外行は '$REL_BASE_DIR' であり、'$PREV_EXCLUDE_PATH' の除外理由は失効している。"
  else
    warn "現在の worktree_base_dir はリポジトリ外を指しており、'$PREV_EXCLUDE_PATH' の除外理由は失効している。"
  fi
  if [ "$PREV_EXCLUDE_ADDED" = "yes" ]; then
    warn "この行は improvement-loop が追記したものである。不要なら手で削除してよい: $EXCLUDE_FILE"
  else
    warn "この行は improvement-loop が追記した時点で既に存在していた。ユーザーまたは他ツールが書いた可能性があるため、削除してよいかは内容を確認して判断すること: $EXCLUDE_FILE"
  fi
  warn "このスクリプトは共有物である .git/info/exclude の既存行を削除・書き換えしない（報告のみ）。"
fi

EXCLUDE_ADDED="no"
if [ -n "$REL_BASE_DIR" ]; then
  if grep -Fxq "$REL_BASE_DIR" "$EXCLUDE_FILE" 2>/dev/null; then
    if [ "$PREV_EXCLUDE_PATH" = "$REL_BASE_DIR" ] && [ -n "$PREV_EXCLUDE_ADDED" ]; then
      EXCLUDE_ADDED="$PREV_EXCLUDE_ADDED"   # 記録済みの由来を保つ（再実行で no に倒れないように）
    fi
  else
    echo "$REL_BASE_DIR" >> "$EXCLUDE_FILE"
    EXCLUDE_ADDED="yes"
  fi

  # マーカー行を現在の管理対象に合わせる。一致していれば1バイトも書かない。
  DESIRED_EXCLUDE_MARKER="${EXCLUDE_MARKER_PREFIX}added=$EXCLUDE_ADDED path=$REL_BASE_DIR"
  if ! grep -Fxq "$DESIRED_EXCLUDE_MARKER" "$EXCLUDE_FILE" 2>/dev/null; then
    if [ "$EXCLUDE_MARKER_FOUND" -eq 1 ]; then
      # 書き戻しは mv ではなく元ファイルへの上書きで行う。mv だと mktemp の 0600 と
      # inode ごと差し替わり、共有物である .git/info/exclude の属性を黙って変えてしまう。
      # マーカー行が複数ある場合は最初の1行を差し替えて残りを落とす（自分が書いた行なので
      # 削除してよい）。行が増え続けるのを防ぐ。
      exclude_tmp_file="$(mktemp "${EXCLUDE_FILE}.XXXXXX")"
      awk -v marker="$DESIRED_EXCLUDE_MARKER" -v re="$EXCLUDE_MARKER_RE" '
        $0 ~ re { if (!replaced) { print marker; replaced = 1 } ; next }
        { print }
      ' "$EXCLUDE_FILE" > "$exclude_tmp_file"
      cat "$exclude_tmp_file" > "$EXCLUDE_FILE"
      rm -f "$exclude_tmp_file"
    else
      printf '%s\n' "$DESIRED_EXCLUDE_MARKER" >> "$EXCLUDE_FILE"
    fi
  fi
fi

git worktree prune   # ディレクトリだけ消えて登録情報が残っているケースを掃除してから作る

# ---- 起点（BASE_REF）の決定 ----
# 既定（auto_merge_reviewed が true 以外）: フェッチできれば origin/<デフォルトブランチ>、
# できなければ main。未 push のローカルコミットを起点に混ぜないためである。
# auto_merge_reviewed: true は push しない完全ローカル運用で origin が進まないため、
# ローカルとリモートの包含関係を見て起点を選び直す（詳細は SKILL.md 手順5）。
DEFAULT_BRANCH=""
FETCH_OK=0
if git fetch origin 2>/dev/null; then
  FETCH_OK=1
  DEFAULT_BRANCH=$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null | sed 's#^origin/##')
fi
# デフォルトブランチ名は origin/HEAD からのみ判定し、駄目なら main へフォールバックする
# （ローカルの HEAD からは求めない。下の worktree add の診断がこの挙動に依存している）。
DEFAULT_BRANCH="${DEFAULT_BRANCH:-main}"

ORIGIN_REF=""
LOCAL_REF=""
DIVERGED_DEFAULT_BRANCH=0
if [ "$FETCH_OK" -eq 1 ]; then
  ORIGIN_REF="origin/$DEFAULT_BRANCH"
  BASE_REF="$ORIGIN_REF"
else
  BASE_REF="main"   # デフォルトブランチが判定できない/リモートが無い場合は main を使う
fi

if [ "$AUTO_MERGE_REVIEWED" -eq 1 ] && [ "$FETCH_OK" -eq 1 ] &&
   git rev-parse --verify --quiet "refs/heads/$DEFAULT_BRANCH" >/dev/null &&
   git rev-parse --verify --quiet "refs/remotes/origin/$DEFAULT_BRANCH" >/dev/null; then
  LOCAL_REF="$DEFAULT_BRANCH"
  if git merge-base --is-ancestor "$ORIGIN_REF" "$LOCAL_REF"; then
    # ローカルが origin を含む（先行・同一）。先行タスクの成果はここにしか無い。
    BASE_REF="$LOCAL_REF"
  elif git merge-base --is-ancestor "$LOCAL_REF" "$ORIGIN_REF"; then
    # ローカルが遅れている。従来どおり origin から分岐する。
    BASE_REF="$ORIGIN_REF"
  else
    # 分岐しており、どちらを起点にしても片方のコミットが欠ける。マージ・rebase は
    # しない（禁止事項）。ローカル側を起点にし、下の鮮度検査で欠落として報告する。
    BASE_REF="$LOCAL_REF"
    DIVERGED_DEFAULT_BRANCH=1
  fi
fi

# 再実行しても git worktree add が「既に存在する」で失敗しないための冪等性ガード。
existing_worktree_branch=""
if [ -d "$WORKTREE_DIR" ]; then
  # パスに半角スペースが含まれても壊れないよう、porcelain 出力の解析は
  # bin/lib/worktree_porcelain.sh の worktree_porcelain_pairs() に任せる。
  existing_worktree_branch="$(git worktree list --porcelain | worktree_porcelain_pairs | awk -F'\t' -v d="$WORKTREE_DIR" '
    $1 == d { print $2; exit }
  ')"
fi

if [ -n "$existing_worktree_branch" ] && [ "$existing_worktree_branch" = "$BRANCH" ]; then
  : # 既に $BRANCH で登録済みのワークツリーが存在するので何もしない（再利用）。
elif [ -d "$WORKTREE_DIR" ]; then
  err "ワークツリーが既に別の内容で存在する: $WORKTREE_DIR (割り当てられたブランチ: ${existing_worktree_branch:-不明})"
  err "内容を確認し、不要と判断できる場合のみ削除するか、人間に判断を委ねること。"
  exit 1
elif git show-ref --verify --quiet "refs/heads/$BRANCH"; then
  # 既にブランチがある（再引き渡し等）なら新規作成せず割り当てる。
  # git worktree add の進捗出力は標準エラーへ回し、標準出力を出力契約だけに保つ。
  git worktree add "$WORKTREE_DIR" "$BRANCH" >&2
else
  # BASE_REF は main へのフォールバック値になりうるので、実在しない参照のことがある。
  # 生のエラーで落ちないよう、他の失敗経路と同様に err() で診断してから終了する（TASK-38）。
  #
  # ただし worktree add は BASE_REF 以外の理由でも失敗する（同じパスにファイルがある、
  # 親ディレクトリに書き込めない、ブランチ参照がロックされている等）。失敗理由を
  # BASE_REF に決め打ちしないよう、worktree add を実行する前に BASE_REF が解決できるかを
  # 確かめて切り分ける。git のエラー文言で分類しないのは、文言が git のバージョンや
  # ロケールで変わるためである。事前に弾くので BASE_REF 不在の経路では
  # git worktree add 自体が動かず、生の "fatal:" は出ない（TASK-87）。
  if ! git rev-parse --verify --quiet "${BASE_REF}^{commit}" >/dev/null 2>&1; then
    err "BASE_REF ($BASE_REF) の解決に失敗し、ワークツリーを作成できなかった"
    err "リモート 'origin' が設定されているか、ローカルのデフォルトブランチ名が \"main\" と一致するか確認すること。一致しない場合は create-worktree 内の main フォールバック値を実際のデフォルトブランチ名に書き換える必要がある。"
    exit 1
  fi

  # BASE_REF は解決できる。ここから先の失敗理由は git 自身しか知らないので、出力を
  # 捨てずに捕捉して利用者に渡す。標準出力は出力契約専用なので、捕捉した出力は
  # 成功時・失敗時とも標準エラーへ出す（既存ブランチ側の分岐と行き先を揃える）。
  worktree_add_output=""
  if ! worktree_add_output="$(git worktree add "$WORKTREE_DIR" -b "$BRANCH" "$BASE_REF" 2>&1)"; then
    err "ワークツリーの作成に失敗した: git worktree add \"$WORKTREE_DIR\" -b \"$BRANCH\" \"$BASE_REF\""
    err "BASE_REF ($BASE_REF) 自体は解決できているので、原因は起点の参照ではない。以下の git の出力を確認すること。"
    if [ -n "$worktree_add_output" ]; then
      printf '%s\n' "$worktree_add_output" >&2
    fi
    exit 1
  fi
  if [ -n "$worktree_add_output" ]; then
    printf '%s\n' "$worktree_add_output" >&2
  fi
fi

# .backlog/ は git 管理外なので worktree add では作られない。メインの作業木の
# .backlog/ へのシンボリックリンクにして、タスクデータを共有する。
if [ -e "$REPO_ROOT/.backlog" ] && [ ! -e "$WORKTREE_DIR/.backlog" ]; then
  ln -s "$REPO_ROOT/.backlog" "$WORKTREE_DIR/.backlog"
fi

# 除外行が末尾スラッシュ付きの ".backlog/" だと、上のシンボリックリンクはマッチせず
# ワークツリー内の git status が常に汚れて見える。スラッシュ無しは両方にマッチする。
grep -Fxq ".backlog" "$EXCLUDE_FILE" 2>/dev/null || echo ".backlog" >> "$EXCLUDE_FILE"

# ---- 占有記録 ----
# このワークツリーが「いつ・どのタスクに割り当てられたか」を記録する。新規作成・再利用の
# どちらの経路でも通るため、実行のたびに丸ごと上書きする（追記しない）。
# ASSIGNED_AT_EPOCH を併記するのは、ISO8601 文字列の解析が GNU date と BSD date で
# 割れるためで、鮮度の数値比較にはそちらを使う（読み手は check-progress-recovery）。
OCCUPANCY_FILE="$WORKTREE_DIR/.worktree-occupancy"
ASSIGNED_AT="$(date -u +%FT%TZ)"
ASSIGNED_AT_EPOCH="$(date -u +%s)"
{
  printf 'TASK_ID=%s\n' "$TASK_ID"
  printf 'ASSIGNED_AT=%s\n' "$ASSIGNED_AT"
  printf 'ASSIGNED_AT_EPOCH=%s\n' "$ASSIGNED_AT_EPOCH"
} > "$OCCUPANCY_FILE"

# .worktree-occupancy も .backlog と同様に git 管理外にする。
grep -Fxq ".worktree-occupancy" "$EXCLUDE_FILE" 2>/dev/null || echo ".worktree-occupancy" >> "$EXCLUDE_FILE"

# ---- 起点の鮮度検査 ----
# 既存のワークツリー/ブランチを再利用する経路（再引き渡し等）では BASE_REF が使われず、
# その後に進んだデフォルトブランチのコミットを含まないまま引き渡されうる。それを検知する。
# 含んでいるべき参照は、採用した起点（BASE_REF）と、auto_merge_reviewed: true のときは
# 採用しなかった側の候補（どちらのコミットも失いたくないため）。
STALE_REASONS=()
MISSING_LINES=()

BASE_COMMIT="$(git rev-parse --short "$BASE_REF" 2>/dev/null || true)"
if [ -z "$BASE_COMMIT" ]; then
  # 起点そのものを解決できない（リモートが消えた等）。比較自体ができない。
  BASE_COMMIT="N/A"
  STALE_REASONS+=("base_ref_unresolved")
  MISSING_LINES+=("MISSING_COMMITS=$BASE_REF:unknown")
fi

REQUIRED_REFS=("$BASE_REF")
if [ "$AUTO_MERGE_REVIEWED" -eq 1 ] && [ -n "$LOCAL_REF" ] && [ -n "$ORIGIN_REF" ]; then
  for candidate_ref in "$LOCAL_REF" "$ORIGIN_REF"; do
    if [ "$candidate_ref" != "$BASE_REF" ]; then
      REQUIRED_REFS+=("$candidate_ref")
    fi
  done
fi

for required_ref in "${REQUIRED_REFS[@]}"; do
  if ! git rev-parse --verify --quiet "$required_ref^{commit}" >/dev/null; then
    continue   # 解決できない参照は上の BASE_COMMIT 判定で扱い済み
  fi
  if git merge-base --is-ancestor "$required_ref" "refs/heads/$BRANCH"; then
    continue
  fi
  missing_count="$(git rev-list --count "refs/heads/$BRANCH..$required_ref" 2>/dev/null || echo "unknown")"
  MISSING_LINES+=("MISSING_COMMITS=$required_ref:$missing_count")
  if [ "$required_ref" = "$BASE_REF" ]; then
    STALE_REASONS+=("reused_branch_behind_base")
  elif [ "$DIVERGED_DEFAULT_BRANCH" -eq 1 ]; then
    STALE_REASONS+=("diverged_default_branch")
  else
    STALE_REASONS+=("branch_behind_default_branch")
  fi
done

if [ "${#MISSING_LINES[@]}" -eq 0 ]; then
  printf 'RESULT: OK\n'
else
  printf 'RESULT: STALE_BASE\n'
fi
printf 'BASE_REF=%s\n' "$BASE_REF"
printf 'BASE_COMMIT=%s\n' "$BASE_COMMIT"
if [ "${#STALE_REASONS[@]}" -gt 0 ]; then
  printf 'STALE_REASON=%s\n' "${STALE_REASONS[@]}"
fi
if [ "${#MISSING_LINES[@]}" -gt 0 ]; then
  printf '%s\n' "${MISSING_LINES[@]}"
fi
# 失効した除外行の検知結果。引き渡しを止める理由にはならず STALE_BASE と同時にも
# 成立しうるので、RESULT: の値には載せない。
if [ "${#STALE_EXCLUDE_LINES[@]}" -gt 0 ]; then
  printf '%s\n' "${STALE_EXCLUDE_LINES[@]}"
fi

echo "WORKTREE_DIR=$WORKTREE_DIR"
echo "BRANCH=$BRANCH"
