#!/usr/bin/env bash
# improvement-dispatch 手順4（次に引き渡す To Do タスクの選定）を決定論的に行う。
#
# 使い方: select-next-task <max_in_progress> <max_in_review>
# 引数はどちらも0以上の整数で、.backlog/config.my.yml の improvement_loop の
# 同名キー（既定 1 / 3）を SKILL.md 手順1 で読んだ値をそのまま渡す。
#
# 前提: カレントディレクトリが backlog CLI の対象リポジトリであること
# （対象リポジトリのパスを引数では受け取らない）。
#
# 選定の順序:
#   1. In Progress・In Review がそれぞれ上限以上なら選定せず GATED で終わる。
#   2. To Do のうち blocked:needs-decision ラベルが付いたものを除外する。
#   3. Dependencies の依存タスクが1つでも Done でないものを除外する
#      （依存タスクが見つからない場合も安全側に倒して未完了扱い）。
#   4. 残りを優先度（High→Medium→Low→未設定）→数値ID昇順で並べ先頭を選ぶ。
#      backlog CLI の --sort（未文書化の tie-break に依存する）には頼らない。
#
# 出力: 標準出力の1行目に必ず RESULT: <値> を出す。
#   RESULT: SELECTED      2行目に TASK_ID: <ID>
#   RESULT: GATED         2行目に REASON: max_in_progress|max_in_review、3行目以降に件数
#   RESULT: NO_CANDIDATE  除外後に残る候補が無い
#   RESULT: ERROR         引数不正・backlog コマンド不在など（詳細は標準エラー）
#
# 終了ステータス: 0=SELECTED, 1=GATED, 2=NO_CANDIDATE, 3=ERROR

set -euo pipefail

err() {
  printf 'エラー: %s\n' "$*" >&2
}

result_error() {
  err "$1"
  printf 'RESULT: ERROR\n'
  exit 3
}

if ! command -v backlog >/dev/null 2>&1; then
  result_error "backlog コマンドが見つからない"
fi

if [ "$#" -ne 2 ]; then
  result_error "使い方: select-next-task <max_in_progress> <max_in_review>"
fi

MAX_IN_PROGRESS="$1"
MAX_IN_REVIEW="$2"

case "$MAX_IN_PROGRESS" in
  ''|*[!0-9]*) result_error "max_in_progress は0以上の整数で指定すること: $MAX_IN_PROGRESS" ;;
esac
case "$MAX_IN_REVIEW" in
  ''|*[!0-9]*) result_error "max_in_review は0以上の整数で指定すること: $MAX_IN_REVIEW" ;;
esac

# ---- 0. ID抽出ヘルパー ----
# `backlog task list --plain` のタスク行は "  [PRIORITY] [type] <ID> - <title>"
# （先頭のタグは0個以上）。ID の接頭辞は .backlog/config.yml の task_prefix 次第で
# "TASK-" とは限らないため固定パターンでは抽出しない。一方、行のどこかにある
# ID らしき文字列を無条件に拾うと title 中の "TASK-999" まで誤検出する。そこで
# 行頭の空白・タグ群を取り除いた直後の "<接頭辞>-<n> - " だけを ID として採用する
# （bin/setup-improvement-loop の migrate_reviewed_tasks と同じ正規表現）。
#
# $1 = タスク行。マッチすれば ID を標準出力へ書く。
extract_task_id() {
  local line="$1"
  local stripped
  stripped="$(printf '%s\n' "$line" | sed -E 's/^[[:space:]]+(\[[^]]*\][[:space:]]*)*//')"
  if printf '%s\n' "$stripped" | grep -qE '^[A-Za-z][A-Za-z0-9_-]*-[0-9]+ - '; then
    printf '%s\n' "$stripped" | sed -E 's/^([A-Za-z][A-Za-z0-9_-]*-[0-9]+) - .*/\1/'
  fi
}

# $1 = task list の出力。タスク行の件数を数える（見出し行や "No tasks found." は
# マッチしないので数えられない）。
count_task_lines() {
  local output="$1"
  printf '%s\n' "$output" \
    | sed -E 's/^[[:space:]]+(\[[^]]*\][[:space:]]*)*//' \
    | grep -cE '^[A-Za-z][A-Za-z0-9_-]*-[0-9]+ - ' || true
}

# フィルタ無しの `backlog task list --plain` は、1件以上あるステータスについてのみ
# "<Status>:" という見出し行（行頭に空白が無くコロンで終わる）を出し、その直後に
# インデントされたタスク行を次の見出しまで並べる。--status 違いで複数回呼ぶ代わりに、
# この1回の出力からセクションを切り出して backlog CLI の起動コストを1回に抑える。
#
# $1 = 全出力、$2 = 見出し文字列（コロン無し。例: "In Progress"）。
# 該当セクションのタスク行を出す（見出し行自体は含まない）。無ければ何も出さない。
extract_status_section() {
  local full_output="$1"
  local heading="$2:"
  printf '%s\n' "$full_output" | awk -v heading="$heading" '
    $0 == heading { in_section = 1; next }
    in_section && /^[^[:space:]].*:$/ { in_section = 0 }
    in_section { print }
  '
}

# ---- 1. 1回の呼び出しで In Progress / In Review / To Do をまとめて取得する ----
# 代入単体で失敗させると、set -e が RESULT: 行を出さないままスクリプトを終わらせ、
# 「1行目に必ず RESULT: を出す」という出力契約を破る。`if ! var="$(cmd)"` の形にして
# 必ず result_error（RESULT: ERROR, exit 3）に倒す。
if ! all_output="$(backlog task list --plain)"; then
  result_error 'backlog task list --plain が失敗した'
fi

in_progress_output="$(extract_status_section "$all_output" "In Progress")"
in_progress_count="$(count_task_lines "$in_progress_output")"

in_review_output="$(extract_status_section "$all_output" "In Review")"
in_review_count="$(count_task_lines "$in_review_output")"

if [ "$in_progress_count" -ge "$MAX_IN_PROGRESS" ]; then
  printf 'RESULT: GATED\n'
  printf 'REASON: max_in_progress\n'
  printf 'IN_PROGRESS_COUNT: %s\n' "$in_progress_count"
  printf 'MAX_IN_PROGRESS: %s\n' "$MAX_IN_PROGRESS"
  exit 1
fi

if [ "$in_review_count" -ge "$MAX_IN_REVIEW" ]; then
  printf 'RESULT: GATED\n'
  printf 'REASON: max_in_review\n'
  printf 'IN_REVIEW_COUNT: %s\n' "$in_review_count"
  printf 'MAX_IN_REVIEW: %s\n' "$MAX_IN_REVIEW"
  exit 1
fi

# ---- 2. To Do 候補と blocked:needs-decision の除外集合を取得する ----
# blocked:needs-decision の除外集合だけは --labels フィルタが要るので、
# ここでもう1回だけ backlog を呼ぶ。
todo_output="$(extract_status_section "$all_output" "To Do")"
if ! blocked_output="$(backlog task list --status "To Do" --labels 'blocked:needs-decision' --plain)"; then
  result_error "backlog task list --status \"To Do\" --labels 'blocked:needs-decision' --plain が失敗した"
fi

BLOCKED_IDS=()
while IFS= read -r line; do
  id="$(extract_task_id "$line")"
  if [ -n "$id" ]; then
    BLOCKED_IDS+=("$id")
  fi
done <<< "$blocked_output"

# is_blocked / has_incomplete_dependency は `if is_blocked ...; then` のように
# if の条件式として呼ぶ前提である。bash は条件式として評価されるコマンドの本体には
# set -e を適用しないので、関数内で非ゼロが返ってもスクリプト全体は落ちない。
# 戻り値を一旦変数に代入してから判定する形へ書き換えると、この抑制が効かなくなり
# 挙動が変わるので注意すること。
is_blocked() {
  local needle="$1"
  if [ "${#BLOCKED_IDS[@]}" -eq 0 ]; then
    return 1
  fi
  local item
  for item in "${BLOCKED_IDS[@]+"${BLOCKED_IDS[@]}"}"; do
    if [ "$item" = "$needle" ]; then
      return 0
    fi
  done
  return 1
}

# $1 = タスクID。依存タスクが1つでも Done でなければ真を返す（依存無しなら偽）。
# Status 行はグリフ付きだが、末尾が "Done" で終わるのは Done だけなので行末一致で
# 判定する。依存タスクが見つからない場合（Status 行自体が無い。この場合も
# backlog task view は exit 0 で返す）も安全側に倒して未完了扱いにする。
# view 自体の非ゼロ終了は上のコメントの通り set -e では検知できないため、
# result_error で明示的に ERROR へ倒す。
has_incomplete_dependency() {
  local task_id="$1"
  local view_output
  if ! view_output="$(backlog task view "$task_id" --plain)"; then
    result_error "backlog task view \"$task_id\" --plain が失敗した"
  fi
  local dep_line
  dep_line="$(printf '%s\n' "$view_output" | grep -m1 '^Dependencies:' || true)"
  if [ -z "$dep_line" ]; then
    return 1
  fi
  local deps_str="${dep_line#Dependencies:}"
  local dep_list=()
  IFS=',' read -ra dep_list <<< "$deps_str"
  local dep
  for dep in "${dep_list[@]+"${dep_list[@]}"}"; do
    dep="$(printf '%s' "$dep" | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//')"
    if [ -z "$dep" ]; then
      continue
    fi
    local dep_view
    if ! dep_view="$(backlog task view "$dep" --plain)"; then
      result_error "backlog task view \"$dep\" --plain が失敗した"
    fi
    local dep_status_line
    dep_status_line="$(printf '%s\n' "$dep_view" | grep -m1 '^Status:' || true)"
    case "$dep_status_line" in
      *Done) : ;;
      *) return 0 ;;
    esac
  done
  return 1
}

# $1 = HIGH|MEDIUM|LOW|NONE の優先度ランクを数値で返す（小さいほど優先度が高い）。
priority_rank() {
  case "$1" in
    HIGH) printf '0\n' ;;
    MEDIUM) printf '1\n' ;;
    LOW) printf '2\n' ;;
    *) printf '3\n' ;;
  esac
}

# ---- 3. 除外を適用しながら候補を集める ----
FINAL_IDS=()
FINAL_RANK=()

while IFS= read -r line; do
  task_id="$(extract_task_id "$line")"
  if [ -z "$task_id" ]; then
    continue
  fi
  if is_blocked "$task_id"; then
    continue
  fi
  if has_incomplete_dependency "$task_id"; then
    continue
  fi
  prio_token="$(printf '%s\n' "$line" | grep -oE '^[[:space:]]*\[(HIGH|MEDIUM|LOW)\]' | grep -oE 'HIGH|MEDIUM|LOW' || true)"
  rank="$(priority_rank "${prio_token:-NONE}")"
  FINAL_IDS+=("$task_id")
  FINAL_RANK+=("$rank")
done <<< "$todo_output"

if [ "${#FINAL_IDS[@]}" -eq 0 ]; then
  printf 'RESULT: NO_CANDIDATE\n'
  exit 2
fi

# ---- 4. 優先度→数値ID昇順で最良の1件を選ぶ ----
best_idx=0
i=1
while [ "$i" -lt "${#FINAL_IDS[@]}" ]; do
  if [ "${FINAL_RANK[$i]}" -lt "${FINAL_RANK[$best_idx]}" ]; then
    best_idx=$i
  elif [ "${FINAL_RANK[$i]}" -eq "${FINAL_RANK[$best_idx]}" ]; then
    # `##*-` で最後のハイフンまでを最長一致で取り除き、接頭辞の値を読まずに
    # 末尾の数値部分だけを取り出す（接頭辞は task_prefix によって変わる）。
    id_i="${FINAL_IDS[$i]##*-}"
    id_best="${FINAL_IDS[$best_idx]##*-}"
    if [ "$id_i" -lt "$id_best" ]; then
      best_idx=$i
    fi
  fi
  i=$((i + 1))
done

printf 'RESULT: SELECTED\n'
printf 'TASK_ID: %s\n' "${FINAL_IDS[$best_idx]}"
exit 0
