#!/usr/bin/env bash
# improvement-dispatch 手順4（次に引き渡す To Do タスクの選定）を決定論的に行う。
#
# 使い方: select-next-task <max_in_progress> <max_in_review>
# 引数はどちらも0以上の整数で、.backlog/config.my.yml の improvement_loop の
# 同名キー（既定 1 / 3）を SKILL.md 手順1 で読んだ値をそのまま渡す。
#
# 前提: カレントディレクトリが backlog CLI の対象リポジトリであること
# （対象リポジトリのパスを引数では受け取らない）。
#
# 選定の順序:
#   1. In Progress・In Review がそれぞれ上限以上なら選定せず GATED で終わる。
#   2. To Do のうち blocked:needs-decision ラベルが付いたものを除外する。
#   3. 直接依存のタスクが1つでも Done でないものを除外する
#      （依存タスクが見つからない場合も安全側に倒して未完了扱い）。
#      依存は backlog CLI 1.48.0 の "Dependencies:" 行と 1.53.0 の
#      "Dependency Graph:" の木の両形式から読む（list_direct_dependencies）。
#   4. 残りを優先度（High→Medium→Low→未設定）→数値ID昇順で並べ、先頭から
#      空き枠（max_in_progress − In Progress の件数）の数まで選ぶ。候補が空き枠より
#      少なければ候補をすべて選ぶ。
#      backlog CLI の --sort（未文書化の tie-break に依存する）には頼らない。
#      同じ呼び出しで選ぶタスク同士に依存があっても、依存先はまだ To Do で Done では
#      ないので、上の 3 で依存元は除外される（依存先が Done になった後の呼び出しで選ばれる）。
#   5. 4 の順に見ていく途中で、In Progress のタスク、またはこの呼び出しで先に選んだ候補と
#      modified_files（task view の "Modified files:" 行）が1件でも重なる候補は選ばず後回しにし、
#      枠を消費せずに次の候補を見る。相手が In Progress を抜けた後の呼び出しで通常どおり選ばれる。
#      パスは完全一致で比べる。modified_files が空のタスクは誰とも重ならないものとして扱う。
#      In Review 以降のタスクは相手にしない。枠が埋まった後の候補は重なりを調べない。
#
# 出力: 標準出力の1行目に必ず RESULT: <値> を出す。
#   RESULT: SELECTED      2行目以降に TASK_ID: <ID> を1件1行で、選んだ順（優先度→数値ID昇順）に出す。
#                         行数は 1 以上、空き枠の数以下（max_in_progress が 1 なら常に1行）。
#                         その後に 5 で後回しにした候補があれば DEFERRED 行（下記）を出す。
#   RESULT: GATED         2行目に REASON: max_in_progress|max_in_review、3行目以降に件数
#   RESULT: NO_CANDIDATE  除外後に残る候補が無い。候補がすべて 5 で後回しになった場合は
#                         2行目以降に DEFERRED 行を出す。
#   DEFERRED 行の形式: DEFERRED: <後回しにしたID> CONFLICTS_WITH: <相手のID> FILES: <重なったパス>[, <パス>...]
#                         相手が複数なら相手ごとに1行出す。後回しにした順（優先度→数値ID昇順）に並ぶ。
#   RESULT: ERROR         引数不正・backlog コマンド不在など（詳細は標準エラー）
#
# 終了ステータス: 0=SELECTED, 1=GATED, 2=NO_CANDIDATE, 3=ERROR

set -euo pipefail

err() {
  printf 'エラー: %s\n' "$*" >&2
}

result_error() {
  err "$1"
  printf 'RESULT: ERROR\n'
  exit 3
}

if ! command -v backlog >/dev/null 2>&1; then
  result_error "backlog コマンドが見つからない"
fi

if [ "$#" -ne 2 ]; then
  result_error "使い方: select-next-task <max_in_progress> <max_in_review>"
fi

MAX_IN_PROGRESS="$1"
MAX_IN_REVIEW="$2"

case "$MAX_IN_PROGRESS" in
  ''|*[!0-9]*) result_error "max_in_progress は0以上の整数で指定すること: $MAX_IN_PROGRESS" ;;
esac
case "$MAX_IN_REVIEW" in
  ''|*[!0-9]*) result_error "max_in_review は0以上の整数で指定すること: $MAX_IN_REVIEW" ;;
esac

# ---- 0. ID抽出ヘルパー ----
# `backlog task list --plain` のタスク行は "  [PRIORITY] [type] <ID> - <title>"
# （先頭のタグは0個以上）。ID の接頭辞は .backlog/config.yml の task_prefix 次第で
# "TASK-" とは限らないため固定パターンでは抽出しない。一方、行のどこかにある
# ID らしき文字列を無条件に拾うと title 中の "TASK-999" まで誤検出する。そこで
# 行頭の空白・タグ群を取り除いた直後の "<接頭辞>-<n> - " だけを ID として採用する
# （bin/setup-improvement-loop の migrate_reviewed_tasks と同じ正規表現）。
#
# $1 = タスク行。マッチすれば ID を標準出力へ書く。
extract_task_id() {
  local line="$1"
  local stripped
  stripped="$(printf '%s\n' "$line" | sed -E 's/^[[:space:]]+(\[[^]]*\][[:space:]]*)*//')"
  if printf '%s\n' "$stripped" | grep -qE '^[A-Za-z][A-Za-z0-9_-]*-[0-9]+ - '; then
    printf '%s\n' "$stripped" | sed -E 's/^([A-Za-z][A-Za-z0-9_-]*-[0-9]+) - .*/\1/'
  fi
}

# $1 = task list の出力。タスク行の件数を数える（見出し行や "No tasks found." は
# マッチしないので数えられない）。
count_task_lines() {
  local output="$1"
  printf '%s\n' "$output" \
    | sed -E 's/^[[:space:]]+(\[[^]]*\][[:space:]]*)*//' \
    | grep -cE '^[A-Za-z][A-Za-z0-9_-]*-[0-9]+ - ' || true
}

# フィルタ無しの `backlog task list --plain` は、1件以上あるステータスについてのみ
# "<Status>:" という見出し行（行頭に空白が無くコロンで終わる）を出し、その直後に
# インデントされたタスク行を次の見出しまで並べる。--status 違いで複数回呼ぶ代わりに、
# この1回の出力からセクションを切り出して backlog CLI の起動コストを1回に抑える。
#
# $1 = 全出力、$2 = 見出し文字列（コロン無し。例: "In Progress"）。
# 該当セクションのタスク行を出す（見出し行自体は含まない）。無ければ何も出さない。
extract_status_section() {
  local full_output="$1"
  local heading="$2:"
  printf '%s\n' "$full_output" | awk -v heading="$heading" '
    $0 == heading { in_section = 1; next }
    in_section && /^[^[:space:]].*:$/ { in_section = 0 }
    in_section { print }
  '
}

# ---- 1. 1回の呼び出しで In Progress / In Review / To Do をまとめて取得する ----
# 代入単体で失敗させると、set -e が RESULT: 行を出さないままスクリプトを終わらせ、
# 「1行目に必ず RESULT: を出す」という出力契約を破る。`if ! var="$(cmd)"` の形にして
# 必ず result_error（RESULT: ERROR, exit 3）に倒す。
if ! all_output="$(backlog task list --plain)"; then
  result_error 'backlog task list --plain が失敗した'
fi

in_progress_output="$(extract_status_section "$all_output" "In Progress")"
in_progress_count="$(count_task_lines "$in_progress_output")"

in_review_output="$(extract_status_section "$all_output" "In Review")"
in_review_count="$(count_task_lines "$in_review_output")"

if [ "$in_progress_count" -ge "$MAX_IN_PROGRESS" ]; then
  printf 'RESULT: GATED\n'
  printf 'REASON: max_in_progress\n'
  printf 'IN_PROGRESS_COUNT: %s\n' "$in_progress_count"
  printf 'MAX_IN_PROGRESS: %s\n' "$MAX_IN_PROGRESS"
  exit 1
fi

if [ "$in_review_count" -ge "$MAX_IN_REVIEW" ]; then
  printf 'RESULT: GATED\n'
  printf 'REASON: max_in_review\n'
  printf 'IN_REVIEW_COUNT: %s\n' "$in_review_count"
  printf 'MAX_IN_REVIEW: %s\n' "$MAX_IN_REVIEW"
  exit 1
fi

# ---- 2. To Do 候補と blocked:needs-decision の除外集合を取得する ----
# blocked:needs-decision の除外集合だけは --labels フィルタが要るので、
# ここでもう1回だけ backlog を呼ぶ。
todo_output="$(extract_status_section "$all_output" "To Do")"
if ! blocked_output="$(backlog task list --status "To Do" --labels 'blocked:needs-decision' --plain)"; then
  result_error "backlog task list --status \"To Do\" --labels 'blocked:needs-decision' --plain が失敗した"
fi

BLOCKED_IDS=()
while IFS= read -r line; do
  id="$(extract_task_id "$line")"
  if [ -n "$id" ]; then
    BLOCKED_IDS+=("$id")
  fi
done <<< "$blocked_output"

# is_blocked / has_incomplete_dependency は `if is_blocked ...; then` のように
# if の条件式として呼ぶ前提である。bash は条件式として評価されるコマンドの本体には
# set -e を適用しないので、関数内で非ゼロが返ってもスクリプト全体は落ちない。
# 戻り値を一旦変数に代入してから判定する形へ書き換えると、この抑制が効かなくなり
# 挙動が変わるので注意すること。
is_blocked() {
  local needle="$1"
  if [ "${#BLOCKED_IDS[@]}" -eq 0 ]; then
    return 1
  fi
  local item
  for item in "${BLOCKED_IDS[@]+"${BLOCKED_IDS[@]}"}"; do
    if [ "$item" = "$needle" ]; then
      return 0
    fi
  done
  return 1
}

# $1 = task view --plain の出力。直接依存を1行1件で標準出力へ書く。
# 存在しない・一意に決まらない依存は "?<ID>" の形で書く（呼び出し側が未完了扱いにする）。
# backlog CLI のバージョンで出力形式が違うため、次の2形式の両方を読む。
#   - 1.48.0（README.md 記載の動作確認済み最小バージョン）: "Dependencies: TASK-1, TASK-2" の1行。
#   - 1.53.0: "Dependency Graph:" セクション内の "Depends on (N direct, M total):" 見出しに
#     続く木。行頭が "├─ " / "└─ " の行が直接依存、インデント付きの行は推移的依存で読まない。
#     見出しの後、空行か次の見出し（"Dependents (...)" 等）で木が終わる。
#     木の各行の "[<状態>]" 表記（Done は "[completed]"）は使わず、完了判定は個別 view で行う。
#     存在しない依存は "└─ TASK-77 - unknown task ID"、同じ ID のファイルが複数ある依存は
#     "ambiguous task ID" と表示される（どちらも個別 view は exit 1 になる）。
#   どちらの形式も "Description:" 見出しより前（メタデータ部）に出る。説明文などの自由記述に
#   同じ見た目の行があっても拾わないよう、最初の "Description:" 行より前だけを読む。
list_direct_dependencies() {
  local view_output="$1"
  local header
  header="$(printf '%s\n' "$view_output" | awk '/^Description:$/ { exit } { print }')"
  local dep_line
  dep_line="$(printf '%s\n' "$header" | grep -m1 '^Dependencies:' || true)"
  if [ -n "$dep_line" ]; then
    local deps_str="${dep_line#Dependencies:}"
    local dep_list=()
    IFS=',' read -ra dep_list <<< "$deps_str"
    local dep
    for dep in "${dep_list[@]+"${dep_list[@]}"}"; do
      dep="$(printf '%s' "$dep" | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//')"
      if [ -n "$dep" ]; then
        printf '%s\n' "$dep"
      fi
    done
  fi
  # 木は最初の "Dependency Graph:" から次のセクション見出し（括弧を含まない "<英字>:" 行）
  # までに限り、そこで読むのをやめる。
  printf '%s\n' "$header" | awk '
    !in_graph && /^Dependency Graph:$/ { in_graph = 1; next }
    in_graph && /^[A-Za-z][A-Za-z ]*:$/ { exit }
    !in_graph { next }
    /^Depends on \(.*\):$/ { in_tree = 1; next }
    in_tree && /^(├─|└─) / {
      entry = $0
      sub(/^(├─|└─) /, "", entry)
      id = entry
      sub(/ .*/, "", id)
      if (id == "") { next }
      if (entry ~ / - (unknown|ambiguous) task ID$/) { print "?" id } else { print id }
      next
    }
    in_tree && /^[│ ]/ { next }
    in_tree { in_tree = 0 }
  '
}

# $1 = task view --plain の出力。タスクの modified_files を1行1件で標準出力へ書く（無ければ何も出さない）。
# 複数件は "Modified files: a.md, b/c.sh" と ", " 区切りの1行で出る。出る位置は CLI のバージョンで違う
# （bin/lib/notes_records.sh の冒頭コメントと同じ観察。tests/test_notes_records.sh のフィクスチャ）。
#   - 1.48.0: メタデータ部（最初の "Description:" 行より前）。
#   - 1.53.0: 本文の節の後。空行の後に "Modified files: ..." 行が来て、その後が出力の末尾か、
#     空行に続く Comments / Final Summary の節見出し（"<名前>:" とハイフン50個の組）である。
#     呼び出し側は $(...) で受けた（末尾の空行が削られた）出力を渡すので、その行が最終行の場合も受ける。
# 説明文などの自由記述に同じ見た目の行があっても拾わないよう、1.53.0 の形は
# Acceptance Criteria 節の見出し（CLI が生成する）より後で、上の並びに一致する最初の行だけを読む。
# Acceptance Criteria 節は項目が無くても必ず出る（bin/lib/notes_records.sh の入力の前提と同じ）。
# 出ない出力では 1.53.0 形式を読めず modified_files を空として扱う。重なりを検知しない側
# （従来どおり選ぶ側）に倒れるだけで、選定は止めない。実 CLI の形式の変化は
# tests/test_select_next_task.sh の 6e（実 CLI で重なりを検知できること）が検出する。
# 既知の限界: パスに ", " を含むと2件に割れる。実際の modified_files が空のタスクで、notes や
# Final Summary の末尾にちょうど上の並びの行を書くと、その行を modified_files として読む。
list_modified_files() {
  printf '%s\n' "$1" | LC_ALL=C awk '
    { line[NR] = $0 }
    function is_header(i, name) {
      return i < NR && line[i] == name && line[i + 1] == sep
    }
    function is_tail_header(i) {
      return is_header(i, "Comments:") || is_header(i, "Final Summary:")
    }
    function emit(s,    n, parts, k, v) {
      s = substr(s, length(prefix) + 1)
      n = split(s, parts, /, /)
      for (k = 1; k <= n; k++) {
        v = parts[k]
        sub(/^[ \t]+/, "", v)
        sub(/[ \t]+$/, "", v)
        if (v != "") { print v }
      }
    }
    END {
      sep = "--------------------------------------------------"
      prefix = "Modified files: "
      for (i = 1; i <= NR; i++) {
        if (line[i] == "Description:") { break }
        if (index(line[i], prefix) == 1) { emit(line[i]); exit }
      }
      seen_ac = 0
      for (i = 1; i <= NR; i++) {
        if (!seen_ac) {
          if (is_header(i, "Acceptance Criteria:")) { seen_ac = 1 }
          continue
        }
        if (line[i - 1] != "" || index(line[i], prefix) != 1) { continue }
        if (i == NR || (line[i + 1] == "" && (i + 1 == NR || is_tail_header(i + 2)))) {
          emit(line[i])
          exit
        }
      }
    }
  '
}

# $1 = タスクの task view --plain の出力。依存タスクが1つでも Done でなければ真を返す（依存無しなら偽）。
# Status 行はグリフ付きだが、末尾が "Done" で終わるのは Done だけなので行末一致で
# 判定する。依存タスクが見つからない場合は安全側に倒して未完了扱いにする。
# 1.53.0 は木に "unknown task ID"（一意に決まらなければ "ambiguous task ID"）と出すので
# それで判定し（個別 view は exit 1 になる）、
# 1.48.0 は個別 view が Status 行を持たない出力を exit 0 で返すのでそれで判定する。
# view 自体の非ゼロ終了は上のコメントの通り set -e では検知できないため、
# result_error で明示的に ERROR へ倒す。
has_incomplete_dependency() {
  local view_output="$1"
  local deps
  deps="$(list_direct_dependencies "$view_output")"
  local dep
  while IFS= read -r dep; do
    if [ -z "$dep" ]; then
      continue
    fi
    case "$dep" in
      '?'*) return 0 ;;
    esac
    local dep_view
    # この関数は候補一覧・依存一覧の here-string を標準入力とするループの中で呼ばれる。
    # backlog に読ませて残りを読み飛ばさないよう、view の標準入力は塞ぐ（上の view も同じ）。
    if ! dep_view="$(backlog task view "$dep" --plain </dev/null)"; then
      result_error "backlog task view \"$dep\" --plain が失敗した"
    fi
    local dep_status_line
    dep_status_line="$(printf '%s\n' "$dep_view" | grep -m1 '^Status:' || true)"
    case "$dep_status_line" in
      *Done) : ;;
      *) return 0 ;;
    esac
  done <<< "$deps"
  return 1
}

# $1 = HIGH|MEDIUM|LOW|NONE の優先度ランクを数値で返す（小さいほど優先度が高い）。
priority_rank() {
  case "$1" in
    HIGH) printf '0\n' ;;
    MEDIUM) printf '1\n' ;;
    LOW) printf '2\n' ;;
    *) printf '3\n' ;;
  esac
}

# ---- 3. 除外を適用しながら候補を集める ----
# 候補の view は依存確認と modified_files の読み取りで共有し、1候補1回に抑える。
# FINAL_FILES[i] は FINAL_IDS[i] の modified_files を改行区切りで持つ（無ければ空文字列）。
FINAL_IDS=()
FINAL_RANK=()
FINAL_FILES=()
any_candidate_files=0

while IFS= read -r line; do
  task_id="$(extract_task_id "$line")"
  if [ -z "$task_id" ]; then
    continue
  fi
  if is_blocked "$task_id"; then
    continue
  fi
  # この view は To Do 一覧の here-string を標準入力とするループの中で呼ぶので、標準入力は塞ぐ。
  if ! view_output="$(backlog task view "$task_id" --plain </dev/null)"; then
    result_error "backlog task view \"$task_id\" --plain が失敗した"
  fi
  if has_incomplete_dependency "$view_output"; then
    continue
  fi
  prio_token="$(printf '%s\n' "$line" | grep -oE '^[[:space:]]*\[(HIGH|MEDIUM|LOW)\]' | grep -oE 'HIGH|MEDIUM|LOW' || true)"
  rank="$(priority_rank "${prio_token:-NONE}")"
  files="$(list_modified_files "$view_output")"
  if [ -n "$files" ]; then
    any_candidate_files=1
  fi
  FINAL_IDS+=("$task_id")
  FINAL_RANK+=("$rank")
  FINAL_FILES+=("$files")
done <<< "$todo_output"

if [ "${#FINAL_IDS[@]}" -eq 0 ]; then
  printf 'RESULT: NO_CANDIDATE\n'
  exit 2
fi

# ---- 4. 変更先の重なりを避けながら、優先度→数値ID昇順で空き枠の数まで選ぶ ----
# 1 の GATED 判定を通っているので空き枠は 1 以上である。
free_slots=$((MAX_IN_PROGRESS - in_progress_count))

# 「ランク<TAB>数値ID<TAB>添字」の行を数値で2段ソートし、添字の順を得る。数値IDは `##*-` で最後の
# ハイフンまでを最長一致で取り除き、接頭辞の値を読まずに末尾の数値部分だけを取り出す
# （接頭辞は task_prefix によって変わる）。
ORDER=()
while IFS= read -r idx; do
  ORDER+=("$idx")
done < <(
  i=0
  while [ "$i" -lt "${#FINAL_IDS[@]}" ]; do
    printf '%s\t%s\t%s\n' "${FINAL_RANK[$i]}" "${FINAL_IDS[$i]##*-}" "$i"
    i=$((i + 1))
  done | sort -t "$(printf '\t')" -k1,1n -k2,2n -k3,3n | cut -f3
)

# 変更先の重なりの相手。In Progress のタスクと、この呼び出しで先に選んだ候補である。
# OCCUPIED_IDS[j] の modified_files を OCCUPIED_FILES[j] に改行区切りで持つ。
# 同じファイルを変える作業ブランチを同時に進めると、後からマージする方が衝突しやすいため、
# 重なる候補は相手が In Progress を抜けるまで後回しにする。In Review の相手は待たない。
# modified_files が空のタスクは変更先が分からないので、誰とも重ならないものとして扱う。
# どの候補にも modified_files が無ければ重なりは起こらないので、In Progress の view は省く。
OCCUPIED_IDS=()
OCCUPIED_FILES=()
if [ "$any_candidate_files" -eq 1 ]; then
  while IFS= read -r line; do
    ip_id="$(extract_task_id "$line")"
    if [ -z "$ip_id" ]; then
      continue
    fi
    if ! ip_view="$(backlog task view "$ip_id" --plain </dev/null)"; then
      result_error "backlog task view \"$ip_id\" --plain が失敗した"
    fi
    OCCUPIED_IDS+=("$ip_id")
    OCCUPIED_FILES+=("$(list_modified_files "$ip_view")")
  done <<< "$in_progress_output"
fi

# $1・$2 = 改行区切りのファイル一覧。両方に現れるファイルを ", " 区切りで標準出力へ書く（無ければ空）。
overlapping_files() {
  local a="$1" b="$2" out="" f g
  [ -n "$a" ] && [ -n "$b" ] || return 0
  while IFS= read -r f; do
    while IFS= read -r g; do
      if [ "$f" = "$g" ]; then
        out="${out:+$out, }$f"
        break
      fi
    done <<< "$b"
  done <<< "$a"
  printf '%s' "$out"
}

SELECTED=()
DEFERRED_LINES=()
for idx in "${ORDER[@]}"; do
  if [ "${#SELECTED[@]}" -ge "$free_slots" ]; then
    # 枠が埋まった後の候補は重なりに関係なく今回は選ばれないので、後回しの報告にも載せない。
    break
  fi
  cand_files="${FINAL_FILES[$idx]}"
  deferred=0
  j=0
  while [ "$j" -lt "${#OCCUPIED_IDS[@]}" ]; do
    overlap="$(overlapping_files "$cand_files" "${OCCUPIED_FILES[$j]}")"
    if [ -n "$overlap" ]; then
      DEFERRED_LINES+=("DEFERRED: ${FINAL_IDS[$idx]} CONFLICTS_WITH: ${OCCUPIED_IDS[$j]} FILES: $overlap")
      deferred=1
    fi
    j=$((j + 1))
  done
  if [ "$deferred" -eq 1 ]; then
    continue
  fi
  SELECTED+=("${FINAL_IDS[$idx]}")
  OCCUPIED_IDS+=("${FINAL_IDS[$idx]}")
  OCCUPIED_FILES+=("$cand_files")
done

if [ "${#SELECTED[@]}" -eq 0 ]; then
  printf 'RESULT: NO_CANDIDATE\n'
else
  printf 'RESULT: SELECTED\n'
  for id in "${SELECTED[@]}"; do
    printf 'TASK_ID: %s\n' "$id"
  done
fi
for deferred_line in "${DEFERRED_LINES[@]+"${DEFERRED_LINES[@]}"}"; do
  printf '%s\n' "$deferred_line"
done
if [ "${#SELECTED[@]}" -eq 0 ]; then
  exit 2
fi
exit 0
