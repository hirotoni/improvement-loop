#!/usr/bin/env bash
# .backlog/config.my.yml の improvement_loop.forbidden_paths /
# improvement_loop.allowed_paths と、引数で渡された変更ファイルパスの一覧を
# 突き合わせ、違反の有無を決定論的に判定する。
#
# 使い方:
#   check-forbidden-allowed-paths <changed-file>...
#   例: check-forbidden-allowed-paths $(git diff --name-only main...HEAD)
#
# <changed-file> はリポジトリルート相対（git diff --name-only と同じ形式）。
# 先頭の "./" は取り除いてから判定する。0個なら常に RESULT: OK で終わる。
#
# 前提: カレントディレクトリが対象リポジトリの中であること。設定はそのリポジトリ
# ルート直下の .backlog/config.my.yml から読む（ワークツリーからは .backlog
# シンボリックリンク経由でメインの作業木の実体を読むため、判定結果は変わらない）。
#
# 判定ロジック:
#   - forbidden_paths のいずれかに前方一致すれば違反。
#   - allowed_paths が1件以上あり、そのいずれにも前方一致しなければ違反。
#   - 両方設定されていれば両方適用する（allowed の範囲内かつ forbidden に無いもののみ許可）。
#   - 両方空、キーが無い、または config.my.yml 自体が無ければ常に許可。
#   - 値はインライン配列（key: ["a", "b"]）と複数行YAMLリストの両方を受け付ける。
#   - それ以外の記法（クォート無しスカラー、閉じない "["、マッピング等）は
#     RESULT: ERROR にする。ここは機械的な唯一のバックストップなので、認識できない
#     記法を空配列（＝無制限）へ黙ってフォールバックさせない。
#
# 【判定が及ぶ範囲・及ばない範囲】
# このスクリプトは渡されたパスだけを見て、それが git の追跡対象かどうかは判定しない。
# 死角があるのは変更ファイル一覧の作り方の側で、呼び出し側2箇所（improvement-work
# 手順8 の git diff --cached、improvement-dispatch 手順6 の3ドット diff）はいずれも
# git の差分から一覧を作る。したがって git 管理外のパスは一覧に現れず、forbidden_paths
# に書いても機械的には止まらない（引き渡しプロンプト上の指示としてのみ効く）。
# 具体的には .backlog/ 配下（forbidden_paths を書く config.my.yml 自身を含む）、
# .claude/skills/<スキル名> 配下、.git/ 配下である。
# 同じ限界が backlog-md/config.my.yml の当該キーのコメントにも書かれている。
# 設定する人が「保護されたつもりで素通りする」誤解を避けるためなので、
# 片方だけ書き換えず同期させて保つこと（tests/test_check_forbidden_allowed_paths.sh の 14r）。
#
# 出力: 標準出力に次を出す（最終行が RESULT）。
#   RESULT: OK         違反なし
#   RESULT: VIOLATION  違反あり。手前に VIOLATION_COUNT: <件数> と
#                      VIOLATING_FILES: に続けて違反パスを1行1件で出す
#   RESULT: ERROR      環境不備、またはサポート対象外の記法（詳細は標準エラー）
# 終了ステータス: 0=OK, 1=VIOLATION, 2=ERROR
#
# 責務外: 判定結果に基づく対応（差し戻す・警告する等）と backlog タスクの状態変更。
# 変更ファイル一覧の作成も呼び出し元の責務であり、自分で変更を探しにいかない。

set -uo pipefail

err() {
  printf 'エラー: %s\n' "$*" >&2
}

result_error() {
  err "$1"
  printf 'RESULT: ERROR\n'
  exit 2
}

# bin/lib/yaml_unquote.sh を source するために、まず自分自身の実パスから配布元
# リポジトリのルートを解決する（`.claude/skills/improvement-dispatch` シンボリック
# リンク経由で実行されうるため、BASH_SOURCE をそのまま使えない）。
# ここで求める DIST_REPO_ROOT（配布元）は、下の REPO_ROOT（判定対象）とは別物である。
_bootstrap_resolve_own_path() {
  if command -v realpath >/dev/null 2>&1; then
    realpath "$1"
  elif readlink -f "$1" >/dev/null 2>&1; then
    readlink -f "$1"
  else
    local dir base
    dir="$(cd "$(dirname "$1")" && pwd -P)"
    base="$(basename "$1")"
    printf '%s/%s\n' "$dir" "$base"
  fi
}
SCRIPT_SOURCE="$(_bootstrap_resolve_own_path "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_SOURCE")" && pwd)"
# SCRIPT_DIR は <配布元>/claude-code/skills/improvement-dispatch/scripts。4階層上がルート。
DIST_REPO_ROOT="$(cd "$SCRIPT_DIR/../../../.." && pwd)"

# shellcheck source=../../../../bin/lib/yaml_unquote.sh
source "$DIST_REPO_ROOT/bin/lib/yaml_unquote.sh"

if ! REPO_ROOT="$(git rev-parse --show-toplevel 2>&1)"; then
  result_error "カレントディレクトリが git リポジトリの中ではない: $REPO_ROOT"
fi

CONFIG_FILE="$REPO_ROOT/.backlog/config.my.yml"

# $1 = キー名（forbidden_paths | allowed_paths）。CONFIG_FILE から値を読み、
# 要素を1行1件で標準出力に出す。キーが無い・値が空・ファイルが無い場合は
# 何も出さずに 0 で終わる（＝呼び出し側で空配列扱い）。
# 戻り値 1 はサポート対象外の記法。呼び出し側はこれを RESULT: ERROR として
# 扱うこと（空配列へフォールバックしない。理由は冒頭の判定ロジックを参照）。
parse_path_list() {
  local key="$1"
  if [ ! -f "$CONFIG_FILE" ]; then
    return 0
  fi
  local line_num
  line_num="$(grep -n -m1 -E "^[[:space:]]*${key}:" "$CONFIG_FILE" | cut -d: -f1 || true)"
  if [ -z "$line_num" ]; then
    return 0
  fi
  local line
  line="$(sed -n "${line_num}p" "$CONFIG_FILE")"
  local rest="${line#*:}"
  rest="${rest%%#*}"

  if [[ "$rest" =~ \[(.*)\] ]]; then
    # インライン配列形式（例: key: ["secrets/", "vendor/"]）。
    local inner="${BASH_REMATCH[1]}"
    if [ -z "${inner//[[:space:]]/}" ]; then
      return 0
    fi
    local items=()
    IFS=',' read -ra items <<<"$inner"
    local raw_item trimmed
    for raw_item in "${items[@]}"; do
      trimmed="$(trim_and_unquote "$raw_item")"
      if [ -n "$trimmed" ]; then
        printf '%s\n' "$trimmed"
      fi
    done
    return 0
  fi

  local rest_trimmed
  rest_trimmed="$(trim_and_unquote "$rest")"
  if [ -n "$rest_trimmed" ]; then
    # "[" が無いのに key: の後に値がある＝どちらの記法でもない（壊れたYAML等）。
    err "${key}: の値がサポート対象外の記法（インライン配列 [...] でも、複数行YAMLリストでもない）: ${line}"
    return 1
  fi

  # 複数行YAMLリスト形式（key: の直後から連続する "  - ..." 行を集める）。
  # "-" 始まりの行が続かなければ空配列として扱う。
  local total_lines next_line_num list_line item
  total_lines="$(awk 'END { print NR }' "$CONFIG_FILE")"
  next_line_num=$((line_num + 1))
  while [ "$next_line_num" -le "$total_lines" ]; do
    list_line="$(sed -n "${next_line_num}p" "$CONFIG_FILE")"
    if ! printf '%s' "$list_line" | grep -Eq '^[[:space:]]*-'; then
      break
    fi
    item="${list_line#*-}"
    item="${item%%#*}"
    item="$(trim_and_unquote "$item")"
    if [ -n "$item" ]; then
      printf '%s\n' "$item"
    fi
    next_line_num=$((next_line_num + 1))
  done
  return 0
}

# process substitution 経由だと parse_path_list の戻り値（サポート対象外記法の
# 検知）を拾えないため、コマンド置換で出力と終了ステータスの両方を捕捉する。
FORBIDDEN_RAW="$(parse_path_list forbidden_paths)"
FORBIDDEN_STATUS=$?
if [ "$FORBIDDEN_STATUS" -ne 0 ]; then
  result_error "forbidden_paths の値を読み取れない（詳細は上記のエラーメッセージ参照）"
fi
FORBIDDEN=()
if [ -n "$FORBIDDEN_RAW" ]; then
  while IFS= read -r p; do
    FORBIDDEN+=("$p")
  done <<<"$FORBIDDEN_RAW"
fi

ALLOWED_RAW="$(parse_path_list allowed_paths)"
ALLOWED_STATUS=$?
if [ "$ALLOWED_STATUS" -ne 0 ]; then
  result_error "allowed_paths の値を読み取れない（詳細は上記のエラーメッセージ参照）"
fi
ALLOWED=()
if [ -n "$ALLOWED_RAW" ]; then
  while IFS= read -r p; do
    ALLOWED+=("$p")
  done <<<"$ALLOWED_RAW"
fi

# $1 = 判定対象パス、以降 = プレフィックスの列。いずれか1つにでも前方一致
# すれば真を返す。
matches_any_prefix() {
  local path="$1"
  shift
  local prefix
  for prefix in "$@"; do
    case "$path" in
      "$prefix"*) return 0 ;;
    esac
  done
  return 1
}

VIOLATING_FILES=()
for raw_file in "$@"; do
  file="${raw_file#./}"
  if [ -z "$file" ]; then
    continue
  fi
  is_violation=0
  if [ "${#FORBIDDEN[@]}" -gt 0 ] && matches_any_prefix "$file" "${FORBIDDEN[@]}"; then
    is_violation=1
  fi
  if [ "$is_violation" -eq 0 ] && [ "${#ALLOWED[@]}" -gt 0 ] && ! matches_any_prefix "$file" "${ALLOWED[@]}"; then
    is_violation=1
  fi
  if [ "$is_violation" -eq 1 ]; then
    VIOLATING_FILES+=("$file")
  fi
done

if [ "${#VIOLATING_FILES[@]}" -eq 0 ]; then
  printf 'RESULT: OK\n'
  exit 0
fi

printf 'VIOLATION_COUNT: %s\n' "${#VIOLATING_FILES[@]}"
printf 'VIOLATING_FILES:\n'
for f in "${VIOLATING_FILES[@]}"; do
  printf '%s\n' "$f"
done
printf 'RESULT: VIOLATION\n'
exit 1
