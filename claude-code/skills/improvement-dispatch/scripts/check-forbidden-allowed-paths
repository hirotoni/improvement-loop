#!/usr/bin/env bash
# claude-code/skills/improvement-dispatch/scripts/check-forbidden-allowed-paths
#
# .backlog/config.my.yml の improvement_loop.forbidden_paths /
# improvement_loop.allowed_paths と、変更されたファイルパスの一覧を突き合わせ、
# 違反の有無を決定論的に判定する。claude-code/skills/improvement-dispatch/SKILL.md
# 36-41行目・253行目にはこの設定の仕様が書かれているが、これまでは
# 「AIエージェントへの指示としてのみ機能し、変更を機械的に拒否・検知する
# 仕組みではない」ものだった（強制の実装はTASK-44の範囲外と明記されている）。
# このスクリプトは、その機械的な突き合わせ判定だけを切り出したものであり、
# 判定結果をどう使うか（差し戻す・警告する等、improvement-work・
# improvement-dispatch への組み込み）は別タスクの範囲である。
#
# 使い方:
#   claude-code/skills/improvement-dispatch/scripts/check-forbidden-allowed-paths \
#     <changed-file>...
#
#   例（変更ファイル一覧を git diff から渡す）:
#     claude-code/skills/improvement-dispatch/scripts/check-forbidden-allowed-paths \
#       $(git diff --name-only main...HEAD)
#
# 引数:
#   <changed-file>...  変更されたファイルパス（リポジトリルート相対、
#                       git diff --name-only と同じ形式）を0個以上並べる。
#                       各パスの先頭の "./" は取り除いてから判定する。0個の
#                       場合は突き合わせ対象が無いため常に無違反（RESULT: OK）
#                       で終わる。
#
# 前提: カレントディレクトリが対象リポジトリの中であること（git
# rev-parse --show-toplevel で解決できること）。.backlog/config.my.yml は
# そのリポジトリルート直下から読む（ワークツリーの場合は .backlog
# シンボリックリンク経由でメインの作業木の実体ファイルを指すため、
# ワークツリー内から実行しても同じ設定を読む）。
#
# 判定ロジック（.backlog/config.my.yml の forbidden_paths / allowed_paths の
# コメントに記載されている仕様どおり）:
#   - forbidden_paths が1件以上あり、変更ファイルがそのいずれかに前方一致
#     すれば違反。
#   - allowed_paths が1件以上あり、変更ファイルがそのいずれにも前方一致
#     しなければ違反。
#   - 両方設定されている場合は上記の両方の条件を適用する
#     （＝「allowed_paths の範囲内、かつ forbidden_paths に無いパス」だけを
#     許可する）。
#   - forbidden_paths / allowed_paths が両方とも空、キー自体が無い、または
#     .backlog/config.my.yml 自体が無い場合は、常に許可（違反なし）とする。
#   - forbidden_paths / allowed_paths の値は、次の2形式をサポートする
#     （TASK-56。bin/setup-improvement-loop の parse_statuses_block と
#     同じ考え方で、.backlog/config.yml の statuses キーと足並みを揃えた）。
#       - インライン配列: forbidden_paths: ["secrets/", "vendor/"]
#       - 複数行YAMLリスト:
#           forbidden_paths:
#             - "secrets/"
#             - "vendor/"
#     どちらの形式でも、書いた要素は同じように配列として読み取られる。
#   - 上記いずれの形式でもない値（クォート無しの単一パス文字列のような
#     スカラー値、閉じ括弧の無い "[" 、マッピング等の壊れたYAML）が来た
#     場合は「サポート対象外の記法」として RESULT: ERROR にする
#     （安全側に倒す）。forbidden_paths/
#     allowed_paths はAIエージェントの変更を機械的に止める唯一の
#     バックストップであり、認識できない記法を空配列（＝無制限）へ黙って
#     フォールバックすると、本タスクが修正した不具合
#     （複数行YAMLリストが無音で無制限扱いになっていた）と同じ種類の
#     問題を再現してしまうため、エラーとして検知する方針を採った。
#   - 各要素の引用符除去（シングル/ダブル対称）は bin/lib/yaml_unquote.sh の
#     trim_and_unquote() を使う（TASK-62。以前はこのファイル内に同じ内容の
#     関数を独立定義しており、bin/setup-improvement-loop の
#     parse_statuses_block 側のダブルクォート限定の実装との食い違いが
#     不具合の原因だったため、唯一の定義に集約した）。
#
# 【この判定が及ぶ範囲・及ばない範囲】(TASK-69)
# このスクリプトは引数で渡されたパスだけを判定する。そのパスが git の追跡対象か
# どうかは一切見ないため、git 管理外のパスであっても、引数として渡されれば
# forbidden_paths / allowed_paths と同じように突き合わせて違反として検知する。
# 死角があるのは判定側ではなく、変更ファイル一覧の作り方の側である。呼び出し側は
# 2箇所とも一覧を git の差分から作っている。
#   - claude-code/skills/improvement-work/SKILL.md 手順8:
#       git diff --name-only --cached
#   - claude-code/skills/improvement-dispatch/SKILL.md 手順6:
#       git diff <デフォルトブランチ>...<作業ブランチ> --name-only
# git 管理外のパスはこの差分に一度も現れない。したがって次のパスは、
# forbidden_paths に書いても機械的には止まらず、引き渡しプロンプトに書かれる
# AIエージェントへの指示としてのみ効く。bin/setup-improvement-loop の手順6が
# 導入先の .git/info/exclude に登録するためである。
#   - .backlog/ 配下（forbidden_paths / allowed_paths を書く config.my.yml 自身を
#     含む。エージェントを縛るポリシーそのものの書き換えが検知されない）
#   - .claude/skills/<スキル名> 配下（配布元リポジトリの実体へのシンボリック
#     リンク。書き換えると配布元が変わり、同じ配布元を共有する他の導入先
#     リポジトリにも波及するが、導入先の git 差分には現れない）
#   - .git/ 配下（.git/info/exclude 自身を含む。そもそも追跡対象にならない）
# この限界は .backlog/config.my.yml（配布元テンプレートは
# backlog-md/config.my.yml）の forbidden_paths / allowed_paths の
# コメントにも同じ内容で書かれている。設定する人が「保護されたつもりで素通り
# する」誤解を避けるためのものなので、片方だけを書き換えず同期させて保つこと。
# 塞ぐには、変更前の状態を記録して突き合わせる別機構（引き渡し時に対象パスの
# ハッシュのマニフェストを取り、完了検証で照合する等）が要る。これらのパスは
# バージョン管理されておらず、チェック実行時点に比較対象となる変更前の状態が
# 存在しないためである。TASK-69 ではその設計変更は行わず、限界の明記に留めた。
#
# 出力: 標準出力に次の行を出す（最終行が RESULT）。
#   RESULT: OK         -> 違反なし
#   RESULT: VIOLATION  -> 1件以上違反あり。その手前に以下を出す:
#     VIOLATION_COUNT: <件数>
#     VIOLATING_FILES:
#     <違反ファイルパス>（1行1件、件数分）
#   RESULT: ERROR      -> 対象リポジトリでない等の環境不備、または
#                         forbidden_paths/allowed_paths の値がサポート対象外の
#                         記法だった場合（詳細は標準エラーに出す）
#
# 終了ステータス: 0=OK, 1=VIOLATION, 2=ERROR
#
# 責務外: 判定結果に基づく実際の対応（差し戻す・警告する・引き渡しプロンプトに
# 反映する等）はこのスクリプトの外（呼び出し元）が行う。backlog タスクの
# 状態変更もこのスクリプトの範囲外。変更ファイル一覧の作成も呼び出し元の責務で
# あり、このスクリプトは自分で変更を探しにいかない。何が一覧に載るか（＝何が
# 機械的に止まるか）は呼び出し元の一覧の作り方で決まる。上記
# 「この判定が及ぶ範囲・及ばない範囲」を参照。

set -uo pipefail

err() {
  printf 'エラー: %s\n' "$*" >&2
}

result_error() {
  err "$1"
  printf 'RESULT: ERROR\n'
  exit 2
}

# trim_and_unquote() の唯一の定義は bin/lib/yaml_unquote.sh にあり、本来は
# それを source して使う（TASK-62）。このスクリプト自身は
# claude-code/skills/improvement-dispatch/scripts/ 配下に置かれ、`.claude/skills/
# improvement-dispatch` シンボリックリンク（配布元ディレクトリ丸ごとへの
# リンク。bin/setup-improvement-loop が配置する）経由で実行されることが
# あるため、bin/lib/yaml_unquote.sh を source するにはまず配布元リポジトリの
# ルートを知る必要がある。bin/setup-improvement-loop 冒頭のブートストラップ
# 処理・claude-code/workspace-skills/*/scripts/list-target-repos と同じ理由・
# 同じロジックで、まず自分自身の実パスを解決する。
#
# 注意: ここで解決する配布元リポジトリのルート（DIST_REPO_ROOT）は、下で
# `git rev-parse --show-toplevel` により求める REPO_ROOT（このスクリプトが
# 実際に判定対象とする対象リポジトリのルート。forbidden_paths/allowed_paths
# はここの .backlog/config.my.yml から読む）とは別物であり、混同しないこと。
_bootstrap_resolve_own_path() {
  if command -v realpath >/dev/null 2>&1; then
    realpath "$1"
  elif readlink -f "$1" >/dev/null 2>&1; then
    readlink -f "$1"
  else
    local dir base
    dir="$(cd "$(dirname "$1")" && pwd -P)"
    base="$(basename "$1")"
    printf '%s/%s\n' "$dir" "$base"
  fi
}
SCRIPT_SOURCE="$(_bootstrap_resolve_own_path "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_SOURCE")" && pwd)"
# SCRIPT_DIR は <配布元リポジトリ>/claude-code/skills/improvement-dispatch/scripts。
# 4階層上が配布元リポジトリのルートである。
DIST_REPO_ROOT="$(cd "$SCRIPT_DIR/../../../.." && pwd)"

# shellcheck source=../../../../bin/lib/yaml_unquote.sh
source "$DIST_REPO_ROOT/bin/lib/yaml_unquote.sh"

if ! REPO_ROOT="$(git rev-parse --show-toplevel 2>&1)"; then
  result_error "カレントディレクトリが git リポジトリの中ではない: $REPO_ROOT"
fi

CONFIG_FILE="$REPO_ROOT/.backlog/config.my.yml"

# $1 = YAML のキー名（forbidden_paths | allowed_paths）。CONFIG_FILE から
# 該当キーの値を読み、要素を1行1件で標準出力に出す。次の2形式をサポートする
# （bin/setup-improvement-loop の parse_statuses_block と同じ考え方。TASK-56）:
#   - インライン配列: key: ["a", "b"]
#   - 複数行YAMLリスト: key: の次行以降に続く "  - \"a\"" 形式の行
# キーが無い、値が空（[] や、次行に複数行リストが続かない空の key:）、
# または CONFIG_FILE 自体が無い場合は何も出力せず正常終了する
# （＝呼び出し側で空配列として扱われる）。
# 戻り値: 0 = 正常（0件以上を出力）。1 = 値がインライン配列・複数行YAMLリスト
# のいずれでもない「サポート対象外の記法」（詳細は標準エラーに出す）。
# 呼び出し側は戻り値1を RESULT: ERROR として扱うこと（空配列へフォールバック
# しない。理由は本ファイル冒頭の判定ロジックのコメントを参照）。
parse_path_list() {
  local key="$1"
  if [ ! -f "$CONFIG_FILE" ]; then
    return 0
  fi
  local line_num
  line_num="$(grep -n -m1 -E "^[[:space:]]*${key}:" "$CONFIG_FILE" | cut -d: -f1 || true)"
  if [ -z "$line_num" ]; then
    return 0
  fi
  local line
  line="$(sed -n "${line_num}p" "$CONFIG_FILE")"
  local rest="${line#*:}"
  rest="${rest%%#*}"

  if [[ "$rest" =~ \[(.*)\] ]]; then
    # インライン配列形式（例: key: ["secrets/", "vendor/"]）。従来ロジック。
    local inner="${BASH_REMATCH[1]}"
    if [ -z "${inner//[[:space:]]/}" ]; then
      return 0
    fi
    local items=()
    IFS=',' read -ra items <<<"$inner"
    local raw_item trimmed
    for raw_item in "${items[@]}"; do
      trimmed="$(trim_and_unquote "$raw_item")"
      if [ -n "$trimmed" ]; then
        printf '%s\n' "$trimmed"
      fi
    done
    return 0
  fi

  local rest_trimmed
  rest_trimmed="$(trim_and_unquote "$rest")"
  if [ -n "$rest_trimmed" ]; then
    # "[" を含まないのに key: の後に何かがある＝インライン配列でも、
    # 複数行YAMLリスト（key: の後は何も無いはず）でもない、サポート対象外
    # の記法（壊れたYAML・スカラー値等）。
    err "${key}: の値がサポート対象外の記法（インライン配列 [...] でも、複数行YAMLリストでもない）: ${line}"
    return 1
  fi

  # 複数行YAMLリスト形式（key: の直後から連続する "  - ..." 行を集める）。
  # 次行以降に "-" で始まる行が無ければ、空配列（key: だけで値が無い）として
  # 扱う。
  local total_lines next_line_num list_line item
  total_lines="$(awk 'END { print NR }' "$CONFIG_FILE")"
  next_line_num=$((line_num + 1))
  while [ "$next_line_num" -le "$total_lines" ]; do
    list_line="$(sed -n "${next_line_num}p" "$CONFIG_FILE")"
    if ! printf '%s' "$list_line" | grep -Eq '^[[:space:]]*-'; then
      break
    fi
    item="${list_line#*-}"
    item="${item%%#*}"
    item="$(trim_and_unquote "$item")"
    if [ -n "$item" ]; then
      printf '%s\n' "$item"
    fi
    next_line_num=$((next_line_num + 1))
  done
  return 0
}

# parse_path_list は process substitution 経由で呼ぶと戻り値（サポート対象外
# 記法の検知）をここで拾えなくなるため、コマンド置換で標準出力と終了ステータス
# の両方を捕捉してから配列に分解する。
FORBIDDEN_RAW="$(parse_path_list forbidden_paths)"
FORBIDDEN_STATUS=$?
if [ "$FORBIDDEN_STATUS" -ne 0 ]; then
  result_error "forbidden_paths の値を読み取れない（詳細は上記のエラーメッセージ参照）"
fi
FORBIDDEN=()
if [ -n "$FORBIDDEN_RAW" ]; then
  while IFS= read -r p; do
    FORBIDDEN+=("$p")
  done <<<"$FORBIDDEN_RAW"
fi

ALLOWED_RAW="$(parse_path_list allowed_paths)"
ALLOWED_STATUS=$?
if [ "$ALLOWED_STATUS" -ne 0 ]; then
  result_error "allowed_paths の値を読み取れない（詳細は上記のエラーメッセージ参照）"
fi
ALLOWED=()
if [ -n "$ALLOWED_RAW" ]; then
  while IFS= read -r p; do
    ALLOWED+=("$p")
  done <<<"$ALLOWED_RAW"
fi

# $1 = 判定対象パス、以降 = プレフィックスの列。いずれか1つにでも前方一致
# すれば真を返す。
matches_any_prefix() {
  local path="$1"
  shift
  local prefix
  for prefix in "$@"; do
    case "$path" in
      "$prefix"*) return 0 ;;
    esac
  done
  return 1
}

VIOLATING_FILES=()
for raw_file in "$@"; do
  file="${raw_file#./}"
  if [ -z "$file" ]; then
    continue
  fi
  is_violation=0
  if [ "${#FORBIDDEN[@]}" -gt 0 ] && matches_any_prefix "$file" "${FORBIDDEN[@]}"; then
    is_violation=1
  fi
  if [ "$is_violation" -eq 0 ] && [ "${#ALLOWED[@]}" -gt 0 ] && ! matches_any_prefix "$file" "${ALLOWED[@]}"; then
    is_violation=1
  fi
  if [ "$is_violation" -eq 1 ]; then
    VIOLATING_FILES+=("$file")
  fi
done

if [ "${#VIOLATING_FILES[@]}" -eq 0 ]; then
  printf 'RESULT: OK\n'
  exit 0
fi

printf 'VIOLATION_COUNT: %s\n' "${#VIOLATING_FILES[@]}"
printf 'VIOLATING_FILES:\n'
for f in "${VIOLATING_FILES[@]}"; do
  printf '%s\n' "$f"
done
printf 'RESULT: VIOLATION\n'
exit 1
