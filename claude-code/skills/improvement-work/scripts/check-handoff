#!/usr/bin/env bash
# improvement-work 手順1（引き渡し内容の確認）のうち、機械的に判定できる前提条件を
# 決定論的に確認する。
#
# 使い方:
#   cd "<引き渡された作業ディレクトリ>"
#   check-handoff <期待する作業ディレクトリ絶対パス> <期待するブランチ名>
#
# 引数は dispatch から引き渡された WORKTREE_DIR（絶対パスのみ）と BRANCH。
# 呼び出し前に確認対象のワークツリーへ cd しておくこと。このスクリプト自身は
# cd せず、カレントディレクトリと引数だけで判定する。
#
# 確認する3条件:
#   1. カレントディレクトリ（pwd -P で正規化）が期待する作業ディレクトリと一致する。
#   2. checkout 中のブランチが期待するブランチ名と一致する。
#   3. .backlog がシンボリックリンクとして存在し、リンク先が有効なディレクトリである。
#
# 満たされなかった条件は1つ目で打ち切らずすべて標準エラーに列挙する。
# 複数の不整合が同時にある場合でも一度の実行で全容を報告するためである。
#
# 終了ステータス:
#   0  3条件すべてを満たす
#   1  引数の個数・形式が不正
#   2  1条件以上を満たさない（詳細は標準エラー）
#
# 責務外: 引き渡しが不完全だった場合の報告と停止の判断。判定と報告のみを行い、
# backlog タスクの編集や停止処理はしない。

set -uo pipefail

err() {
  printf 'エラー: %s\n' "$*" >&2
}

if [ "$#" -ne 2 ]; then
  err "使い方: $(basename "$0") <期待する作業ディレクトリ絶対パス> <期待するブランチ名>"
  exit 1
fi

EXPECTED_DIR="$1"
EXPECTED_BRANCH="$2"

case "$EXPECTED_DIR" in
  /*) : ;;
  *)
    err "期待する作業ディレクトリは絶対パスで指定すること: $EXPECTED_DIR"
    exit 1
    ;;
esac

if [ -z "$EXPECTED_BRANCH" ]; then
  err "期待するブランチ名が空である"
  exit 1
fi

FAILED=0

# ---- 1. 作業ディレクトリの一致 ----
# 末尾スラッシュ・".."・シンボリックリンク経由の表記ゆれで偽陽性の不一致が出ないよう、
# 両側を pwd -P で正規化してから比較する。期待する側が実在しない場合は正規化できない
# （そもそも一致し得ない）ので、渡された文字列のまま比較する。
ACTUAL_DIR="$(pwd -P)"
EXPECTED_DIR_RESOLVED="$EXPECTED_DIR"
if [ -d "$EXPECTED_DIR" ]; then
  resolved="$(cd "$EXPECTED_DIR" 2>/dev/null && pwd -P)"
  if [ -n "$resolved" ]; then
    EXPECTED_DIR_RESOLVED="$resolved"
  fi
fi

if [ "$ACTUAL_DIR" = "$EXPECTED_DIR_RESOLVED" ]; then
  :
else
  FAILED=1
  err "作業ディレクトリが期待するパスと異なる: 現在=$ACTUAL_DIR 期待=$EXPECTED_DIR_RESOLVED"
fi

# ---- 2. ブランチの一致 ----
if ! command -v git >/dev/null 2>&1; then
  FAILED=1
  err "git コマンドが見つからない"
else
  ACTUAL_BRANCH="$(git branch --show-current 2>/dev/null || true)"
  if [ -z "$ACTUAL_BRANCH" ]; then
    FAILED=1
    err "現在のブランチを取得できない（git リポジトリでない、または detached HEAD の可能性がある）"
  elif [ "$ACTUAL_BRANCH" != "$EXPECTED_BRANCH" ]; then
    FAILED=1
    err "現在のブランチが期待するブランチ名と異なる: 現在=$ACTUAL_BRANCH 期待=$EXPECTED_BRANCH"
  fi
fi

# ---- 3. .backlog シンボリックリンクの健全性 ----
if [ ! -e .backlog ] && [ ! -L .backlog ]; then
  FAILED=1
  err ".backlog が存在しない（dispatch の引き渡しが不完全な可能性がある）"
elif [ ! -L .backlog ]; then
  FAILED=1
  err ".backlog がシンボリックリンクではない（実体のディレクトリ/ファイルになっている）"
elif [ ! -d .backlog ]; then
  FAILED=1
  err ".backlog がシンボリックリンクとして存在するが、リンク先が有効なディレクトリではない（壊れたリンクの可能性がある）"
fi

if [ "$FAILED" -ne 0 ]; then
  exit 2
fi

echo "OK: 作業ディレクトリ・ブランチ・.backlog シンボリックリンクの3条件をすべて満たす"
exit 0
