#!/usr/bin/env bash
# improvement-loop 自身の開発用 pre-commit フック。コミット前に tests/run.sh を
# 実行し、FAIL があればコミットをブロックする。
#
# 有効化には core.hooksPath をこのディレクトリに向ける一回限りの設定が要る
# （手順は README.md）。配置するだけでは有効にならない。

set -uo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
TESTS_SCRIPT="$REPO_ROOT/tests/run.sh"

if [ ! -f "$TESTS_SCRIPT" ]; then
  echo "pre-commit: $TESTS_SCRIPT が見つからない。フックをスキップする。" >&2
  exit 0
fi

# 実行ビットの有無に依存しないよう bash 経由で起動する。
exec bash "$TESTS_SCRIPT"
