#!/usr/bin/env bash
# githooks/pre-commit
#
# improvement-loop 自身の開発用 pre-commit フック。
# コミット前に tests/run.sh を実行し、FAIL があればコミットをブロックする。
#
# 有効化手順は README.md を参照（core.hooksPath をこのディレクトリに向ける
# 一回限りの設定が必要。デフォルトの .git/hooks は git 管理外のため、
# このスクリプト自体を配置するだけでは有効にならない）。
#
# GitHub Actions 等の CI は対象外（このリポジトリは個人ローカル運用が前提）。

set -uo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
TESTS_SCRIPT="$REPO_ROOT/tests/run.sh"

if [ ! -f "$TESTS_SCRIPT" ]; then
  echo "pre-commit: $TESTS_SCRIPT が見つからない。フックをスキップする。" >&2
  exit 0
fi

# 実行ビットの有無に関わらず bash 経由で起動する（tests/run.sh 自体は実行
# ビット付きで管理されている想定だが、フック側は依存しない）。
exec bash "$TESTS_SCRIPT"
