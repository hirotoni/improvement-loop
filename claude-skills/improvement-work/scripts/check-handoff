#!/usr/bin/env bash
# claude-skills/improvement-work/scripts/check-handoff
#
# improvement-work 手順1（引き渡し内容の確認）のうち、機械的に判定できる
# 前提条件チェックを決定論的に行う。以前はこの確認が SKILL.md の散文＋埋め込み
# bash として書かれており、サブエージェント（起動のたびに改めてコンテキストを
# 持たない）が毎回手動でコマンドを組み立てて確認していた。
#
# 使い方:
#   cd "<引き渡された作業ディレクトリ>"
#   .claude/skills/improvement-work/scripts/check-handoff <期待する作業ディレクトリ絶対パス> <期待するブランチ名>
#
# 引数:
#   期待する作業ディレクトリ絶対パス  dispatch から引き渡された WORKTREE_DIR
#                                     （絶対パスであること。相対パスは扱わない）。
#   期待するブランチ名                dispatch から引き渡された BRANCH。
#
# 前提: このスクリプトは、引き渡された作業ディレクトリに既に cd した状態
# （カレントディレクトリ = 確認対象のワークツリー）で呼び出すこと。
# 引数に渡す作業ディレクトリを cd 先として使うわけではない
# （このスクリプト自身は cd しない）。
#
# 確認する3条件（すべて機械的に判定可能）:
#   1. 現在の作業ディレクトリ（pwd -P で正規化）が、引数で渡された
#      期待する作業ディレクトリと一致するか。
#   2. 現在 checkout されているブランチ（git branch --show-current）が、
#      引数で渡された期待するブランチ名と一致するか。
#   3. カレントディレクトリの .backlog がシンボリックリンクとして存在し、
#      かつそのリンク先が有効なディレクトリを指しているか
#      （リンク切れ・ディレクトリでない実体はすべて不合格）。
#
# 満たされなかった条件はすべて標準エラーに列挙する（1つ失敗した時点で
# 打ち切らない）。これにより、複数条件が同時に不整合な場合でも一度の
# 実行で全容を報告できる。
#
# 終了ステータス:
#   0  3条件すべてを満たす
#   1  引数の個数・形式が不正（使い方を標準エラーに出す）
#   2  1条件以上を満たさない（詳細は標準エラーを参照）
#
# 責務外: 引き渡しが不完全だった場合にどう報告し、どう停止するかの判断は
# このスクリプトの外（呼び出し元のサブエージェント）に残す。このスクリプト
# 自体は判定と報告のみを行い、backlog タスクの編集や停止処理は行わない。

set -uo pipefail

err() {
  printf 'エラー: %s\n' "$*" >&2
}

if [ "$#" -ne 2 ]; then
  err "使い方: $(basename "$0") <期待する作業ディレクトリ絶対パス> <期待するブランチ名>"
  exit 1
fi

EXPECTED_DIR="$1"
EXPECTED_BRANCH="$2"

case "$EXPECTED_DIR" in
  /*) : ;;
  *)
    err "期待する作業ディレクトリは絶対パスで指定すること: $EXPECTED_DIR"
    exit 1
    ;;
esac

if [ -z "$EXPECTED_BRANCH" ]; then
  err "期待するブランチ名が空である"
  exit 1
fi

FAILED=0

# ---- 1. 作業ディレクトリの一致 ----
# pwd -P で現在の作業ディレクトリをシンボリックリンク解決済みの絶対パスへ
# 正規化する。期待する作業ディレクトリ側も、実在するなら同様に正規化してから
# 比較する（末尾スラッシュや .. などの表記ゆれ、シンボリックリンク経由の
# 参照の差異による偽陽性の不一致を防ぐ）。実在しない場合は正規化できない
# （そもそも一致し得ない）ので、渡された文字列のまま比較する。
ACTUAL_DIR="$(pwd -P)"
EXPECTED_DIR_RESOLVED="$EXPECTED_DIR"
if [ -d "$EXPECTED_DIR" ]; then
  resolved="$(cd "$EXPECTED_DIR" 2>/dev/null && pwd -P)"
  if [ -n "$resolved" ]; then
    EXPECTED_DIR_RESOLVED="$resolved"
  fi
fi

if [ "$ACTUAL_DIR" = "$EXPECTED_DIR_RESOLVED" ]; then
  :
else
  FAILED=1
  err "作業ディレクトリが期待するパスと異なる: 現在=$ACTUAL_DIR 期待=$EXPECTED_DIR_RESOLVED"
fi

# ---- 2. ブランチの一致 ----
if ! command -v git >/dev/null 2>&1; then
  FAILED=1
  err "git コマンドが見つからない"
else
  ACTUAL_BRANCH="$(git branch --show-current 2>/dev/null || true)"
  if [ -z "$ACTUAL_BRANCH" ]; then
    FAILED=1
    err "現在のブランチを取得できない（git リポジトリでない、または detached HEAD の可能性がある）"
  elif [ "$ACTUAL_BRANCH" != "$EXPECTED_BRANCH" ]; then
    FAILED=1
    err "現在のブランチが期待するブランチ名と異なる: 現在=$ACTUAL_BRANCH 期待=$EXPECTED_BRANCH"
  fi
fi

# ---- 3. .backlog シンボリックリンクの健全性 ----
if [ ! -e .backlog ] && [ ! -L .backlog ]; then
  FAILED=1
  err ".backlog が存在しない（dispatch の引き渡しが不完全な可能性がある）"
elif [ ! -L .backlog ]; then
  FAILED=1
  err ".backlog がシンボリックリンクではない（実体のディレクトリ/ファイルになっている）"
elif [ ! -d .backlog ]; then
  FAILED=1
  err ".backlog がシンボリックリンクとして存在するが、リンク先が有効なディレクトリではない（壊れたリンクの可能性がある）"
fi

if [ "$FAILED" -ne 0 ]; then
  exit 2
fi

echo "OK: 作業ディレクトリ・ブランチ・.backlog シンボリックリンクの3条件をすべて満たす"
exit 0
