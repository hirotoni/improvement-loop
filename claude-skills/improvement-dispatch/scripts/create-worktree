#!/usr/bin/env bash
# claude-skills/improvement-dispatch/scripts/create-worktree
#
# claude-skills/improvement-dispatch/SKILL.md 手順5（ワークツリーを作って引き渡す）
# が行うワークツリー作成の一連の処理を、決定論的な単一のスクリプトとして実行する。
# 以前はこの処理が SKILL.md に埋め込まれた bash ブロックとして書かれており、
# dispatch（AI）が起動のたびに読み取って組み立てて実行していた。
#
# 使い方:
#   .claude/skills/improvement-dispatch/scripts/create-worktree <task-id>
#
# <task-id> の例: task-14-worktree-script-extraction
#   （backlog のタスク番号と英小文字スラッグをハイフンで連結したもの）
#
# 実行するもの:
#   1. improvement_loop.worktree_base_dir（.backlog/config.my.yml）を読み、
#      ワークツリーの作成先ベースディレクトリを決定・正規化する
#      （未設定なら既定でリポジトリの親ディレクトリの .worktree/）。
#      この配下にさらにリポジトリ名で名前空間分けする。
#   2. ベースディレクトリがリポジトリ内を指す場合だけ、.git/info/exclude に
#      除外パターンを追記する（リポジトリ外を指す場合は追記しない）。
#   3. git worktree prune の後、デフォルトブランチを判定する
#      （フェッチできれば origin/HEAD、できなければ main にフォールバック）。
#   4. 作業ブランチのワークツリーを作る。既にワークツリーが存在し、割り当て
#      ブランチが一致する場合は何もしない（再実行の冪等性）。ワークツリーは
#      無いがブランチだけ存在する場合は、新規作成せずそのブランチを割り当てる
#      （再引き渡し等）。どちらも無ければ、デフォルトブランチを起点に新規作成する。
#   5. .backlog/ を git 管理外のシンボリックリンクとしてワークツリーへ張る
#      （メインの作業木の .backlog/ を指す。既に存在すれば何もしない）。
#   6. .git/info/exclude に .backlog の除外パターンを追記する（無ければ）。
#
# 冪等性: 同じ <task-id> で複数回実行しても、既存のブランチ・ワークツリー・
# シンボリックリンク・.git/info/exclude の記述を再利用/スキップし、
# エラーにならない。
#
# 責務外: backlog タスクのステータス変更（In Progress への遷移）はこの
# スクリプトの外（呼び出し側）で行う。このスクリプトは git ワークツリーの
# 作成・配置にのみ責任を持つ。
#
# 標準出力の最後に次の2行を出力する（呼び出し側が後続手順で使う）。
#   WORKTREE_DIR=<作成/再利用したワークツリーの絶対パス>
#   BRANCH=<割り当てた作業ブランチ名>

set -euo pipefail

err() {
  printf 'エラー: %s\n' "$*" >&2
}

if [ "$#" -ne 1 ]; then
  err "使い方: $(basename "$0") <task-id>  (例: task-14-worktree-script-extraction)"
  exit 1
fi

TASK_ID="$1"

if ! [[ "$TASK_ID" =~ ^task-[0-9]+-[a-z0-9]+(-[a-z0-9]+)*$ ]]; then
  err "task-id の形式が不正: $TASK_ID (期待する形式: task-<番号>-<英小文字のスラッグ>)"
  exit 1
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"
REPO_NAME="$(basename "$REPO_ROOT")"

# git-common-dir は cwd 相対のパスを返すことがあるため、絶対パスへ正規化する。
GIT_COMMON_DIR="$(git rev-parse --git-common-dir)"
case "$GIT_COMMON_DIR" in
  /*) : ;;
  *) GIT_COMMON_DIR="$REPO_ROOT/$GIT_COMMON_DIR" ;;
esac

# ---- improvement_loop.worktree_base_dir を .backlog/config.my.yml から読む ----
# ファイルが無い、またはキーが無い場合は空文字（既定値扱い）とする。
CONFIG_FILE="$REPO_ROOT/.backlog/config.my.yml"
WORKTREE_BASE_DIR_CONFIG=""
if [ -f "$CONFIG_FILE" ]; then
  config_line="$(grep -m1 -E '^[[:space:]]*worktree_base_dir:' "$CONFIG_FILE" || true)"
  if [ -n "$config_line" ]; then
    WORKTREE_BASE_DIR_CONFIG="$(printf '%s\n' "$config_line" | sed -E \
      -e 's/^[[:space:]]*worktree_base_dir:[[:space:]]*//' \
      -e 's/[[:space:]]+#.*$//' \
      -e 's/[[:space:]]+$//' \
      -e 's/^"(.*)"$/\1/' \
      -e "s/^'(.*)'\$/\\1/")"
  fi
fi

# 絶対パス、またはリポジトリルート起点の相対パスを指定できる。実際の作成先は
# この配下にさらにリポジトリ名で名前空間分けされる（BASE_DIR/$REPO_NAME/<task-id>）。
if [ -z "$WORKTREE_BASE_DIR_CONFIG" ]; then
  BASE_DIR="$(dirname "$REPO_ROOT")/.worktree"
elif [[ "$WORKTREE_BASE_DIR_CONFIG" = /* ]]; then
  BASE_DIR="$WORKTREE_BASE_DIR_CONFIG"
else
  BASE_DIR="$REPO_ROOT/$WORKTREE_BASE_DIR_CONFIG"
fi

# 相対パス・末尾スラッシュ・".." などの表記ゆれを解決してから使う。
# 解決前の文字列のまま次のリポジトリ内外判定（case 文）を行うと、
# 例えば末尾スラッシュ付きでリポジトリ内判定を素通りしたり、".." で
# 実際にはリポジトリ外なのに内側だと誤判定したりする恐れがある。
mkdir -p "$BASE_DIR"
BASE_DIR="$(cd "$BASE_DIR" && pwd -P)"
if [ -z "$BASE_DIR" ]; then
  err "worktree_base_dir の解決に失敗した: $WORKTREE_BASE_DIR_CONFIG"
  exit 1
fi

mkdir -p "$BASE_DIR/$REPO_NAME"
WORKTREE_DIR="$BASE_DIR/$REPO_NAME/$TASK_ID"
BRANCH="improvement/$TASK_ID"

# BASE_DIR（正規化済み）がリポジトリルート内を指す場合だけ、.git/info/exclude
# に除外パターンを追加し、git の追跡対象に入らないようにする。リポジトリ外を
# 指す場合は追記しない（既にリポジトリの外なので対象外であり、追記の必要が無い）。
case "$BASE_DIR" in
  "$REPO_ROOT")
    # BASE_DIR がリポジトリルートそのものと一致する退行的な設定値の場合、
    # "." を除外パターンにするとリポジトリ全体が git status から隠れてしまう
    # ため、代わりにリポジトリ名のディレクトリ単位で除外する。
    REL_BASE_DIR="$REPO_NAME"
    ;;
  "$REPO_ROOT"/*)
    REL_BASE_DIR="${BASE_DIR#"$REPO_ROOT"/}"
    ;;
  *)
    REL_BASE_DIR=""
    ;;
esac

if [ -n "$REL_BASE_DIR" ]; then
  BASE_DIR_EXCLUDE_FILE="$GIT_COMMON_DIR/info/exclude"
  mkdir -p "$(dirname "$BASE_DIR_EXCLUDE_FILE")"
  grep -Fxq "$REL_BASE_DIR" "$BASE_DIR_EXCLUDE_FILE" 2>/dev/null || echo "$REL_BASE_DIR" >> "$BASE_DIR_EXCLUDE_FILE"
fi

git worktree prune   # ディレクトリだけ消えて登録情報が残っているケースを掃除してから作る

if git fetch origin 2>/dev/null; then
  DEFAULT_BRANCH=$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null | sed 's#^origin/##')
  BASE_REF="origin/${DEFAULT_BRANCH:-main}"
else
  BASE_REF="main"   # デフォルトブランチが判定できない/リモートが無い場合は main を使う
fi

# $WORKTREE_DIR が既に登録済みの git ワークツリーであり、割り当てブランチが
# $BRANCH と一致するなら、そのまま再利用する（再実行しても git worktree add が
# 「既に存在する」で失敗しないようにするための冪等性ガード）。
existing_worktree_branch=""
if [ -d "$WORKTREE_DIR" ]; then
  existing_worktree_branch="$(git worktree list --porcelain | awk -v d="$WORKTREE_DIR" '
    $1 == "worktree" { cur = $2; next }
    $1 == "branch" && cur == d { sub("^refs/heads/", "", $2); print $2; exit }
  ')"
fi

if [ -n "$existing_worktree_branch" ] && [ "$existing_worktree_branch" = "$BRANCH" ]; then
  : # 既に $BRANCH で登録済みのワークツリーが存在するので何もしない（再利用）。
elif [ -d "$WORKTREE_DIR" ]; then
  err "ワークツリーが既に別の内容で存在する: $WORKTREE_DIR (割り当てられたブランチ: ${existing_worktree_branch:-不明})"
  err "内容を確認し、不要と判断できる場合のみ削除するか、人間に判断を委ねること。"
  exit 1
elif git show-ref --verify --quiet "refs/heads/$BRANCH"; then
  # 再引き渡し等で既にブランチが存在する場合は、新規作成せずそのブランチを割り当てる
  git worktree add "$WORKTREE_DIR" "$BRANCH"
else
  git worktree add "$WORKTREE_DIR" -b "$BRANCH" "$BASE_REF"
fi

# .backlog/ は git 管理外（.git/info/exclude で除外）なので、
# git worktree add では新しいワークツリーに作られない。
# メインの作業木の .backlog/ へのシンボリックリンクにして、タスクデータを共有する。
if [ -e "$REPO_ROOT/.backlog" ] && [ ! -e "$WORKTREE_DIR/.backlog" ]; then
  ln -s "$REPO_ROOT/.backlog" "$WORKTREE_DIR/.backlog"
fi

# 古いインストール（.git/info/exclude が末尾スラッシュ付きの ".backlog/" のまま）だと、
# 上のシンボリックリンクは除外パターンにマッチせず、ワークツリー内で git status が
# 常に汚れて見える。スラッシュ無しの ".backlog" は両方にマッチするので、無ければ足す。
EXCLUDE_FILE="$GIT_COMMON_DIR/info/exclude"
mkdir -p "$(dirname "$EXCLUDE_FILE")"
grep -Fxq ".backlog" "$EXCLUDE_FILE" 2>/dev/null || echo ".backlog" >> "$EXCLUDE_FILE"

echo "WORKTREE_DIR=$WORKTREE_DIR"
echo "BRANCH=$BRANCH"
