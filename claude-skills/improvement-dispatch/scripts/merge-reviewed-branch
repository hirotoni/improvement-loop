#!/usr/bin/env bash
# merge-reviewed-branch
#
# Reviewed になった improvement-loop の作業ブランチを、決定論的な手順で
# main にマージする（improvement-dispatch 手順3の auto_merge_reviewed: true
# パートに対応する）。
#
# 使い方:
#   .claude/skills/improvement-dispatch/scripts/merge-reviewed-branch <作業ブランチ名>
#
# 呼び出し元のカレントディレクトリ（の属する git リポジトリ）を
# メインの作業木として扱う。ブランチの切り替え・マージはそのリポジトリに
# 対して行う。対象の作業ブランチ用ワークツリー（存在する場合）には
# 立ち入らず、マージ完了後に `git worktree remove` で片付けるだけである。
#
# 行うこと（すべて機械的に判定できる分岐のみ）:
#   1. メインの作業木がクリーンか（git status --porcelain が空か）を確認する。
#   2. 対象ブランチが存在し、main との差分があるかを確認する。
#      差分が無い（既に main にマージ済み）場合でも、対応するワークツリー・
#      作業ブランチの片付け（手順5-6）が未完了なら、ここでその片付けだけを
#      再試行する（TASK-57）。これは過去の呼び出しでマージ自体は成功した
#      ものの、対象ワークツリーが dirty 等の理由で片付け（手順5-6）が
#      失敗して残った状態からの回復のためである。片付けの再試行が成功しても
#      失敗しても、今回の呼び出しでは新規のマージは発生していないため、
#      結果は PRECONDITION_NOT_MET のまま変えない。
#   3. git merge --ff-only を試す。成功すればマージ完了。
#   4. 早送りできなければ git merge --no-commit --no-ff でドライランする。
#      衝突していれば abort し、衝突したファイルを報告して終了する
#      （git 状態・backlog タスクの状態は一切変更しない）。
#      衝突していなければそのままコミットしてマージを完了する。
#   5. マージが完了した場合のみ、対応するワークツリーを git worktree remove
#      で片付ける（未コミットの変更等で失敗しても --force はしない）。
#   6. マージが完了した場合のみ、対応する作業ブランチ自体も git branch -d
#      で削除する（安全削除のみ。--force/-D はせず、失敗してもエラーを
#      報告して先に進む。worktree の片付けと同じ扱いである）。
#
# 終了ステータスと、標準出力の最後の行に出す "RESULT: <値>" で結果を判別する。
#
#   exit 0, RESULT: MERGED               マージ完了（ff-only または衝突無し3-way）
#   exit 1, RESULT: PRECONDITION_NOT_MET マージ未実施。メインの作業木が汚れている、
#                                         対象ブランチが存在しない、または
#                                         main との差分が無い（この場合、対応する
#                                         ワークツリー・ブランチの片付けが未完了
#                                         なら再試行される。片付けの成否は標準
#                                         出力・標準エラー出力のメッセージで判別
#                                         する。TASK-57）
#   exit 2, RESULT: CONFLICT             マージ未実施。3-wayマージが衝突した
#                                         （人間の判断が必要。abort 済みで
#                                         git 状態は変更前と同じ）
#   exit 3, RESULT: ERROR                想定外のエラー（引数不足、git 操作
#                                         自体の失敗等）。マージ未実施
#
# backlog タスクのステータス変更はこのスクリプトの責務外。呼び出し元
# （improvement-dispatch）が終了ステータスに応じて行う。
#
# rebase は使わない（人間がレビューしたコミットの同一性を変えないため）。
# --force を伴う操作もしない。

set -uo pipefail

err() {
  printf 'エラー: %s\n' "$*" >&2
}

emit_result() {
  printf 'RESULT: %s\n' "$1"
}

# git merge --abort を実行し、実際にメインの作業木がマージ前のクリーンな
# 状態に戻ったことまで確認する。abort コマンド自体の失敗、または abort 後も
# MERGE_HEAD や未コミットの変更が残っている場合は、git 状態の復元を保証
# できないとみなして 1 を返す。呼び出し元はこの場合、CONFLICT 等ではなく
# ERROR として報告しなければならない（「git 状態は変更前と同じ」という
# 保証が崩れているため、衝突ファイルの報告だけでは不十分）。
abort_and_verify_restored() {
  if ! git -C "$REPO_ROOT" merge --abort >/dev/null 2>&1; then
    err "git merge --abort 自体が失敗した"
    return 1
  fi
  if git -C "$REPO_ROOT" rev-parse -q --verify MERGE_HEAD >/dev/null 2>&1; then
    err "git merge --abort 後も MERGE_HEAD が残っている"
    return 1
  fi
  local post_abort_status
  if ! post_abort_status="$(git -C "$REPO_ROOT" status --porcelain)"; then
    err "git merge --abort 後の git status の実行に失敗した（状態を確認できない）"
    return 1
  fi
  if [ -n "$post_abort_status" ]; then
    err "git merge --abort 後もメインの作業木が汚れている"
    return 1
  fi
  return 0
}

# 対応するワークツリー（存在すれば）と作業ブランチ自体を片付ける。
# マージ完了直後の片付け（手順5-6）と、main との差分が既に無い場合の
# 片付け再試行（TASK-57）の両方から呼ぶ共通処理である。
# git worktree remove / git branch -d はいずれも安全側の操作のみで、
# --force/-D はしない。失敗してもエラーメッセージを出すだけで、
# 呼び出し元の結果（exit code・RESULT）は変えない。
cleanup_worktree_and_branch() {
  local repo_root="$1"
  local branch="$2"

  # パスに半角スペースを含む場合の復元ロジックは bin/lib/worktree_porcelain.sh の
  # worktree_porcelain_pairs() に集約されている（TASK-64。以前はここに
  # create-worktree と同じ substr(index()) パターンを独立実装していた）。
  # worktree_porcelain_pairs() は branch を refs/heads/ を除いた短縮名で
  # 出すので、比較対象も "refs/heads/$branch" ではなく $branch にする。
  local worktree_path
  worktree_path="$(git -C "$repo_root" worktree list --porcelain | worktree_porcelain_pairs | awk -F'\t' -v branch="$branch" '
    $2 == branch { print $1 }
  ')"

  if [ -n "$worktree_path" ]; then
    local worktree_err_file
    worktree_err_file="$(mktemp)"
    if git -C "$repo_root" worktree remove "$worktree_path" 2>"$worktree_err_file"; then
      echo "ワークツリーを片付けた: $worktree_path"
    else
      err "ワークツリーの片付けに失敗した（--force はせず残す）: $worktree_path"
      err "$(cat "$worktree_err_file")"
    fi
    rm -f "$worktree_err_file"
  else
    echo "対応するワークツリーは見つからなかった（既に片付け済みの可能性がある）"
  fi

  local branch_err_file
  branch_err_file="$(mktemp)"
  if git -C "$repo_root" branch -d "$branch" 2>"$branch_err_file"; then
    echo "作業ブランチを削除した: $branch"
  else
    err "作業ブランチの削除に失敗した（-D はせず残す）: $branch"
    err "$(cat "$branch_err_file")"
  fi
  rm -f "$branch_err_file"
}

BRANCH="${1:-}"

if [ -z "$BRANCH" ]; then
  err "使い方: $0 <作業ブランチ名>"
  emit_result "ERROR"
  exit 3
fi

if ! REPO_ROOT="$(git rev-parse --show-toplevel 2>&1)"; then
  err "カレントディレクトリが git リポジトリの中ではない: $REPO_ROOT"
  emit_result "ERROR"
  exit 3
fi

# worktree_porcelain_pairs() の唯一の定義は bin/lib/worktree_porcelain.sh に
# あり、それを source して使う（TASK-64）。このスクリプト自身は
# claude-skills/improvement-dispatch/scripts/ 配下に置かれ、`.claude/skills/
# improvement-dispatch` シンボリックリンク（配布元ディレクトリ丸ごとへの
# リンク）経由で実行されることがあるため、bin/lib/worktree_porcelain.sh を
# source するにはまず配布元リポジトリのルートを知る必要がある。
# check-forbidden-allowed-paths（TASK-62）と同じ理由・同じロジックで、
# まず自分自身の実パスを解決する。
#
# 配置場所についての注意（create-worktree:TASK-58回帰対策と揃える）: この
# source は、上の git rev-parse --show-toplevel（git 不在時に最初に失敗する
# 外部コマンド呼び出し）より後に置く。_bootstrap_resolve_own_path 自体が
# realpath/readlink/dirname/basename という外部コマンドを使うため、これより
# 前に置くと、git が PATH に無い環境で本来の診断より先に生の
# "command not found" が出てしまう（create-worktree で実際に踏んだ回帰）。
#
# 注意: ここで解決する配布元リポジトリのルート（DIST_REPO_ROOT）は、上の
# REPO_ROOT（マージ・ワークツリー片付けの対象リポジトリのルート）とは
# 別物であり、混同しないこと。
_bootstrap_resolve_own_path() {
  if command -v realpath >/dev/null 2>&1; then
    realpath "$1"
  elif readlink -f "$1" >/dev/null 2>&1; then
    readlink -f "$1"
  else
    local dir base
    dir="$(cd "$(dirname "$1")" && pwd -P)"
    base="$(basename "$1")"
    printf '%s/%s\n' "$dir" "$base"
  fi
}
SCRIPT_SOURCE="$(_bootstrap_resolve_own_path "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_SOURCE")" && pwd)"
# SCRIPT_DIR は <配布元リポジトリ>/claude-skills/improvement-dispatch/scripts。
# 3階層上が配布元リポジトリのルートである。
DIST_REPO_ROOT="$(cd "$SCRIPT_DIR/../../.." && pwd)"

# shellcheck source=../../../bin/lib/worktree_porcelain.sh
source "$DIST_REPO_ROOT/bin/lib/worktree_porcelain.sh"

# ---- 1. 前提条件: メインの作業木がクリーンか ----
# git status 自体の失敗（リポジトリの破損、ロック等）を、クリーンである
# こと（$dirty_status が空）と取り違えて先に進まないよう、コマンド自体の
# 終了ステータスも明示的に確認する（フェイルクローズ）。
if ! dirty_status="$(git -C "$REPO_ROOT" status --porcelain)"; then
  err "git status の実行に失敗した。マージを行わない: $REPO_ROOT"
  emit_result "ERROR"
  exit 3
fi
if [ -n "$dirty_status" ]; then
  err "メインの作業木が汚れている。マージを行わない: $REPO_ROOT"
  printf '%s\n' "$dirty_status" >&2
  emit_result "PRECONDITION_NOT_MET"
  exit 1
fi

# ---- 2. 前提条件: 対象ブランチが存在するか ----
if ! git -C "$REPO_ROOT" show-ref --verify --quiet "refs/heads/$BRANCH"; then
  err "作業ブランチが存在しない: $BRANCH"
  emit_result "PRECONDITION_NOT_MET"
  exit 1
fi

# ---- 3. 前提条件: main との差分があるか ----
if ! git -C "$REPO_ROOT" show-ref --verify --quiet "refs/heads/main"; then
  err "main ブランチが存在しない"
  emit_result "PRECONDITION_NOT_MET"
  exit 1
fi

commit_count="$(git -C "$REPO_ROOT" rev-list --count "main..$BRANCH" 2>/dev/null || true)"
if [ -z "$commit_count" ] || [ "$commit_count" -eq 0 ]; then
  err "作業ブランチ '$BRANCH' に main との差分が無い"
  # 差分が無い＝ブランチの内容は既に main に取り込み済みである。過去の
  # 呼び出しでマージ自体は成功したが、対応するワークツリー・ブランチの
  # 片付け（手順5-6）が失敗して残っている可能性があるため、ここで
  # その片付けだけを再試行する（TASK-57）。今回は新規のマージを行って
  # いないため、片付けの成否によらず結果は PRECONDITION_NOT_MET のまま
  # 変えない。
  err "対応するワークツリー・作業ブランチの片付けが未完了なら再試行する"
  cleanup_worktree_and_branch "$REPO_ROOT" "$BRANCH"
  emit_result "PRECONDITION_NOT_MET"
  exit 1
fi

# ---- 4. main に切り替える ----
if ! git -C "$REPO_ROOT" switch main >/dev/null 2>&1; then
  err "main への切り替えに失敗した"
  emit_result "ERROR"
  exit 3
fi

# ---- 5. ff-only を試す ----
if git -C "$REPO_ROOT" merge --ff-only "$BRANCH" >/dev/null 2>&1; then
  echo "ff-only でマージした: $BRANCH"
else
  # ---- 6. 3-way ドライラン ----
  merge_output="$(git -C "$REPO_ROOT" merge --no-commit --no-ff "$BRANCH" 2>&1)"
  merge_status=$?
  conflicted_files="$(git -C "$REPO_ROOT" diff --name-only --diff-filter=U)"

  if [ -n "$conflicted_files" ]; then
    if abort_and_verify_restored; then
      err "3-wayマージが衝突した。abort してマージ前の状態に戻した。"
      err "衝突したファイル:"
      printf '%s\n' "$conflicted_files" >&2
      emit_result "CONFLICT"
      exit 2
    else
      err "3-wayマージが衝突し、かつ abort による状態の復元も確認できなかった。"
      err "メインの作業木の状態を手動で確認すること: $REPO_ROOT"
      emit_result "ERROR"
      exit 3
    fi
  fi

  if [ "$merge_status" -ne 0 ]; then
    # 衝突ではないが merge 自体が失敗した（想定外）。安全側に倒し、
    # 進行中のマージがあれば abort してマージ前の状態に戻す。
    err "3-wayマージが衝突以外の理由で失敗した: $merge_output"
    if ! abort_and_verify_restored; then
      err "abort による状態の復元も確認できなかった。メインの作業木の状態を手動で確認すること: $REPO_ROOT"
    fi
    emit_result "ERROR"
    exit 3
  fi

  if ! git -C "$REPO_ROOT" commit --no-edit >/dev/null 2>&1; then
    # 衝突は無くマージ自体は進んだが、コミットに失敗した（フック等）。
    # 安全側に倒し、abort してマージ前の状態に戻す。
    err "衝突は無かったがマージコミットに失敗した。"
    if ! abort_and_verify_restored; then
      err "abort による状態の復元も確認できなかった。メインの作業木の状態を手動で確認すること: $REPO_ROOT"
    fi
    emit_result "ERROR"
    exit 3
  fi

  echo "3-wayマージ（衝突無し）でマージした: $BRANCH"
fi

merged_sha="$(git -C "$REPO_ROOT" rev-parse --short HEAD)"
echo "main の位置: $merged_sha"

# ---- 7-8. 対応するワークツリー・作業ブランチを片付ける ----
# git branch -d は安全削除（HEAD にマージ済みでないブランチは拒否する）であり、
# --force に相当する -D は使わない。ワークツリーの片付けに失敗してブランチが
# まだそのワークツリーで使用中の場合も、この削除は失敗する。いずれの失敗も
# エラーを報告するだけに留め、--force はせず、スクリプト全体の結果
# （exit code・RESULT）は変えない。
cleanup_worktree_and_branch "$REPO_ROOT" "$BRANCH"

emit_result "MERGED"
exit 0
