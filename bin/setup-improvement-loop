#!/usr/bin/env bash
# improvement-loop の内容（claude skills / backlog 設定）を、対象リポジトリへ
# 冪等に「安全収束」させる形で配置する。
#
# 使い方:
#   setup-improvement-loop [対象リポジトリのパス]
#   setup-improvement-loop --workspace [対象ワークスペースディレクトリのパス]
# 引数を省略した場合はカレントディレクトリを対象とする。
#
# --workspace は、対象を単一リポジトリではなくワークスペースディレクトリとして扱い、
# claude-code/workspace-skills/ 配下のスキル一式を配置する別経路（setup_workspace）に
# 切り替える。この経路では backlog init も .backlog/ 配下の配置も行わないため、
# backlog CLI は不要で、対象ディレクトリが git リポジトリである必要も無い。
#
# 冪等性の方針:
#   - シンボリックリンクは正しいリンク先を指していれば何もしない。別の実体
#     （別リンク先のリンクを含む）が既に存在すればエラーで停止する。
#   - .backlog/config.my.yml はユーザー所有ファイルなので、既存のキーの値・コメントは
#     上書きしない。テンプレートにあって導入先に無いキーだけを補う。既にあるキーの
#     説明コメントの食い違いは書き換えず警告にとどめる（理由は
#     warn_config_my_yml_comment_drift のコメント）。
#   - .git/info/exclude への追記は、同じ行が無い場合だけ行う。
#   - backlog init は .backlog/config.yml が無いときだけ実行する。
#   - .backlog/config.yml の statuses は、欠けている improvement ループ既定の
#     ステータスだけを補う（既存の要素・順序・ユーザー独自のステータスは変更しない）。

set -euo pipefail

# improvement ループのスキルが前提とする状態遷移。この順序を正準順序として、
# 欠けているものを config.yml の statuses に補う。
REQUIRED_STATUSES=(Proposed "To Do" "In Progress" "In Review" Approved Done)

log() {
  printf '%s\n' "$*"
}

err() {
  printf 'エラー: %s\n' "$*" >&2
}

# $1 が残りの引数リストに含まれていれば真を返す。
array_contains() {
  local needle="$1"
  shift
  local item
  for item in "$@"; do
    if [ "$item" = "$needle" ]; then
      return 0
    fi
  done
  return 1
}

# $1 が残りの引数リストの何番目にあるかを標準出力に書く。無ければ -1。
array_index_of() {
  local needle="$1"
  shift
  local i=0
  local item
  for item in "$@"; do
    if [ "$item" = "$needle" ]; then
      printf '%s\n' "$i"
      return 0
    fi
    i=$((i + 1))
  done
  printf '%s\n' "-1"
}

# .backlog/config.yml の statuses を解析する（インライン配列形式と複数行YAMLリスト
# 形式の両方）。結果は次のグローバル変数に書く。サブシェル化すると呼び出し元へ
# 伝わらないので、コマンド置換 $(...) 経由で呼ばないこと。
#   PARSED_STATUSES_LINE_NUM     statuses 行の開始行番号
#   PARSED_STATUSES_END_LINE_NUM 置換・削除すべき行範囲の終端行番号
#     （インライン形式では開始行と同じ。複数行リスト形式では連続する "  - ..." 行の末尾まで）
#   PARSED_STATUSES_LINE_RAW     statuses 行そのものの生テキスト
#   PARSED_STATUSES_ITEMS        既存要素の配列（順序保持、ユーザー独自ステータス含む）
# python3 等の追加依存を避け、grep/sed/awk のみで実装する。引用符除去は
# bin/lib/yaml_unquote.sh の trim_and_unquote() を使い、check-forbidden-allowed-paths の
# parse_path_list と挙動を一致させる。
parse_statuses_block() {
  local config_file="$1"

  PARSED_STATUSES_LINE_NUM="$(grep -n -m1 '^statuses:' "$config_file" | cut -d: -f1 || true)"
  if [ -z "$PARSED_STATUSES_LINE_NUM" ]; then
    err "config.yml に statuses 行が見つからない。手動で確認すること: $config_file"
    exit 1
  fi

  PARSED_STATUSES_LINE_RAW="$(sed -n "${PARSED_STATUSES_LINE_NUM}p" "$config_file")"
  PARSED_STATUSES_END_LINE_NUM=$PARSED_STATUSES_LINE_NUM
  PARSED_STATUSES_ITEMS=()

  if [[ "$PARSED_STATUSES_LINE_RAW" == *'['* ]]; then
    # インライン配列形式（例: statuses: ["To Do", "Done"]）。
    local inline_content=""
    if [[ "$PARSED_STATUSES_LINE_RAW" =~ \[(.*)\] ]]; then
      inline_content="${BASH_REMATCH[1]}"
    fi
    if [ -n "${inline_content//[[:space:]]/}" ]; then
      local raw_items=() raw_item trimmed
      IFS=',' read -ra raw_items <<<"$inline_content"
      for raw_item in "${raw_items[@]}"; do
        trimmed="$(trim_and_unquote "$raw_item")"
        if [ -n "$trimmed" ]; then
          PARSED_STATUSES_ITEMS+=("$trimmed")
        fi
      done
    fi
  else
    # 複数行YAMLリスト形式。statuses: の直後から連続する "- ..." 行を集める。
    local total_lines next_line_num list_line item
    total_lines="$(awk 'END { print NR }' "$config_file")"
    next_line_num=$((PARSED_STATUSES_LINE_NUM + 1))
    while [ "$next_line_num" -le "$total_lines" ]; do
      list_line="$(sed -n "${next_line_num}p" "$config_file")"
      if ! printf '%s' "$list_line" | grep -Eq '^[[:space:]]*-'; then
        break
      fi
      item="$(trim_and_unquote "${list_line#*-}")"
      PARSED_STATUSES_ITEMS+=("$item")
      PARSED_STATUSES_END_LINE_NUM=$next_line_num
      next_line_num=$((next_line_num + 1))
    done
  fi
}

# parse_statuses_block が読み取った行範囲を、渡された要素列でインライン配列形式1行に
# 置換して書き戻し、その新しい行を標準出力に返す。呼び出し前に同じ config_file で
# parse_statuses_block を実行しておくこと（PARSED_STATUSES_* を使う）。
# 引数: config_file, item1, item2, ...（0個も可）
write_statuses_block() {
  local config_file="$1"
  shift
  local -a items=(${1+"$@"})

  local new_line="statuses: ["
  local i
  for i in "${!items[@]}"; do
    if [ "$i" -gt 0 ]; then
      new_line+=", "
    fi
    new_line+="\"${items[$i]}\""
  done
  new_line+="]"
  # 元の行が `]` の後に持っていたもの（末尾コメント等）は保持する。`]` を含まない行
  # ではこの展開が非マッチとなり元の行全体を返してしまうので、含む場合だけ適用する。
  if [[ "$PARSED_STATUSES_LINE_RAW" == *']'* ]]; then
    new_line+="${PARSED_STATUSES_LINE_RAW##*]}"
  fi

  local tmp_file
  tmp_file="$(mktemp "${config_file}.XXXXXX")"
  awk -v newline="$new_line" -v start="$PARSED_STATUSES_LINE_NUM" -v end="$PARSED_STATUSES_END_LINE_NUM" '
    NR == start { print newline; next }
    NR > start && NR <= end { next }
    { print }
  ' "$config_file" > "$tmp_file"
  mv "$tmp_file" "$config_file"

  printf '%s\n' "$new_line"
}

# REQUIRED_STATUSES のうち欠けているものだけを正準順序の位置に挿入する。
# 既存の要素（ユーザー独自のステータスを含む）は順序も含め一切変更しない。
# 複数行リスト形式で検出した場合は、書き戻し時にインライン配列形式へ正規化する
# （インライン形式のケースの出力は従来通り変更しない）。
ensure_backlog_statuses() {
  local config_file="$1"

  parse_statuses_block "$config_file"
  local existing=(${PARSED_STATUSES_ITEMS[@]+"${PARSED_STATUSES_ITEMS[@]}"})

  # bash 3.2（macOS の既定 /bin/bash）は set -u 下で空配列を "${arr[@]}" と
  # 無条件展開すると unbound variable で落ちる。既存 statuses が空（statuses: []）
  # のときに踏むため、"${arr[@]+"${arr[@]}"}" 形式のガード付き展開を使う。
  local working=(${existing[@]+"${existing[@]}"})

  local status
  for status in "${REQUIRED_STATUSES[@]}"; do
    if array_contains "$status" ${working[@]+"${working[@]}"}; then
      continue
    fi
    # 正準順序で status より後にあり、working に既に存在する最初のものの直前へ
    # 挿入する。無ければ末尾に追加する。
    local insert_idx=${#working[@]}
    local reached=false
    local candidate
    for candidate in "${REQUIRED_STATUSES[@]}"; do
      if [ "$reached" = true ]; then
        local idx
        idx="$(array_index_of "$candidate" ${working[@]+"${working[@]}"})"
        if [ "$idx" -ge 0 ]; then
          insert_idx="$idx"
          break
        fi
      fi
      if [ "$candidate" = "$status" ]; then
        reached=true
      fi
    done
    working=("${working[@]:0:insert_idx}" "$status" "${working[@]:insert_idx}")
  done

  if [ "${#working[@]}" -eq "${#existing[@]}" ]; then
    log "[skip] .backlog/config.yml の statuses は既に improvement ループの既定ステータスをすべて含む。"
    SKIPPED+=(".backlog/config.yml statuses (既に揃っている)")
    return 0
  fi

  local new_line
  new_line="$(write_statuses_block "$config_file" ${working[@]+"${working[@]}"})"

  log "[fix]  .backlog/config.yml の statuses を更新した: $new_line"
  CREATED+=(".backlog/config.yml statuses (不足していた improvement ループの既定ステータスを追加)")
}

# .backlog/config.yml の statuses に残る旧名 "Reviewed" を取り除く（"Approved" への統合）。
# 既に存在しなければ何もしない。
#
# 呼び出しは、対象タスクの移行（migrate_reviewed_tasks）より後に行うこと。
# "Reviewed" を config.yml の有効なステータス値から先に外すと、将来の backlog CLI が
# --status の値を configured statuses に対して厳格に検証するようになった場合、
# 旧ステータスのタスクを検出・移行できなくなるおそれがある（安全側に倒す）。
migrate_reviewed_status_in_config() {
  local config_file="$1"

  parse_statuses_block "$config_file"
  local existing=(${PARSED_STATUSES_ITEMS[@]+"${PARSED_STATUSES_ITEMS[@]}"})

  if ! array_contains "Reviewed" ${existing[@]+"${existing[@]}"}; then
    log "[skip] .backlog/config.yml の statuses に旧名 'Reviewed' は残っていない。"
    SKIPPED+=(".backlog/config.yml statuses (Reviewed の移行は不要)")
    return 0
  fi

  # "Reviewed" だけを取り除き、他の要素の順序・値は変更しない。
  local working=()
  local item
  for item in ${existing[@]+"${existing[@]}"}; do
    if [ "$item" = "Reviewed" ]; then
      continue
    fi
    working+=("$item")
  done

  local new_line
  new_line="$(write_statuses_block "$config_file" ${working[@]+"${working[@]}"})"

  log "[fix]  .backlog/config.yml の statuses から旧名 'Reviewed' を除去した: $new_line"
  CREATED+=(".backlog/config.yml statuses (旧名 Reviewed を Approved に統合)")
}

# 対象リポジトリに status: Reviewed の既存タスクがあれば、backlog CLI 経由で
# Approved へ移行する。.backlog/ 配下の md ファイルは直接書き換えない。
# `backlog task list --status "Reviewed" --plain` は "Reviewed" が statuses に
# 無くてもエラーにならないので、事前の存在チェックはせず常に呼び出す。
migrate_reviewed_tasks() {
  local target_repo_root="$1"

  local list_output
  if ! list_output="$(cd "$target_repo_root" && backlog task list --status "Reviewed" --plain 2>&1)"; then
    err "対象リポジトリで 'backlog task list --status \"Reviewed\"' が失敗した: $list_output"
    exit 1
  fi

  # ID の接頭辞は config.yml の task_prefix 次第で "TASK-" とは限らない。固定パターンで
  # 抽出すると、prefix をカスタマイズしたリポジトリでタスクを一切検出できず、statuses から
  # だけ "Reviewed" が消えてタスク側が取り残される。一方、行のどこかにある ID らしき
  # 文字列を無条件に拾うと title 中の "TASK-999" まで誤検出する。そこで、行頭の空白・
  # タグ群を取り除いた直後の "<接頭辞>-<n> - " だけを ID として採用する
  # （select-next-task の extract_task_id と同じ正規表現）。
  local task_ids=()
  while IFS= read -r id; do
    [ -n "$id" ] && task_ids+=("$id")
  done < <(printf '%s\n' "$list_output" \
    | sed -E 's/^[[:space:]]+(\[[^]]*\][[:space:]]*)*//' \
    | grep -E '^[A-Za-z][A-Za-z0-9_-]*-[0-9]+ - ' \
    | sed -E 's/^([A-Za-z][A-Za-z0-9_-]*-[0-9]+) - .*/\1/' \
    | sort -u)

  if [ "${#task_ids[@]}" -eq 0 ]; then
    log "[skip] status: Reviewed の既存タスクは見つからなかった。"
    SKIPPED+=("status: Reviewed の既存タスク移行 (対象タスクなし)")
    return 0
  fi

  local id
  for id in "${task_ids[@]}"; do
    if ! (cd "$target_repo_root" && backlog task edit "$id" -s "Approved" --plain) >/dev/null; then
      err "対象リポジトリでタスク $id を Approved へ移行できなかった。手動で確認すること。"
      exit 1
    fi
    log "[fix]  $id の status を Reviewed から Approved へ移行した。"
  done
  CREATED+=("status: Reviewed の既存タスク移行 (${#task_ids[@]} 件を Approved へ: ${task_ids[*]})")
}

# backlog CLI の remote git 操作（fetch 等）に依存させる理由が無いので、
# backlog init --defaults の既定値 remoteOperations: true を false に収束させる。
# ユーザーが後から明示的に true へ戻した場合はそれを正とし、再実行では上書きしない
# （false であることだけを確認し、既に false ならスキップする）。
ensure_remote_operations_disabled() {
  local target_repo_root="$1"

  local current
  current="$(cd "$target_repo_root" && backlog config get remoteOperations 2>/dev/null)" || current=""
  if [ "$current" = "false" ]; then
    log "[skip] backlog config の remoteOperations は既に false。"
    SKIPPED+=("backlog config remoteOperations (既に false)")
    return 0
  fi

  if ! (cd "$target_repo_root" && backlog config set remoteOperations false) >/dev/null; then
    err "backlog config set remoteOperations false に失敗した。手動で確認すること。"
    exit 1
  fi
  log "[fix]  backlog config set remoteOperations false を実行した。"
  CREATED+=("backlog config remoteOperations (false に設定)")
}

# タスクの起票者を improvement-loop-bot に統一する既定アサイニー設定。
# backlog CLI 1.48.0（README.md 記載の動作確認済み最小バージョン）にはこのキーが
# 無く `backlog config set defaultAssignee` は "Unknown config key" で失敗するため、
# CLI が対応していれば正規の手段で設定し、対応していなければ config.yml へ直接
# 追記する（将来 CLI が読めるようになった時点で有効になる）。
# 既に default_assignee があればユーザーの値を優先し、上書きしない。
ensure_default_assignee() {
  local target_repo_root="$1"
  local config_file="$2"
  local bot_assignee='@improvement-loop-bot'

  if grep -Eq '^default_assignee:' "$config_file"; then
    log "[skip] .backlog/config.yml に default_assignee は既に設定されている。"
    SKIPPED+=(".backlog/config.yml default_assignee (既に設定済み)")
    return 0
  fi

  if (cd "$target_repo_root" && backlog config set defaultAssignee "$bot_assignee") >/dev/null 2>&1; then
    log "[fix]  backlog config set defaultAssignee \"$bot_assignee\" を実行した。"
    CREATED+=(".backlog/config.yml default_assignee (backlog config set)")
    return 0
  fi

  printf '%s\n' "default_assignee: [\"$bot_assignee\"]" >> "$config_file"
  log "[fix]  backlog CLI が defaultAssignee 未対応のため、.backlog/config.yml に直接追記した: default_assignee: [\"$bot_assignee\"]"
  CREATED+=(".backlog/config.yml default_assignee (CLI未対応のため直接追記)")
}

# `.claude/skills/<name>` へのシンボリックリンクを冪等に配置する（単一リポジトリ経路と
# --workspace 経路の両方から呼ぶ）。正しいリンク先を指していれば何もせず、別の実体が
# あればエラーで停止し、無ければ新規作成する。
# グローバル変数 CREATED / SKIPPED と resolve_path() に依存する。
# 引数: $1=ソースディレクトリ, $2=配置先の .claude/skills, $3以降=スキル名のリスト
place_skill_symlinks() {
  local source_dir="$1"
  local target_skills_dir="$2"
  shift 2
  local -a names=("$@")

  mkdir -p "$target_skills_dir"

  local name src dest resolved_existing resolved_src
  for name in "${names[@]}"; do
    src="$source_dir/$name"
    dest="$target_skills_dir/$name"

    if [ ! -d "$src" ]; then
      err "配布元にスキルディレクトリが無い: $src"
      exit 1
    fi

    if [ -L "$dest" ]; then
      # リンク切れの場合 resolve_path が非ゼロ終了しうる。set -e で落とさず
      # 「別のリンク先」として扱う。
      resolved_existing="$(resolve_path "$dest" 2>/dev/null)" || resolved_existing=""
      resolved_src="$(resolve_path "$src")"
      if [ "$resolved_existing" = "$resolved_src" ]; then
        log "[skip] .claude/skills/$name は既に正しいリンク先を指している。"
        SKIPPED+=(".claude/skills/$name (既存の正しいリンク)")
        continue
      else
        err ".claude/skills/$name は既に別のリンク先を指すシンボリックリンクである: $(readlink "$dest")"
        err "手動で確認・削除してから再実行すること。"
        exit 1
      fi
    elif [ -e "$dest" ]; then
      err ".claude/skills/$name にはシンボリックリンクではない実体が既に存在する: $dest"
      err "手動で確認・削除してから再実行すること。"
      exit 1
    else
      ln -s "$src" "$dest"
      log "[new]  .claude/skills/$name -> $src"
      CREATED+=(".claude/skills/$name (symlink)")
    fi
  done
}

# 対象リポジトリの .git/info/exclude に、見出しコメント "# improvement-loop" と
# 指定された行群を冪等に追記する。同じ行が既にあれば追記しない。
# グローバル変数 CREATED / SKIPPED に依存する。
# 引数: $1=対象リポジトリのルート（git リポジトリであること）, $2以降=追記する行
append_git_exclude_lines() {
  local target_repo_root="$1"
  shift
  local -a lines=("$@")

  local git_dir exclude_file
  git_dir="$(git -C "$target_repo_root" rev-parse --git-dir)"
  case "$git_dir" in
    /*) : ;;
    *) git_dir="$target_repo_root/$git_dir" ;;
  esac
  exclude_file="$git_dir/info/exclude"
  mkdir -p "$git_dir/info"
  touch "$exclude_file"

  # 追記する行群の由来を示す見出しコメント。既存の他ツールの行と同じ書式
  # （対象行の直前に置く1行コメント）に倣う。
  local exclude_header="# improvement-loop"
  if grep -Fxq "$exclude_header" "$exclude_file" 2>/dev/null; then
    log "[skip] .git/info/exclude には既に見出しコメント '$exclude_header' がある。"
    SKIPPED+=(".git/info/exclude: $exclude_header")
  else
    printf '%s\n' "$exclude_header" >> "$exclude_file"
    log "[new]  .git/info/exclude に見出しコメント '$exclude_header' を追記した。"
    CREATED+=(".git/info/exclude: $exclude_header")
  fi

  local line
  for line in "${lines[@]}"; do
    if grep -Fxq "$line" "$exclude_file" 2>/dev/null; then
      log "[skip] .git/info/exclude には既に '$line' がある。"
      SKIPPED+=(".git/info/exclude: $line")
    else
      printf '%s\n' "$line" >> "$exclude_file"
      log "[new]  .git/info/exclude に '$line' を追記した。"
      CREATED+=(".git/info/exclude: $line")
    fi
  done
}

# `--workspace` 経路のセットアップ本体。対象ディレクトリ（git リポジトリでなくてよい）に
# claude-code/workspace-skills/ 配下のスキル一式（実行時に動的列挙）を `.claude/skills/`
# へ冪等に配置する。backlog init や .backlog/ 配下の配置は一切行わない。
# 対象が git リポジトリでもある場合だけ、配置したパスを .git/info/exclude に追記する。
setup_workspace() {
  local target_dir="$1"

  log "対象ワークスペース: $target_dir"
  log ""

  CREATED=()
  SKIPPED=()

  if [ ! -d "$SOURCE_WORKSPACE_SKILLS_DIR" ]; then
    err "配布元の claude-code/workspace-skills ディレクトリが見つからない: $SOURCE_WORKSPACE_SKILLS_DIR"
    exit 1
  fi

  # ディレクトリの実体を単一の情報源として動的に列挙する（単一リポジトリ経路の
  # SKILL_NAMES と同じ方式）。
  shopt -s nullglob
  local workspace_skill_names=()
  local skill_dir
  for skill_dir in "$SOURCE_WORKSPACE_SKILLS_DIR"/*/; do
    workspace_skill_names+=("$(basename "$skill_dir")")
  done
  shopt -u nullglob
  if [ "${#workspace_skill_names[@]}" -eq 0 ]; then
    err "配布元の claude-code/workspace-skills 配下にスキルディレクトリが1つも無い: $SOURCE_WORKSPACE_SKILLS_DIR"
    exit 1
  fi

  local target_skills_dir="$target_dir/.claude/skills"
  place_skill_symlinks "$SOURCE_WORKSPACE_SKILLS_DIR" "$target_skills_dir" "${workspace_skill_names[@]}"

  if git -C "$target_dir" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    local exclude_lines=()
    local name
    for name in "${workspace_skill_names[@]}"; do
      exclude_lines+=(".claude/skills/$name")
    done
    append_git_exclude_lines "$target_dir" "${exclude_lines[@]}"
  fi

  log ""
  log "=== サマリー ==="
  log "作成/実行した項目 (${#CREATED[@]} 件):"
  if [ "${#CREATED[@]}" -eq 0 ]; then
    log "  (なし)"
  else
    for item in "${CREATED[@]}"; do
      log "  - $item"
    done
  fi
  log "スキップした項目 (${#SKIPPED[@]} 件):"
  if [ "${#SKIPPED[@]}" -eq 0 ]; then
    log "  (なし)"
  else
    for item in "${SKIPPED[@]}"; do
      log "  - $item"
    done
  fi
  # 案内ログの一覧文字列は実体の動的列挙結果から組み立てる（ハードコードしないので、
  # スキルが増減しても案内が自動追従する）。
  local placed_skill_list=""
  local placed_skill_name
  for placed_skill_name in "${workspace_skill_names[@]}"; do
    if [ -z "$placed_skill_list" ]; then
      placed_skill_list="$placed_skill_name"
    else
      placed_skill_list="$placed_skill_list / $placed_skill_name"
    fi
  done

  log ""
  log "次にすること:"
  log "  1. ワークスペース配下の各リポジトリで 'setup-improvement-loop <リポジトリのパス>'（--workspace 無し）を実行し、improvement-dispatch / improvement-scout を opt-in させる"
  log "  2. $placed_skill_list スキルを、このワークスペースディレクトリで使う（opt-in 済みのリポジトリだけを対象に横断処理する）"
}

# config.my.yml の improvement_loop: 配下の「有効なキー」（コメントアウトされていない
# キー行）の名前を、出現順に1行1件で標準出力に書く。ensure_config_my_yml_keys と
# warn_config_my_yml_comment_drift でキーの見つけ方を共有するための共通ヘルパー
# （正規表現を二重に持つと、片方だけ直したときに食い違う）。
list_config_my_yml_keys() {
  grep -E '^  [A-Za-z0-9_]+:' "$1" | sed -E 's/^  ([A-Za-z0-9_]+):.*/\1/'
}

# config.my.yml（テンプレート・導入先のどちらでも）から、指定したキーの「ブロック」を
# 抽出して標準出力に書く。ブロックとは、そのキー行の直前にある連続する2スペース
# インデントのコメント行（キーの説明・既定値の記述）である。空行または別のキー行に
# 当たった時点で、それ以前に溜めたコメント行は別のキーのものとして捨てる。
# 第3引数が "with-key"（既定）ならキー行自体も末尾に含め、"comments-only" なら
# コメント行だけを出す。該当キーが無ければ何も出力しない。
extract_config_my_yml_block() {
  local file="$1"
  local key="$2"
  local mode="${3:-with-key}"

  awk -v key="$key" -v mode="$mode" '
    BEGIN { n = 0 }
    {
      line = $0
      if (line ~ /^[[:space:]]*$/) { n = 0; next }
      if (line ~ ("^  " key ":")) {
        for (i = 1; i <= n; i++) print buf[i]
        if (mode != "comments-only") print line
        exit
      }
      if (line ~ /^  [A-Za-z0-9_]+:/) { n = 0; next }
      if (line ~ /^  #/) { n++; buf[n] = line; next }
      n = 0
    }
  ' "$file"
}

# 配布元テンプレート（backlog-md/config.my.yml）にあって導入先の .backlog/config.my.yml
# に無いキーだけを、テンプレート側のコメント・既定値付きで補う。
# 対応するのはキーの新規追加のみで、rename・削除・意味変更には対応しない。導入先に
# 既にあるキーの値・コメントは変更せず、テンプレートに無いユーザー独自のキーも残す。
# 導入先で当該キーがコメントアウトされている場合（例: "  # max_in_review: 3"）は
# 「未設定」ではなく「ユーザーが意図的に無効化した」状態として扱い、再追記しない。
ensure_config_my_yml_keys() {
  local target_file="$1"
  local source_file="$2"

  local source_keys=()
  while IFS= read -r k; do
    source_keys+=("$k")
  done < <(list_config_my_yml_keys "$source_file")

  local target_keys=()
  while IFS= read -r k; do
    target_keys+=("$k")
  done < <(list_config_my_yml_keys "$target_file")

  local missing_keys=()
  local commented_keys=()
  local key
  for key in "${source_keys[@]}"; do
    if array_contains "$key" ${target_keys[@]+"${target_keys[@]}"}; then
      continue
    fi
    # 同名キーがコメントアウトされた形で存在するなら、ユーザーが意図的に無効化した
    # ものとみなし「不足」扱いにしない。キー名の完全一致だけを見るので、説明文の
    # コメント（例: "# 既定値: 3"）には誤爆しない。
    if grep -Eq "^[[:space:]]*#[[:space:]]*${key}:" "$target_file"; then
      commented_keys+=("$key")
      continue
    fi
    missing_keys+=("$key")
  done

  if [ "${#commented_keys[@]}" -gt 0 ]; then
    for key in "${commented_keys[@]}"; do
      log "[skip] .backlog/config.my.yml のキー '$key' はコメントアウトされている。ユーザーが意図的に無効化したとみなし、有効な形では追記しない。"
    done
    SKIPPED+=(".backlog/config.my.yml (コメントアウトされたキーのため追記をスキップ: ${commented_keys[*]})")
  fi

  if [ "${#missing_keys[@]}" -eq 0 ]; then
    log "[skip] .backlog/config.my.yml は既にテンプレートの全キーを含む（コメントアウトされたキーを除く）。"
    SKIPPED+=(".backlog/config.my.yml (既にテンプレートの全キーを含む)")
    return 0
  fi

  for key in "${missing_keys[@]}"; do
    local block
    block="$(extract_config_my_yml_block "$source_file" "$key" with-key)"

    if [ -z "$block" ]; then
      err "config.my.yml テンプレートからキー '$key' のブロックを抽出できなかった。手動で確認すること: $source_file"
      exit 1
    fi

    printf '\n%s\n' "$block" >> "$target_file"
    log "[fix]  .backlog/config.my.yml にキー '$key' を追加した。"
  done

  CREATED+=(".backlog/config.my.yml (不足していたキーを追加: ${missing_keys[*]})")
}

# 導入先の .backlog/config.my.yml に既にあるキーの説明コメントが、配布元テンプレートと
# 異なっていないかを確認し、異なるものを警告として報告する。ファイルは書き換えない。
#
# 解こうとしている問題: ensure_config_my_yml_keys が補うのは不足しているキーだけなので、
# 既にあるキーの説明コメントは永久に更新されない。テンプレート側に重要な訂正が入っても、
# 既に導入済みのリポジトリには再実行しても届かない。
#
# なぜ書き換えず警告にとどめるか: 導入先の config.my.yml には「どのテンプレート版から
# 導入されたか」の記録が無い。あるコメント行が古いテンプレート由来なのか、ユーザーが
# 自分で書き足したものなのかを区別できる情報が原理的に無い。ユーザー所有ファイルを
# 壊さないことを優先し、読み比べを人間に促すにとどめる。
#
# 検出対象は、テンプレートと導入先の双方に有効なキー行として存在するキーだけである。
# 導入先に無いキーは ensure_config_my_yml_keys がコメントごと追記するので定義上ズレず、
# コメントアウトされたキーはブロック抽出の起点が "^  <キー名>:" である以上検出できない。
#
# 比較はコメント行の完全一致で行い、キー行（＝ユーザーが決めた値）は比較しない。
# そのためユーザーが説明にメモを書き足した場合も、逆に説明を全部削って値だけにした
# 場合も差異として報告され、その状態のままなら毎回同じ報告が出る。これも上と同じ理由
# （どちらが新しいかを区別できない）による意図的な振る舞いである。
warn_config_my_yml_comment_drift() {
  local target_file="$1"
  local source_file="$2"

  local source_keys=()
  while IFS= read -r k; do
    source_keys+=("$k")
  done < <(list_config_my_yml_keys "$source_file")

  local target_keys=()
  while IFS= read -r k; do
    target_keys+=("$k")
  done < <(list_config_my_yml_keys "$target_file")

  local drifted_keys=()
  local key source_comments target_comments
  for key in ${source_keys[@]+"${source_keys[@]}"}; do
    if ! array_contains "$key" ${target_keys[@]+"${target_keys[@]}"}; then
      continue
    fi
    source_comments="$(extract_config_my_yml_block "$source_file" "$key" comments-only)"
    target_comments="$(extract_config_my_yml_block "$target_file" "$key" comments-only)"
    if [ "$source_comments" = "$target_comments" ]; then
      continue
    fi
    drifted_keys+=("$key")
  done

  if [ "${#drifted_keys[@]}" -eq 0 ]; then
    log "[skip] .backlog/config.my.yml の既存キーの説明コメントは配布元テンプレートと一致している。"
    SKIPPED+=(".backlog/config.my.yml (既存キーの説明コメントはテンプレートと一致)")
    return 0
  fi

  local line
  for key in "${drifted_keys[@]}"; do
    log "[warn] .backlog/config.my.yml のキー '$key' の説明コメントが配布元テンプレートと異なる。"
    log "       テンプレート側の説明が更新されている場合、その内容は導入先には自動では反映されない。"
    log "       ユーザー所有ファイルを壊さないため、このスクリプトは書き換えない。次のテンプレート側の説明を読み、必要なら手で反映すること。"
    log "       --- 配布元テンプレート ($source_file) の '$key' の説明 ---"
    while IFS= read -r line; do
      log "       $line"
    done < <(extract_config_my_yml_block "$source_file" "$key" comments-only)
    log "       --- ここまで ---"
  done
  WARNED+=(".backlog/config.my.yml (説明コメントがテンプレートと異なるキー: ${drifted_keys[*]})")
}

# ---- 0. このスクリプト自身の場所から、配布元リポジトリのルートを解決する ----
# install.zsh が $HOME/.local/bin にシンボリックリンクを張るため、BASH_SOURCE を
# そのまま使うとリンク自身の場所を基準にしてしまう。先に解決する必要がある。
#
# このブートストラップの1回だけは resolve_path() の唯一の定義（bin/lib/resolve_path.sh）
# を source できない。symlink 経由で実行された場合、この時点で分かっているのは自分の
# 実体の場所（例: ~/.local/bin。隣に lib/ は無い）だけで、source すべきパスはまだ
# 求まっていないからである。つまり symlink を解決するためのロジックを外部ファイルの
# source に頼ると、その外部ファイルの場所自体が解決前には分からないという循環になる。
# そのためここ1箇所だけ同じ判定のコピーを別名関数として残す。以降の呼び出しは、
# ルートが判明した後に source した単一の定義を使う。
_bootstrap_resolve_own_path() {
  if command -v realpath >/dev/null 2>&1; then
    realpath "$1"
  elif readlink -f "$1" >/dev/null 2>&1; then
    readlink -f "$1"
  else
    local dir base
    dir="$(cd "$(dirname "$1")" && pwd -P)"
    base="$(basename "$1")"
    printf '%s/%s\n' "$dir" "$base"
  fi
}
SCRIPT_SOURCE="$(_bootstrap_resolve_own_path "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_SOURCE")" && pwd)"
SOURCE_REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
SOURCE_SKILLS_DIR="$SOURCE_REPO_ROOT/claude-code/skills"
SOURCE_CONFIG_FILE="$SOURCE_REPO_ROOT/backlog-md/config.my.yml"
# --workspace 経路専用のスキル配布元。claude-code/skills/（SOURCE_SKILLS_DIR）とは
# 意図的に別ディレクトリにしてある。混在させると単一リポジトリ経路の動的列挙に
# 自動的に混入してしまうためである。
SOURCE_WORKSPACE_SKILLS_DIR="$SOURCE_REPO_ROOT/claude-code/workspace-skills"

# shellcheck source=lib/resolve_path.sh
source "$SCRIPT_DIR/lib/resolve_path.sh"

# parse_statuses_block が使う。
# shellcheck source=lib/yaml_unquote.sh
source "$SCRIPT_DIR/lib/yaml_unquote.sh"

if [ ! -d "$SOURCE_SKILLS_DIR" ]; then
  err "配布元の claude-code/skills ディレクトリが見つからない: $SOURCE_SKILLS_DIR"
  exit 1
fi
if [ ! -f "$SOURCE_CONFIG_FILE" ]; then
  err "配布元の config.my.yml が見つからない: $SOURCE_CONFIG_FILE"
  exit 1
fi

# claude-code/skills/ の実体を単一の情報源として動的に列挙する。ハードコードすると、
# 新しいスキルディレクトリを追加したときに配置漏れが起き、しかもエラーにならない。
shopt -s nullglob
SKILL_NAMES=()
for skill_dir in "$SOURCE_SKILLS_DIR"/*/; do
  SKILL_NAMES+=("$(basename "$skill_dir")")
done
shopt -u nullglob
if [ "${#SKILL_NAMES[@]}" -eq 0 ]; then
  err "配布元の claude-code/skills 配下にスキルディレクトリが1つも無い: $SOURCE_SKILLS_DIR"
  exit 1
fi

# ---- 1. 引数解析（--workspace フラグと位置引数） ----
# --workspace はどの位置に来てもよいフラグとして扱い、それを取り除いた残りの先頭を
# 対象パスとする。ここではフラグの切り分けだけを行い、対象パスの存在確認のような
# ファイルシステムを触る処理はしない（前提コマンドの確認を対象パスの解決より先に
# 行う順序を保つため）。
WORKSPACE_MODE=false
POSITIONAL_ARGS=()
for arg in "$@"; do
  case "$arg" in
    --workspace)
      WORKSPACE_MODE=true
      ;;
    *)
      POSITIONAL_ARGS+=("$arg")
      ;;
  esac
done

# ---- 2. 前提コマンドの確認 ----
# 存在確認のみでバージョンは見ない。backlog CLI の動作確認済み最小バージョンは
# 1.48.0（README.md 参照）で、それより古いと --add-label 等が使えず、スキルの
# 実行中に初めてエラーになることがある。
# git は --workspace 経路でも git リポジトリかどうかの判定に使うので常に必須。
# backlog は --workspace 経路では使わないので、そのときだけ必須から外す。
# この確認は対象パスの解決より先に行う（順序を変えないこと）。
REQUIRED_CMDS=(git)
if [ "$WORKSPACE_MODE" != true ]; then
  REQUIRED_CMDS+=(backlog)
fi
for cmd in "${REQUIRED_CMDS[@]}"; do
  if ! command -v "$cmd" >/dev/null 2>&1; then
    err "コマンド '$cmd' が見つからない。インストールしてから再実行すること。"
    exit 1
  fi
done

# ---- 3. 対象パスの解決 ----
TARGET_DIR_ARG="${POSITIONAL_ARGS[0]:-$(pwd)}"
if [ ! -d "$TARGET_DIR_ARG" ]; then
  err "対象ディレクトリが存在しない: $TARGET_DIR_ARG"
  exit 1
fi
TARGET_REPO_ROOT="$(cd "$TARGET_DIR_ARG" && pwd)"

# 以降（git リポジトリ判定、backlog init、.backlog/ 配下の配置等）は --workspace 無しの
# 既定動作専用である。
if [ "$WORKSPACE_MODE" = true ]; then
  setup_workspace "$TARGET_REPO_ROOT"
  exit 0
fi

if ! git -C "$TARGET_REPO_ROOT" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  err "対象ディレクトリは git リポジトリではない: $TARGET_REPO_ROOT"
  err "複数の git リポジトリを含むワークスペースディレクトリを対象にする場合は、--workspace オプションを付けて再実行すること。"
  exit 1
fi

log "対象リポジトリ: $TARGET_REPO_ROOT"
log ""

CREATED=()
SKIPPED=()
# 書き換えはしなかったが人間に読んでほしい事項。該当が無ければサマリーに節自体を出さない。
WARNED=()

# ---- 3. backlog init ----
BACKLOG_CONFIG_YML="$TARGET_REPO_ROOT/.backlog/config.yml"
if [ -f "$BACKLOG_CONFIG_YML" ]; then
  log "[skip] .backlog/config.yml は既に存在する。backlog init を実行しない。"
  SKIPPED+=("backlog init (.backlog/config.yml が既に存在)")
else
  # projectName は明示的に渡す。--defaults でも名前だけは省略すると非対話環境で
  # 入力待ちのまま失敗する。対象ディレクトリ名を既定値として渡す。
  project_name="$(basename "$TARGET_REPO_ROOT")"
  log "[run]  backlog init \"$project_name\" --defaults --backlog-dir .backlog --agent-instructions none"
  (cd "$TARGET_REPO_ROOT" && backlog init "$project_name" --defaults --backlog-dir .backlog --agent-instructions none < /dev/null)
  CREATED+=(".backlog/ (backlog init)")
fi

# backlog init の既定 statuses には Proposed / In Review / Approved が無い。
# 新規作成・既存スキップのどちらの場合も、欠けていれば補う。
ensure_backlog_statuses "$BACKLOG_CONFIG_YML"

# ---- 3b. 旧ステータス名 "Reviewed" が残る既存タスク・statuses の移行 ----
# タスクの移行を、config.yml の statuses から "Reviewed" を外すより先に行うこと
# （順序の理由は migrate_reviewed_status_in_config のコメント）。
migrate_reviewed_tasks "$TARGET_REPO_ROOT"
migrate_reviewed_status_in_config "$BACKLOG_CONFIG_YML"

# ---- 3c. remoteOperations / defaultAssignee の既定値収束 ----
ensure_remote_operations_disabled "$TARGET_REPO_ROOT"
ensure_default_assignee "$TARGET_REPO_ROOT" "$BACKLOG_CONFIG_YML"

# ---- 4. スキルのシンボリックリンク配置 ----
TARGET_SKILLS_DIR="$TARGET_REPO_ROOT/.claude/skills"
place_skill_symlinks "$SOURCE_SKILLS_DIR" "$TARGET_SKILLS_DIR" "${SKILL_NAMES[@]}"

# ---- 5. config.my.yml の配置 ----
TARGET_CONFIG_FILE="$TARGET_REPO_ROOT/.backlog/config.my.yml"
mkdir -p "$TARGET_REPO_ROOT/.backlog"
if [ -f "$TARGET_CONFIG_FILE" ]; then
  log "[skip] .backlog/config.my.yml は既に存在する。既存のキーは上書きしない（ユーザー所有ファイル）。"
  ensure_config_my_yml_keys "$TARGET_CONFIG_FILE" "$SOURCE_CONFIG_FILE"
  # 新規配置（下の else）はテンプレートの丸ごとコピーなので定義上ズレず、呼ばない。
  warn_config_my_yml_comment_drift "$TARGET_CONFIG_FILE" "$SOURCE_CONFIG_FILE"
else
  cp "$SOURCE_CONFIG_FILE" "$TARGET_CONFIG_FILE"
  log "[new]  .backlog/config.my.yml を配置した。"
  CREATED+=(".backlog/config.my.yml")
fi

# ---- 6. .git/info/exclude への追記 ----
EXCLUDE_LINES=(".backlog")
for name in "${SKILL_NAMES[@]}"; do
  EXCLUDE_LINES+=(".claude/skills/$name")
done
append_git_exclude_lines "$TARGET_REPO_ROOT" "${EXCLUDE_LINES[@]}"

# ---- 7. サマリー ----
log ""
log "=== サマリー ==="
log "作成/実行した項目 (${#CREATED[@]} 件):"
if [ "${#CREATED[@]}" -eq 0 ]; then
  log "  (なし)"
else
  for item in "${CREATED[@]}"; do
    log "  - $item"
  done
fi
log "スキップした項目 (${#SKIPPED[@]} 件):"
if [ "${#SKIPPED[@]}" -eq 0 ]; then
  log "  (なし)"
else
  for item in "${SKIPPED[@]}"; do
    log "  - $item"
  done
fi
# 該当が無ければ節ごと出さない。
if [ "${#WARNED[@]}" -gt 0 ]; then
  log "人手での確認が要る項目 (${#WARNED[@]} 件):"
  for item in "${WARNED[@]}"; do
    log "  - $item"
  done
fi
log ""
log "次にすること:"
log "  1. cd \"$TARGET_REPO_ROOT\" && backlog task list --plain  # backlog が使えることを確認する"
log "  2. improvement-scout スキルを使って改善タスクを起票する（Proposed で積む）"
log "  3. 起票された Proposed の中から着手させたいものを 'backlog task edit TASK-<n> -s \"To Do\"' で承認する"
